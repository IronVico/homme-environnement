---
/**
 * Lab : vitrine interne du design system tel qu'il est codé (tokens et composants réels).
 * Page en français seulement, sans version anglaise, noindex (donc hors sitemap, voir
 * astro.config.mjs), sans image de partage propre (absente de src/lib/og.ts) et sans lien
 * depuis le reste du site. Textes de la vitrine en dur : la page n'est pas traduite.
 * Données d'exemple : collections (src/content), données (src/data) et i18n, jamais inventées.
 * Les tokens sont lus dans src/styles/tokens.css au build (src/lib/lab-tokens.ts).
 */
import Calendar from '@lucide/astro/icons/calendar';
import Info from '@lucide/astro/icons/info';
import MapIcon from '@lucide/astro/icons/map';
import { getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import ContourPattern from '../components/ContourPattern.astro';
import CountryCard from '../components/CountryCard.astro';
import CountryFlag from '../components/CountryFlag.astro';
import EngageCard from '../components/EngageCard.astro';
import Faq from '../components/Faq.astro';
import FooterStamp from '../components/FooterStamp.astro';
import InfoNote from '../components/InfoNote.astro';
import Logo from '../components/Logo.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PartnerCard from '../components/PartnerCard.astro';
import PhotoBanner from '../components/PhotoBanner.astro';
import PillarCard from '../components/PillarCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectPhotoCard from '../components/ProjectPhotoCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ShareButtons from '../components/ShareButtons.astro';
import SitesExplorer from '../components/SitesExplorer.astro';
import SpeciesCard from '../components/SpeciesCard.astro';
import StatCard from '../components/StatCard.astro';
import StatsBand from '../components/StatsBand.astro';
import StepsBlock from '../components/StepsBlock.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import TodoPill from '../components/TodoPill.astro';
import { MADAGASCAR, SITE_FIGURES } from '../data/chiffres';
import { donatePath, fieldPath, pagePath, projectPath, STAGES_EMAIL } from '../data/navigation';
import { getPartner } from '../data/partenaires';
import { PROGRAMME } from '../data/projets-soutenus';
import { FEATURED_REPORT_ID, REPORTS } from '../data/rapports';
import { localeUrl, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExplorerSites } from '../lib/explorer-sites';
import { byPrefix, inGroup, isColor, TOKENS, type Token } from '../lib/lab-tokens';

import engagerDonner from '../assets/photos/engager-donner.jpg';
import engagerTerrain from '../assets/photos/engager-terrain.jpg';
import paysBurkina from '../assets/photos/pays-burkina-elephants.jpg';
import paysMadagascar from '../assets/photos/pays-madagascar.jpg';
import pilierBiodiversite from '../assets/photos/pilier-biodiversite-souimanga.jpg';
import pilierEconomie from '../assets/photos/pilier-economie-fete-ambohidravy.jpg';
import pilierResponsabilisation from '../assets/photos/pilier-responsabilisation-classe.jpg';

const lang = 'fr';
const dict = t(lang);
const { home, ui } = dict;

// --- Tokens ---------------------------------------------------------------------------------------

const charte = inGroup('Couleurs');
// Tokens de rôle et leurs dérivés : couleurs d'un côté, opacités des illustrations de l'autre.
// Les ombres du tampon (--ombre-papier*) sont avec les ombres.
const derived = TOKENS.filter((token) => /^(Tokens de rôle|Dérivés)/.test(token.group) && !token.name.startsWith('--ombre-papier'));
const roleColors = derived.filter(isColor);
const opacities = derived.filter((token) => !isColor(token));
const voiles = byPrefix('--voile');
// Aperçu des voiles sur une vraie photo du site.
const voilePhoto = await getImage({ src: paysMadagascar, width: 160, format: 'webp' });

const fontSizes = byPrefix('--fs-');
const lineHeights = new Map(byPrefix('--lh-').map((token) => [token.name.slice(5), token]));
const letterSpacings = new Map(byPrefix('--ls-').map((token) => [token.name.slice(5), token]));
/** Interlignage et interlettrage d'une taille : même suffixe (display, h2…), sinon ceux du corps. */
const typeScale = fontSizes.map((size) => {
  const key = size.name.slice(5);
  return {
    size,
    lh: lineHeights.get(key) ?? (key.startsWith('body') ? lineHeights.get('body') : undefined),
    ls: letterSpacings.get(key),
  };
});
const fontFamily = byPrefix('--font-');

const spaces = byPrefix('--space-', '--gutter', '--content-max');
const radii = byPrefix('--radius-');
const shadows = byPrefix('--shadow-', '--ombre-papier');
const motion = byPrefix('--transition-', '--lift-', '--nudge-');

/** Valeur affichée : brute, puis résolue si elle passe par d'autres tokens. */
const shown = (value: string, resolved?: string) => (resolved ? `${value} → ${resolved}` : value);
const hasDark = (token: Token) => token.dark !== undefined;

// --- Données d'exemple (réelles) ------------------------------------------------------------------

const madagascarSites = await getExplorerSites(lang, [], 'madagascar');
const burkinaSites = await getExplorerSites(lang, [], 'burkina-faso');

const allSites = await getCollection('sites');
const siteNames = new Map(allSites.map((site) => [site.id, site.data.name]));
const projets = (await getCollection('projets')).sort((a, b) => a.data.order - b.data.order);
const siteList = (data: (typeof projets)[number]['data']) => [
  ...data.sites.map((ref) => siteNames.get(ref.id) ?? ref.id),
  ...data.otherSites,
];
const [firstProject, secondProject] = projets;

const pillarImages = [pilierBiodiversite, pilierEconomie, pilierResponsabilisation];
const pillars = home.approach.pillars.map((pillar, i) => ({ ...pillar, image: pillarImages[i]! }));
const [donCard, terrainCard] = home.engage.cards;

const homeStats = (
  [
    { value: 30, illustration: 'ring' },
    { value: 400000, illustration: 'bars' },
    { value: 5000, illustration: 'dots' },
  ] as const
).map((stat, i) => {
  const text = home.stats[i]!;
  return { ...stat, unit: text.unit, text: text.text, illustrationLabel: text.illustrationLabel };
});

const mgStats = dict.madagascar.stats;
const autres = dict.autresProjets.stats;
const otherStats = [
  { value: MADAGASCAR.hectares, prefix: '≈', illustration: 'sites', unit: mgStats[0]!.unit, text: mgStats[0]!.text, illustrationLabel: mgStats[0]!.illustrationLabel },
  {
    value: MADAGASCAR.beneficiaries,
    prefix: '≈',
    illustration: 'share',
    ratio: MADAGASCAR.beneficiaries / MADAGASCAR.inhabitants,
    unit: mgStats[1]!.unit,
    text: mgStats[1]!.text,
    illustrationLabel: mgStats[1]!.illustrationLabel,
  },
  { value: MADAGASCAR.threatenedSpecies, illustration: 'families', unit: mgStats[2]!.unit, text: mgStats[2]!.text, illustrationLabel: mgStats[2]!.illustrationLabel },
  { value: dict.site.missing, illustration: 'water', text: dict.burkina.stats[1]!.text, illustrationLabel: dict.burkina.stats[1]!.illustrationLabel },
  { value: `${PROGRAMME.from}–${PROGRAMME.to}`, illustration: 'ticks', count: 10, text: autres.yearsText, illustrationLabel: autres.yearsLabel },
  { value: PROGRAMME.projects, illustration: 'grid', count: PROGRAMME.projects, text: autres.projectsText, illustrationLabel: autres.projectsLabel },
  { value: PROGRAMME.countries, illustration: 'segments', count: PROGRAMME.countries, text: autres.countriesText, illustrationLabel: autres.countriesLabel },
] as const;

// Variante icône : chiffres de la fiche Vohimana.
const vohimana = await getEntry('sites', 'vohimana');
const vohimanaFigures = SITE_FIGURES.vohimana ?? {};
const figureText = (key: string) => vohimana?.data.figures?.find((figure) => figure.key === key)?.text ?? '';
const iconStats = [
  { value: vohimanaFigures.hectares ?? dict.site.missing, unit: dict.site.units.hectares, text: figureText('hectares'), Icon: MapIcon },
  { value: vohimanaFigures.years ?? dict.site.missing, unit: dict.site.units.years, text: figureText('years'), Icon: Calendar },
];

const species = vohimana?.data.species.slice(0, 2) ?? [];
const speciesStatus = (status: (typeof species)[number]['status']) =>
  status && { label: dict.site.species.status[status], threatened: ['CR', 'EN', 'VU'].includes(status) };

const partner = getPartner('rainforest-trust');
const featuredReport = REPORTS.find((report) => report.id === FEATURED_REPORT_ID);
const stages = dict.stages;
const faqItems = dict.don.faq.items.slice(0, 3).map(({ question, answer }) => ({ question, answer: [answer] }));
const breadcrumb = [
  { label: ui.breadcrumbHome, href: localeUrl(lang) },
  { label: dict.nav.main[1]!, href: '#' },
];

const SECTIONS = [
  { id: 'couleurs', label: 'Couleurs' },
  { id: 'typographie', label: 'Typographie' },
  { id: 'espacements', label: 'Espacements' },
  { id: 'rayons', label: 'Rayons' },
  { id: 'ombres', label: 'Ombres' },
  { id: 'mouvement', label: 'Mouvement' },
  { id: 'button', label: 'Button' },
  { id: 'section-heading', label: 'SectionHeading' },
  { id: 'chip', label: 'Chip' },
  { id: 'cartes', label: 'Cartes' },
  { id: 'stat-card', label: 'StatCard' },
  { id: 'photo-banner', label: 'PhotoBanner' },
  { id: 'cartes-pays', label: 'Cartes pays' },
  { id: 'navigation', label: 'Navigation' },
  { id: 'infobulles', label: 'Infobulles et états' },
  { id: 'motifs', label: 'Motifs' },
  { id: 'contenus', label: 'Contenus' },
  { id: 'absents', label: 'Non montrés' },
];
---

<BaseLayout title="Lab du design system" description="Vitrine interne des tokens et composants du site, tels qu'ils sont codés." noindex>
  <header class="lab-bar">
    <div class="lab-bar__inner container">
      <Logo class="lab-bar__logo" lang={lang} alt={ui.logoAlt} />
      <span class="lab-bar__name">Lab</span>
      <ThemeToggle variant="button" class="lab-bar__theme" />
    </div>
  </header>

  <main id="contenu" class="lab">
    <div class="lab-intro container">
      <h1 class="lab-intro__title"><span class="lab-intro__strong">Lab</span> <span class="lab-intro__light">du design system</span></h1>
      <p class="lab-intro__lead">
        Le design system tel qu'il est codé : tokens lus dans <code>src/styles/tokens.css</code> au build, composants
        réels de <code>src/components/</code> avec les données du site. La bascule en haut à droite passe la page en
        clair ou en sombre (même réglage que le header du site).
      </p>
      <nav class="lab-toc" aria-label="Sommaire du lab">
        <ul role="list">
          {SECTIONS.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </div>

    {/* ---------------------------------------------------------------- Tokens */}

    <section id="couleurs" class="lab-section container" aria-labelledby="couleurs-titre">
      <h2 id="couleurs-titre" class="lab-title">Couleurs</h2>
      <p class="lab-text">
        Tokens de rôle : pastille rendue avec <code>var(--…)</code>, elle suit le mode affiché. Valeur claire, puis
        sombre quand elle change.
      </p>
      <ul class="swatches" role="list">
        {
          roleColors.map((token) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background: var(${token.name})`} />
              <span class="swatch__body">
                <code class="swatch__name">{token.name}</code>
                <span class="swatch__value">{shown(token.value, token.resolved)}</span>
                {hasDark(token) && <span class="swatch__value">Sombre : {shown(token.dark!, token.darkResolved)}</span>}
                {token.note && <span class="swatch__note">{token.note}</span>}
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="lab-subtitle">Voiles sur photo</h3>
      <ul class="swatches" role="list">
        {
          voiles.map((token) => (
            <li class="swatch">
              <span class="swatch__chip swatch__chip--photo" style={`background-image: url(${voilePhoto.src})`}>
                <span style={`background: var(${token.name})`} />
              </span>
              <span class="swatch__body">
                <code class="swatch__name">{token.name}</code>
                <span class="swatch__value">{token.value}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="lab-subtitle">Couleurs de la charte</h3>
      <p class="lab-text">À ne pas utiliser en direct dans un composant : elles passent par les tokens de rôle.</p>
      <ul class="swatches" role="list">
        {
          charte.map((token) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background: var(${token.name})`} />
              <span class="swatch__body">
                <code class="swatch__name">{token.name}</code>
                <span class="swatch__value">{token.value}</span>
                {token.note && <span class="swatch__note">{token.note}</span>}
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="lab-subtitle">Opacités des illustrations</h3>
      <dl class="token-table">
        {
          opacities.map((token) => (
            <div>
              <dt><code>{token.name}</code></dt>
              <dd>
                {token.value}
                {hasDark(token) && ` · sombre : ${token.dark}`}
                {token.note && <span class="token-table__note">{token.note}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="typographie" class="lab-section container" aria-labelledby="typographie-titre">
      <h2 id="typographie-titre" class="lab-title">Typographie</h2>
      <dl class="token-table">
        {
          fontFamily.map((token) => (
            <div>
              <dt><code>{token.name}</code></dt>
              <dd>{token.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="type-scale" role="list">
        {
          typeScale.map(({ size, lh, ls }) => (
            <li class="type-scale__row">
              <p
                class="type-scale__sample"
                style={[
                  `font-size: var(${size.name})`,
                  lh && `line-height: var(${lh.name})`,
                  ls && `letter-spacing: var(${ls.name})`,
                ]
                  .filter(Boolean)
                  .join('; ')}
                aria-hidden="true"
              >
                L'Homme & l'Environnement
              </p>
              <p class="type-scale__meta">
                <code>{size.name}</code> {size.value} · <span data-computed={size.name}>calculé : —</span>
                {lh && (
                  <>
                    <br />
                    <code>{lh.name}</code> {lh.value}
                  </>
                )}
                {ls && (
                  <>
                    <br />
                    <code>{ls.name}</code> {ls.value}
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="lab-text">
        Les tailles sans <code>--lh-*</code> ni <code>--ls-*</code> propre prennent l'interlignage fixé par le
        composant. Classe utilitaire <code>.eyebrow</code> :
      </p>
      <p class="eyebrow">{home.engage.eyebrow}</p>
    </section>

    <section id="espacements" class="lab-section container" aria-labelledby="espacements-titre">
      <h2 id="espacements-titre" class="lab-title">Espacements</h2>
      <ul class="spaces" role="list">
        {
          spaces.map((token) => (
            <li class="spaces__row">
              <code class="spaces__name">{token.name}</code>
              <span class="spaces__bar" style={`width: var(${token.name})`} />
              <span class="spaces__value">
                {token.value}
                {!/^\d+px$/.test(token.value) && (
                  <>
                    {' · calculé : '}
                    <span data-computed-width={token.name}>—</span>
                  </>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="rayons" class="lab-section container" aria-labelledby="rayons-titre">
      <h2 id="rayons-titre" class="lab-title">Rayons</h2>
      <ul class="tiles" role="list">
        {
          radii.map((token) => (
            <li class="tile">
              <span class="tile__radius" style={`border-radius: var(${token.name})`} />
              <code>{token.name}</code>
              <span class="tile__value">{token.value}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="ombres" class="lab-section container" aria-labelledby="ombres-titre">
      <h2 id="ombres-titre" class="lab-title">Ombres</h2>
      <ul class="tiles tiles--wide" role="list">
        {
          shadows.map((token) => (
            <li class="tile">
              <span
                class="tile__shadow"
                style={token.name.startsWith('--ombre') ? `box-shadow: 4px 6px 0 var(${token.name})` : `box-shadow: var(${token.name})`}
              />
              <code>{token.name}</code>
              <span class="tile__value">{token.value}</span>
              {hasDark(token) && <span class="tile__value">Sombre : {token.dark}</span>}
              {token.note && <span class="tile__value">{token.note}</span>}
            </li>
          ))
        }
      </ul>
      <p class="lab-text">
        <code>--ombre-papier*</code> : ombre nette décalée du tampon (aperçu avec un décalage de 4 × 6px).
      </p>
    </section>

    <section id="mouvement" class="lab-section container" aria-labelledby="mouvement-titre">
      <h2 id="mouvement-titre" class="lab-title">Transitions et élévations</h2>
      <dl class="token-table">
        {
          motion.map((token) => (
            <div>
              <dt><code>{token.name}</code></dt>
              <dd>
                {token.value}
                {token.note && <span class="token-table__note">{token.note}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="lab-text">
        Survol réservé à ce qui est interactif : pour les voir, survolez les boutons (<code>--lift-button-hover</code>)
        et les cartes-liens <code>a.card-lift</code> (<code>--lift-card-hover</code>, <code>--nudge-arrow-hover</code>)
        plus bas. Tout est coupé avec <code>prefers-reduced-motion</code>.
      </p>
    </section>

    {/* ---------------------------------------------------------------- Composants */}

    <section id="button" class="lab-section container" aria-labelledby="button-titre">
      <h2 id="button-titre" class="lab-title"><code>Button</code></h2>
      <div class="demo">
        <p class="demo__label"><code>variant="don"</code> · <code>"primary"</code> · <code>"secondary"</code> · <code>arrow="down"</code></p>
        <div class="demo__row">
          <Button href={donatePath(lang)} variant="don">{ui.donate}</Button>
          <Button href={pagePath(lang, 'contact')} variant="primary">{dict.partenaires.hero.become}</Button>
          <Button href={pagePath(lang, 'projets')} variant="secondary">{home.hero.secondaryCta}</Button>
          <Button href="#cartes-pays" variant="secondary" arrow="down">{dict.madagascar.hero.cta.replace('{count}', String(madagascarSites.length))}</Button>
        </div>
      </div>
      <div class="demo">
        <p class="demo__label"><code>icon="mail"</code> · <code>"book"</code> · <code>"download"</code> · <code>size="sm"</code> · sans <code>href</code> : <code>&lt;button&gt;</code> (« Lire en ligne », comme sur Rapports)</p>
        <div class="demo__row">
          <Button href={`mailto:${STAGES_EMAIL}`} variant="primary" icon="mail">{stages.apply.button}</Button>
          <Button variant="primary" icon="book">{dict.rapports.featured.read}</Button>
          {featuredReport?.file && <Button href={featuredReport.file} variant="secondary" icon="download" download>{dict.rapports.featured.download}</Button>}
          <Button href={donatePath(lang)} variant="don" size="sm">{ui.donate}</Button>
        </div>
      </div>
      <div class="demo">
        <p class="demo__label"><code>current</code> (<code>aria-current="page"</code>) · focus figé avec le contour de <code>:focus-visible</code></p>
        <div class="demo__row">
          <Button href={pagePath(lang, 'projets')} variant="secondary" current>{dict.nav.main[2]}</Button>
          <Button href={pagePath(lang, 'projets')} variant="secondary" class="lab-focus">{home.hero.secondaryCta}</Button>
        </div>
      </div>
      <div class="demo demo--dark">
        <p class="demo__label demo__label--on-dark"><code>variant="on-dark-primary"</code> · <code>"on-dark"</code> · sur la carte basalte (fond fixe)</p>
        <div class="demo__row">
          <Button href={localeUrl(lang)} variant="on-dark-primary">{dict.notFound.home}</Button>
          <Button href={fieldPath(lang)} variant="on-dark">{dict.projets.cta.field}</Button>
        </div>
      </div>
    </section>

    <section id="section-heading" class="lab-section container" aria-labelledby="section-heading-titre">
      <h2 id="section-heading-titre" class="lab-title"><code>SectionHeading</code></h2>
      <p class="lab-text">Ses titres sont des <code>h2</code> : exemples tirés de l'accueil et de la page Madagascar.</p>
      <div class="demo demo--stack">
        <p class="demo__label"><code>strong</code> + <code>link</code></p>
        <SectionHeading id="lab-sh-1" strong={home.actions.title} link={{ label: home.actions.link, href: pagePath(lang, 'madagascar') }} />
      </div>
      <div class="demo demo--stack">
        <p class="demo__label"><code>eyebrow</code> + <code>strong</code> + <code>light</code></p>
        <SectionHeading id="lab-sh-2" eyebrow={home.engage.eyebrow} strong={home.engage.titleStrong} light={home.engage.titleLight} />
      </div>
      <div class="demo demo--stack">
        <p class="demo__label"><code>strong</code> + <code>light</code> + <code>lead</code></p>
        <SectionHeading
          id="lab-sh-3"
          strong={dict.madagascar.projects.titleStrong}
          light={dict.madagascar.projects.titleLight}
          lead={dict.madagascar.projects.lead}
        />
      </div>
    </section>

    <section id="chip" class="lab-section container" aria-labelledby="chip-titre">
      <h2 id="chip-titre" class="lab-title"><code>Chip</code> · <code>TodoPill</code> · <code>CountryFlag</code></h2>
      <div class="demo__row">
        {madagascarSites.slice(0, 4).map((site) => <Chip label={site.name} />)}
      </div>
      <div class="demo__row">
        <TodoPill>{dict.site.missing}</TodoPill>
        <span class="flag-label"><CountryFlag country="madagascar" /> {dict.projets.countries.madagascar}</span>
        <span class="flag-label"><CountryFlag country="burkina-faso" size={22} /> {dict.projets.countries['burkina-faso']}</span>
      </div>
    </section>

    <section id="cartes" class="lab-section container" aria-labelledby="cartes-titre">
      <h2 id="cartes-titre" class="lab-title">Cartes</h2>

      <p class="demo__label"><code>EngageCard</code> · <code>variant="engage"</code> (accueil, « S'engager »)</p>
      <div class="grid-3">
        <EngageCard {...donCard!} href={donatePath(lang)} image={engagerDonner} imagePosition="40% 60%" />
        <EngageCard {...terrainCard!} href={pagePath(lang, 'stages')} image={engagerTerrain} imagePosition="50% 30%" />
      </div>

      <p class="demo__label"><code>EngageCard</code> · <code>variant="country"</code> · <code>CountryCard</code> avec ses <code>Chip</code></p>
      <div class="grid-2">
        <CountryCard
          name={home.actions.madagascar.name}
          description={home.actions.madagascar.description.replace('{count}', String(madagascarSites.length))}
