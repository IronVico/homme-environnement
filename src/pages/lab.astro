<script>
  import { initStats } from '../scripts/stats';
  initStats();

  // Valeurs calculées des tailles et espacements en clamp(), à la largeur de la fenêtre.
  const px = (value: string) => `${Math.round(parseFloat(value) * 10) / 10}px`;
  const update = () => {
    document.querySelectorAll<HTMLElement>('[data-computed]').forEach((el) => {
      const sample = el.closest('li')?.querySelector<HTMLElement>('.type-scale__sample');
      if (sample) el.textContent = `calculé : ${px(getComputedStyle(sample).fontSize)}`;
    });
    document.querySelectorAll<HTMLElement>('[data-computed-width]').forEach((el) => {
      const bar = el.closest('li')?.querySelector<HTMLElement>('.spaces__bar');
      if (bar) el.textContent = px(getComputedStyle(bar).width);
    });
  };
  update();
  window.addEventListener('resize', update);
</script>

