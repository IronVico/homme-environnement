---
/**
 * Sélecteur de langue du header : pilule segmentée FR / EN (maquette V1).
 * Chaque segment mène à la même page dans l'autre langue.
 */
import { getLang, languages, localeUrl, pathWithoutLocale, t, type Lang } from '../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const lang = getLang(Astro.currentLocale);
const path = pathWithoutLocale(Astro.url.pathname);
const codes = Object.keys(languages) as Lang[];
---

<div class:list={['lang-switcher', className]} role="group" aria-label={t(lang).ui.langSwitcher}>
  {
    codes.map((code) => (
      <a
        href={localeUrl(code, path)}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? 'true' : undefined}
        title={languages[code].name}
      >
        {languages[code].label}
      </a>
    ))
  }
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1.5px solid var(--bordure);
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }

  .lang-switcher a {
    padding: 6px 10px;
    border-radius: var(--radius-pill);
    color: var(--basalte);
    text-decoration: none;
    transition:
      background-color var(--transition-ui),
      color var(--transition-ui);
  }

  .lang-switcher a:hover {
    background: var(--vert-clair);
    color: var(--basalte);
  }

  .lang-switcher a[aria-current] {
    background: var(--basalte);
    color: var(--blanc);
  }
</style>
