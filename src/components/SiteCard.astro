---
/**
 * Carte compacte d'un site, dans la liste à côté de la carte du pays :
 * photo, numéro du repère, région, nom, texte (3 lignes), chiffres clés, lien vers la fiche.
 * `selected` : site mis en avant sur la carte (contour basalte).
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Calendar from '@lucide/astro/icons/calendar';
import MapIcon from '@lucide/astro/icons/map';
import Users from '@lucide/astro/icons/users';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  id: string;
  num: number;
  name: string;
  region: string;
  summary: string;
  image: ImageMetadata;
  imagePosition?: string;
  /** Chiffres déjà formatés (« 2 200 ha ») ; vide : on affiche figuresMissing. */
  figures: { kind: 'hectares' | 'years' | 'beneficiaries'; label: string }[];
  figuresMissing: string;
  href: string;
  linkLabel: string;
  selected?: boolean;
}

const {
  id,
  num,
  name,
  region,
  summary,
  image,
  imagePosition = '50% 40%',
  figures,
  figuresMissing,
  href,
  linkLabel,
  selected = false,
} = Astro.props;

const FigureIcon = { hectares: MapIcon, years: Calendar, beneficiaries: Users };
---

<li id={`site-${id}`} class="site-card" data-site={id} data-selected={selected ? '' : undefined} data-reveal>
  <Picture
    class="site-card__photo"
    src={image}
    alt=""
    style={`object-position: ${imagePosition}`}
    formats={['avif', 'webp']}
    widths={[320, 520, 760]}
    sizes="(max-width: 700px) 100vw, 300px"
  />
  <div class="site-card__body">
    <div class="site-card__meta">
      <span class="site-card__num" aria-hidden="true">{num}</span>
      <span class="site-card__region">{region}</span>
    </div>
    <h3 class="site-card__name">{name}</h3>
    <p class="site-card__summary">{summary}</p>

    <div class="site-card__figures">
      {
        figures.length > 0
          ? figures.map((figure) => {
              const Icon = FigureIcon[figure.kind];
              return (
                <span class="site-card__figure">
                  <Icon class="site-card__figure-icon" size={16} />
                  {figure.label}
                </span>
              );
            })
          : <span class="site-card__figure">{figuresMissing}</span>
      }
      <a class="site-card__link" href={href}>
        {linkLabel}<span class="visually-hidden"> : {name}</span>
        <ArrowRight class="site-card__arrow" size={18} />
      </a>
    </div>
  </div>
</li>

<style>
  .site-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--blanc);
    border-radius: var(--radius-card-lg);
    box-shadow: var(--shadow-card);
    /* Contour dessiné à l'intérieur : la carte sélectionnée ne change pas de taille. */
    outline: 1px solid var(--bordure-douce);
    outline-offset: -1px;
    transition: outline-color var(--transition-ui);
  }

  .site-card[data-selected] {
    outline: 2px solid var(--basalte);
    outline-offset: -2px;
  }

  .site-card :global(.site-card__photo) {
    width: 100%;
    height: 140px;
    object-fit: cover;
  }

  .site-card__body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 16px 18px 18px;
  }

  .site-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .site-card__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: var(--basalte);
    color: var(--blanc);
    font-size: 14px;
    font-weight: 700;
  }

  .site-card__region {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--vert-clair);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    line-height: 1.2;
  }

  .site-card__name {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: var(--ls-h2);
  }

  /* Texte limité à 3 lignes : le détail est sur la fiche du site. */
  .site-card__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.5;
  }

  /* Chiffres clés : séparés du texte par un filet, icônes en sauge, puis le lien. */
  .site-card__figures {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--bordure-douce);
    font-size: 13px;
    font-weight: 600;
  }

  .site-card__figure {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .site-card :global(.site-card__figure-icon) {
    flex-shrink: 0;
    color: var(--sauge);
  }

  .site-card__link {
    flex-basis: 100%;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .site-card__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* La flèche glisse vers la droite au survol du lien. */
  .site-card :global(.site-card__arrow) {
    transition: transform var(--transition-ui);
  }

  .site-card__link:hover :global(.site-card__arrow),
  .site-card__link:focus-visible :global(.site-card__arrow) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card {
      transition: none;
    }

    .site-card__link:hover :global(.site-card__arrow),
    .site-card__link:focus-visible :global(.site-card__arrow) {
      transform: none;
    }
  }
</style>
