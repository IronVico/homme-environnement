---
/**
 * Carte d'un site d'intervention, toute cliquable vers sa fiche.
 * featured : grande carte photo (texte blanc sur dégradé). Sinon : carte blanche.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Flag from '@lucide/astro/icons/flag';
import Handshake from '@lucide/astro/icons/handshake';
import Sprout from '@lucide/astro/icons/sprout';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  name: string;
  /** Statut du site (collection « sites ») : choisit l'icône de la pastille. */
  status: 'historique' | 'transmis' | 'en-cours';
  /** Libellé du statut, dans la langue de la page. */
  statusLabel: string;
  summary: string;
  image: ImageMetadata;
  imagePosition?: string;
  href: string;
  linkLabel: string;
  featured?: boolean;
  class?: string;
}

const { name, status, statusLabel, summary, image, imagePosition = '50% 50%', href, linkLabel, featured = false, class: className } = Astro.props;

// Historique : le site par lequel tout a commencé. Transmis : géré par les acteurs locaux. En cours : projet qui pousse.
const StatusIcon = { historique: Flag, transmis: Handshake, 'en-cours': Sprout }[status];
---

<a class:list={['site-card', 'card-lift', featured ? 'site-card--featured' : 'site-card--default', className]} href={href}>
  <Picture
    class="site-card__photo"
    src={image}
    alt=""
    style={`object-position: ${imagePosition}`}
    formats={['avif', 'webp']}
    widths={featured ? [640, 900, 1300, 1800] : [400, 640, 900]}
    sizes={featured ? '(max-width: 700px) 100vw, (max-width: 1440px) 66vw, 860px' : '(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 420px'}
  />
  <span class="site-card__body">
    <span class="site-card__status">
      <StatusIcon class="site-card__status-icon" size={14} />
      {statusLabel}
    </span>
    <span class="site-card__name">{name}</span>
    <span class="site-card__summary">{summary}</span>
    <span class="site-card__link">
      {linkLabel}
      <ArrowRight class="site-card__arrow" size={18} />
    </span>
  </span>
</a>

<style>
  .site-card {
    overflow: hidden;
    display: flex;
    border-radius: var(--radius-card-lg);
    text-decoration: none;
  }

  .site-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-card__status {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    line-height: 1.2;
  }

  .site-card__name {
    font-weight: 800;
    letter-spacing: var(--ls-h2);
    line-height: 1;
  }

  .site-card__summary {
    line-height: 1.5;
  }

  .site-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 16px;
    font-weight: 600;
  }

  /* La flèche glisse vers la droite quand la carte s'élève. */
  .site-card :global(.site-card__arrow) {
    transition: transform var(--transition-ui);
  }

  .site-card:hover :global(.site-card__arrow),
  .site-card:focus-visible :global(.site-card__arrow) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card:hover :global(.site-card__arrow),
    .site-card:focus-visible :global(.site-card__arrow) {
      transform: none;
    }
  }

  /* Carte blanche : photo en haut. */
  .site-card--default {
    flex-direction: column;
    background: var(--blanc);
    color: var(--basalte);
    border: 1px solid var(--bordure-douce);
    box-shadow: var(--shadow-card);
  }

  .site-card--default:hover {
    color: var(--basalte);
  }

  .site-card--default :global(.site-card__photo) {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .site-card--default .site-card__body {
    padding: 24px 28px 28px;
  }

  .site-card--default .site-card__status {
    background: var(--vert-clair);
    color: var(--basalte);
  }

  .site-card--default .site-card__name {
    font-size: 28px;
    line-height: 1.2;
  }

  .site-card--default .site-card__summary {
    font-size: 16px;
  }

  .site-card--default .site-card__link {
    margin-top: var(--space-2);
  }

  /* Grande carte photo : texte blanc sur dégradé vers le bas. */
  .site-card--featured {
    position: relative;
    align-items: flex-end;
    min-height: 440px;
    color: var(--blanc);
  }

  .site-card--featured:hover {
    color: var(--blanc);
  }

  .site-card--featured :global(.site-card__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-card--featured .site-card__body {
    position: relative;
    width: 100%;
    gap: var(--space-3);
    padding: 36px;
    background: var(--voile-degrade);
  }

  /* Maquette : pastille pêche pour le site historique (écart à la règle « pêche = Don », à valider). */
  .site-card--featured .site-card__status {
    background: var(--peche);
    color: var(--noir-95);
  }

  .site-card--featured .site-card__name {
    font-size: clamp(32px, 3.6vw, 48px);
  }

  .site-card--featured .site-card__summary {
    max-width: 560px;
    font-size: var(--fs-body);
  }
</style>
