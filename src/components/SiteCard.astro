---
/**
 * Carte compacte d'un site, dans la liste à côté de la carte du pays. Toute la carte
 * mène à la fiche du site : photo, numéro du repère et nom, accroche sur 2 lignes,
 * surface protégée. Le reste (région, années, bénéficiaires, espèces) est sur la fiche.
 * `selected` : site mis en avant sur la carte (contour basalte).
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MapIcon from '@lucide/astro/icons/map';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  id: string;
  num: number;
  name: string;
  summary: string;
  image: ImageMetadata;
  imagePosition?: string;
  /** Surface déjà formatée (« 2 200 ha ») ; absente : on affiche figureMissing. */
  figure?: string;
  figureMissing: string;
  href: string;
  /** Texte lu par les lecteurs d'écran à la place de la flèche (« Voir la fiche »). */
  linkLabel: string;
  selected?: boolean;
}

const { id, num, name, summary, image, imagePosition = '50% 40%', figure, figureMissing, href, linkLabel, selected = false } =
  Astro.props;
---

<li id={`site-${id}`} class="site-card" data-site={id} data-selected={selected ? '' : undefined} data-reveal>
  <a class="site-card__link" href={href}>
    <Picture
      class="site-card__photo"
      src={image}
      alt=""
      style={`object-position: ${imagePosition}`}
      formats={['avif', 'webp']}
      widths={[320, 520, 760]}
      sizes="(max-width: 700px) 100vw, 380px"
    />
    <span class="site-card__body">
      <span class="site-card__title">
        <span class="site-card__num" aria-hidden="true">{num}</span>
        <span class="site-card__name">{name}</span>
      </span>
      <span class="site-card__summary">{summary}</span>
      <span class="site-card__footer">
        <span class="site-card__figure">
          {figure && <MapIcon class="site-card__figure-icon" size={16} />}
          {figure ?? figureMissing}
        </span>
        <span class="site-card__more">
          <span class="visually-hidden">{linkLabel}</span>
          <ArrowRight class="site-card__arrow" size={18} />
        </span>
      </span>
    </span>
  </a>
</li>

<style>
  .site-card {
    overflow: hidden;
    border-radius: var(--radius-card-lg);
    background: var(--blanc);
    box-shadow: var(--shadow-card);
    /* Contour dessiné à l'intérieur : la carte sélectionnée ne change pas de taille. */
    outline: 1px solid var(--bordure-douce);
    outline-offset: -1px;
    transition: outline-color var(--transition-ui);
  }

  .site-card[data-selected] {
    outline: 2px solid var(--basalte);
    outline-offset: -2px;
  }

  /* Toute la carte est le lien vers la fiche. */
  .site-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--basalte);
    text-decoration: none;
  }

  .site-card__link:hover {
    color: var(--basalte);
  }

  .site-card__link:focus-visible {
    outline: 2px solid var(--basalte);
    outline-offset: -4px;
    border-radius: var(--radius-card-lg);
  }

  .site-card :global(.site-card__photo) {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .site-card__body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 16px 18px 18px;
  }

  .site-card__title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .site-card__num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: var(--basalte);
    color: var(--blanc);
    font-size: 14px;
    font-weight: 700;
  }

  .site-card__name {
    min-width: 0;
    font-size: 21px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: var(--ls-h2);
  }

  /* Accroche limitée à 2 lignes : le détail est sur la fiche du site. */
  .site-card__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.5;
  }

  /* Surface protégée à gauche, flèche vers la fiche à droite, sous un filet. */
  .site-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--bordure-douce);
    font-size: 13px;
    font-weight: 600;
  }

  .site-card__figure {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .site-card :global(.site-card__figure-icon) {
    flex-shrink: 0;
    color: var(--sauge);
  }

  .site-card__more {
    display: inline-flex;
  }

  /* La flèche glisse vers la droite au survol de la carte. */
  .site-card :global(.site-card__arrow) {
    transition: transform var(--transition-ui);
  }

  .site-card__link:hover :global(.site-card__arrow),
  .site-card__link:focus-visible :global(.site-card__arrow) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card {
      transition: none;
    }

    .site-card__link:hover :global(.site-card__arrow),
    .site-card__link:focus-visible :global(.site-card__arrow) {
      transform: none;
    }
  }
</style>
