---
/**
 * Carte blanche d'un site d'intervention, toute cliquable vers sa fiche :
 * photo, région, nom, texte, espèces emblématiques, chiffres clés.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Bird from '@lucide/astro/icons/bird';
import Calendar from '@lucide/astro/icons/calendar';
import Fish from '@lucide/astro/icons/fish';
import Leaf from '@lucide/astro/icons/leaf';
import MapIcon from '@lucide/astro/icons/map';
import PawPrint from '@lucide/astro/icons/paw-print';
import Users from '@lucide/astro/icons/users';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

type SpeciesType = 'animal' | 'oiseau' | 'poisson' | 'plante';

interface Props {
  name: string;
  region: string;
  summary: string;
  image: ImageMetadata;
  imagePosition?: string;
  species: { name: string; type: SpeciesType }[];
  speciesTitle: string;
  /** Chiffres déjà formatés (« 2 200 ha ») ; vide : on affiche figuresMissing. */
  figures: { kind: 'hectares' | 'years' | 'beneficiaries'; label: string }[];
  figuresMissing: string;
  href: string;
  linkLabel: string;
}

const {
  name,
  region,
  summary,
  image,
  imagePosition = '50% 40%',
  species,
  speciesTitle,
  figures,
  figuresMissing,
  href,
  linkLabel,
} = Astro.props;

const SpeciesIcon = { animal: PawPrint, oiseau: Bird, poisson: Fish, plante: Leaf };
const FigureIcon = { hectares: MapIcon, years: Calendar, beneficiaries: Users };
---

<a class="site-card card-lift" href={href} data-reveal>
  <Picture
    class="site-card__photo"
    src={image}
    alt=""
    style={`object-position: ${imagePosition}`}
    formats={['avif', 'webp']}
    widths={[400, 640, 900]}
    sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 420px"
  />
  <span class="site-card__body">
    <span class="site-card__region">{region}</span>
    <span class="site-card__name">{name}</span>
    <span class="site-card__summary">{summary}</span>

    {
      species.length > 0 && (
        <span class="site-card__species">
          <span class="site-card__eyebrow">{speciesTitle}</span>
          <span class="site-card__tags">
            {species.map((item) => {
              const Icon = SpeciesIcon[item.type];
              return (
                <span class="site-card__tag">
                  <Icon size={16} />
                  {item.name}
                </span>
              );
            })}
          </span>
        </span>
      )
    }

    <span class="site-card__figures">
      {
        figures.length > 0
          ? figures.map((figure) => {
              const Icon = FigureIcon[figure.kind];
              return (
                <span class="site-card__figure">
                  <Icon class="site-card__figure-icon" size={16} />
                  {figure.label}
                </span>
              );
            })
          : <span class="site-card__figure">{figuresMissing}</span>
      }
    </span>

    <span class="site-card__link">
      {linkLabel}
      <ArrowRight class="site-card__arrow" size={18} />
    </span>
  </span>
</a>

<style>
  .site-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--blanc);
    color: var(--basalte);
    border: 1px solid var(--bordure-douce);
    border-radius: var(--radius-card-lg);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .site-card:hover {
    color: var(--basalte);
  }

  .site-card :global(.site-card__photo) {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  /* Le texte occupe toute la hauteur restante : les liens s'alignent en bas des cartes d'une même rangée. */
  .site-card__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 28px 28px;
  }

  .site-card__region {
    align-self: flex-start;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--vert-clair);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    line-height: 1.2;
  }

  .site-card__name {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: var(--ls-h2);
  }

  .site-card__summary {
    font-size: 16px;
    line-height: 1.5;
  }

  /* Espèces emblématiques : sur-titre puis pastilles menthe, noms en italique. */
  .site-card__species {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-card__eyebrow {
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ardoise);
  }

  .site-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .site-card__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px 5px 10px;
    border: 1px solid var(--vert-clair);
    border-radius: var(--radius-pill);
    background: var(--menthe);
    font-size: var(--fs-eyebrow);
    font-style: italic;
    line-height: 1.3;
  }

  .site-card__tag :global(svg) {
    flex-shrink: 0;
  }

  /* Chiffres clés : séparés du texte par un filet, icônes en sauge. */
  .site-card__figures {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding-top: var(--space-3);
    border-top: 1px solid var(--bordure-douce);
    font-size: 14px;
    font-weight: 600;
  }

  .site-card__figure {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .site-card :global(.site-card__figure-icon) {
    flex-shrink: 0;
    color: var(--sauge);
  }

  .site-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: 16px;
    font-weight: 600;
  }

  /* La flèche glisse vers la droite quand la carte s'élève. */
  .site-card :global(.site-card__arrow) {
    transition: transform var(--transition-ui);
  }

  .site-card:hover :global(.site-card__arrow),
  .site-card:focus-visible :global(.site-card__arrow) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .site-card:hover :global(.site-card__arrow),
    .site-card:focus-visible :global(.site-card__arrow) {
      transform: none;
    }
  }
</style>
