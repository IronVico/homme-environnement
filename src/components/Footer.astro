---
import { donatePath, getFooterNav, getLegalNav, SOCIAL_URLS } from '../data/navigation';
import { getLang, localeUrl, pathWithoutLocale, t } from '../i18n';
import Button from './Button.astro';
import Logo from './Logo.astro';
import ContourPattern from './ContourPattern.astro';
import FooterStamp from './FooterStamp.astro';

const lang = getLang(Astro.currentLocale);
const { ui } = t(lang);
const footerNav = getFooterNav(lang);
const legalNav = getLegalNav(lang);
// Lien vers la même page dans l'autre langue (« English version » / « Version française »).
const otherLang = lang === 'en' ? 'fr' : 'en';
const otherLangUrl = localeUrl(otherLang, pathWithoutLocale(Astro.url.pathname));
---

<footer class="footer">
  <ContourPattern variant="footer" />
  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo class="footer__logo" lang={lang} alt={ui.logoAlt} />
        <p class="footer__pitch">{ui.footerPitch}</p>
        <Button href={donatePath(lang)} variant="don" size="sm" class="footer__don">{ui.donate}</Button>
        <ul class="footer__social" aria-label={ui.social}>
          <li>
            <a class="btn-motion" href={SOCIAL_URLS.linkedin} aria-label={ui.socialLinkedin} data-tooltip={ui.socialLinkedin} data-tooltip-align="start" rel="noopener">
              <!-- Tracé de l'ancienne icône Lucide « linkedin » (ISC) : Lucide 1.x n'a plus d'icônes de marques. -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </li>
          <li>
            <a class="btn-motion" href={SOCIAL_URLS.facebook} aria-label={ui.socialFacebook} data-tooltip={ui.socialFacebook} data-tooltip-align="start" rel="noopener">
              <!-- Tracé de l'ancienne icône Lucide « facebook » (ISC). -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer__nav" aria-label={ui.sitemap}>
        {
          footerNav.map((column) => (
            <div class="footer__col">
              <h2 class="footer__col-title">{column.title}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer__bottom">
      <FooterStamp class="footer__stamp" />
      <p>{ui.copyright}</p>
      <ul class="footer__legal">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href={otherLangUrl} lang={otherLang} hreflang={otherLang}>{ui.otherLanguage}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Le motif et le tampon se posent dans le footer sans l'agrandir (maquette v119). */
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--footer);
    color: var(--texte);
  }

  /* Tampon en bas à droite, juste au-dessus de la barre du bas (maquette v119), dans
     l'espace libre sous la dernière colonne de liens. Repère : la barre du bas ; à 1440px,
     47px du bord droit comme dans la maquette. Vérifié sans recouvrement de 300 à 2560px. */
  .footer :global(.footer__stamp) {
    position: absolute;
    z-index: 2;
    right: calc(47px - var(--gutter));
    bottom: calc(100% + 12px);
  }

  /* Vers 970-990px, la colonne « Ressources » descend jusqu'à la barre du bas : tampon
     réduit et plus bas, pour rester dans l'espace libre. */
  @media (min-width: 960px) and (max-width: 999px) {
    .footer :global(.footer__stamp) {
      width: 104px;
      height: 104px;
      bottom: calc(100% + 4px);
    }
  }

  .footer__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: var(--space-7);
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .footer__brand {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  /* Le fichier du logo inclut sa zone de protection : marges négatives. */
  .footer :global(.footer__logo) {
    height: 96px;
    width: auto;
    max-width: none;
    margin: -18px 0 -18px -26px;
  }

  .footer__pitch {
    max-width: 320px;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
  }

  .footer__nav {
    flex: 2 1 560px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-8);
    font-size: var(--fs-body-sm);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col-title {
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col a {
    text-decoration: none;
  }

  .footer__col a:hover {
    text-decoration: underline;
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--trait);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }

  /* Survol : le disque se remplit en basalte et se soulève (classe btn-motion). */
  .footer__social a:hover,
  .footer__social a:focus-visible {
    border-color: var(--texte);
    background: var(--bouton-plein);
    color: var(--texte-sur-bouton);
  }

  .footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: var(--space-6);
    border-top: 1px solid var(--trait);
    font-size: 14px;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  /* Mobile (maquette v124) : le tampon passe dans le flux, tout en bas du footer, sous la
     barre du bas, aligné à droite (20px du bord), 112px. La barre est déjà sur deux lignes
     à cette largeur : en colonne, le rendu ne change pas. */
  @media (max-width: 700px) {
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer :global(.footer__stamp) {
      position: static;
      order: 2;
      align-self: flex-end;
      width: 112px;
      height: 112px;
      margin-right: calc(20px - var(--gutter));
    }
  }
</style>
