---
import logoEn from '../assets/logos/logo-couleur-en.svg';
import logoFr from '../assets/logos/logo-couleur.svg';
import { DON_URL, getFooterNav, getLegalNav, SOCIAL_URLS } from '../data/navigation';
import { getLang, localeUrl, pathWithoutLocale, t } from '../i18n';
import Button from './Button.astro';

const lang = getLang(Astro.currentLocale);
const { ui } = t(lang);
const logo = lang === 'en' ? logoEn : logoFr;
const footerNav = getFooterNav(lang);
const legalNav = getLegalNav(lang);
// Lien vers la même page dans l'autre langue (« English version » / « Version française »).
const otherLang = lang === 'en' ? 'fr' : 'en';
const otherLangUrl = localeUrl(otherLang, pathWithoutLocale(Astro.url.pathname));
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__brand">
        <img class="footer__logo" src={logo.src} width={logo.width} height={logo.height} alt={ui.logoAlt} loading="lazy" />
        <p class="footer__pitch">{ui.footerPitch}</p>
        <Button href={DON_URL} variant="don" size="sm" class="footer__don">{ui.donate}</Button>
        <ul class="footer__social" aria-label={ui.social}>
          <li>
            <a href={SOCIAL_URLS.linkedin} aria-label={ui.socialLinkedin} rel="noopener">
              <!-- Tracé de l'ancienne icône Lucide « linkedin » (ISC) : Lucide 1.x n'a plus d'icônes de marques. -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </li>
          <li>
            <a href={SOCIAL_URLS.facebook} aria-label={ui.socialFacebook} rel="noopener">
              <!-- Tracé de l'ancienne icône Lucide « facebook » (ISC). -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer__nav" aria-label={ui.sitemap}>
        {
          footerNav.map((column) => (
            <div class="footer__col">
              <h2 class="footer__col-title">{column.title}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer__bottom">
      <p>{ui.copyright}</p>
      <ul class="footer__legal">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href={otherLangUrl} lang={otherLang} hreflang={otherLang}>{ui.otherLanguage}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--menthe);
    color: var(--basalte);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-top: 72px;
    padding-bottom: var(--space-8);
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .footer__brand {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  /* Le fichier du logo inclut sa zone de protection : marges négatives. */
  .footer__logo {
    height: 96px;
    width: auto;
    max-width: none;
    margin: -18px 0 -18px -26px;
  }

  .footer__pitch {
    max-width: 320px;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
  }

  .footer__nav {
    flex: 2 1 560px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-8);
    font-size: var(--fs-body-sm);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col-title {
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col a {
    text-decoration: none;
  }

  .footer__col a:hover {
    text-decoration: underline;
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--bordure);
    border-radius: var(--radius-pill);
    background: var(--blanc);
  }

  .footer__social a:hover {
    border-color: var(--basalte);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: var(--space-6);
    border-top: 1px solid var(--bordure);
    font-size: 14px;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
</style>
