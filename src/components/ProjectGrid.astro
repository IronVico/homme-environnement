---
/** Grille des cartes projet compactes (ProjectCard) : 3 colonnes, 2 en tablette, 1 en mobile. */
---

<ul class="project-grid">
  <slot />
</ul>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1000px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
