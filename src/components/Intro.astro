---
/**
 * Écran d'ouverture, seulement quand la page a besoin de charger (src/scripts/intro.ts) :
 * l'isotype se dessine au trait et se remplit, le rideau attend la photo principale puis
 * se lève, suivi d'une bande sauge (.intro--lever). Si la photo est prête tout de suite,
 * le script retire l'écran avant que rien ne se dessine. Sans ce script, l'écran part de
 * lui-même (intro-secours). Il ne capte jamais les clics, et ne s'affiche ni sans JS, ni
 * avec prefers-reduced-motion, ni à l'impression, ni deux fois dans une session (.no-intro).
 */
---

<div class="intro" aria-hidden="true">
  <div class="intro__bande"></div>
  <div class="intro__rideau">
    <svg class="intro__isotype" viewBox="34 20 98 126">
      <path
        pathLength="1"
        d="M75.76,80.91c2.78,4.16-3.13,7.34-8.87,12.96-14.37,14.08-26.6,36.68-14.11,42.15,10.73,4.7,16.83-4.62,20.66-11.41,6.38-11.3,8.03-28.93,12.58-29.07,4.55-.14,4.61,14.81,10.29,26.42,4.63,9.46,12.05,16.15,19.14,10.71,7.09-5.45,5.89-13.11,2.22-20.09-6.15-11.68-23.04-20.87-22.78-30.37.27-9.5,18.17-12.88,24.05-18.05,5.88-5.17,5.99-9.53,4.39-12.88s-5.39-6.84-14.54-.78c-4.18,2.77-14,14.67-18.41,12.44-4.41-2.24.86-10.68-.21-18.22-1.07-7.54-6.69-9.5-10.83-8.52-4.15.98-10.03,5.31-7.62,12.15s8.43,13.63,5.22,16.62c-4.85,4.53-10.15-5.73-24.23-6.24-10.04-.36-14.61,14.58,3.24,18.68,13.59,3.12,17.31-.26,19.83,3.52Z"
      ></path>
    </svg>
  </div>
</div>

<style>
  .intro {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js:not(.no-intro)) .intro {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: block;
      overflow: hidden;
      pointer-events: none;
      animation: intro-secours 100ms linear 5000ms forwards;
    }

    :global(.js:not(.no-intro)) .intro.intro--lever {
      animation: none;
    }
  }

  @media print {
    :global(.js:not(.no-intro)) .intro {
      display: none;
    }
  }

  /* Plus hauts que l'écran : la courbe du bas reste hors champ tant que le rideau est baissé. */
  .intro__bande,
  .intro__rideau {
    position: absolute;
    inset: 0 0 auto;
    height: 125%;
    border-radius: 0 0 50% 50% / 0 0 14vh 14vh;
  }

  .intro--lever .intro__bande,
  .intro--lever .intro__rideau {
    animation: intro-lever 560ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  .intro__bande {
    background: var(--accent);
  }

  .intro--lever .intro__bande {
    animation-delay: 90ms;
  }

  .intro__rideau {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    background: var(--fond);
  }

  .intro__isotype {
    width: 88px;
    /* Centré sur l'écran : le rideau fait 125 % de sa hauteur. */
    margin-top: calc(50vh - 56px);
    overflow: visible;
    color: var(--accent);
  }

  .intro--lever .intro__isotype {
    animation: intro-sortie 320ms ease-in forwards;
  }

  .intro__isotype path {
    fill: currentColor;
    fill-opacity: 0;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      intro-trait 560ms ease-in-out 400ms forwards,
      intro-remplir 260ms ease-out 800ms forwards;
  }

  @keyframes intro-trait {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes intro-remplir {
    to {
      fill-opacity: 1;
    }
  }

  @keyframes intro-sortie {
    to {
      opacity: 0;
      translate: 0 -24px;
    }
  }

  @keyframes intro-lever {
    to {
      translate: 0 -100%;
    }
  }

  @keyframes intro-secours {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
