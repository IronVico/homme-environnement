---
import Send from '@lucide/astro/icons/send';
import { getLang, t } from '../i18n';

interface Props {
  id?: string;
}

const { id = 'newsletter' } = Astro.props;
const inputId = `${id}-email`;
const statusId = `${id}-status`;
const { ui } = t(getLang(Astro.currentLocale));
---

<!--
  Pas de back pour l'instant : l'outil d'emailing n'est pas encore choisi, l'envoi est bloqué côté client.
  TODO newsletter : une fois l'outil choisi, renseigner action (URL de son formulaire) et retirer le preventDefault.
  method="post" évite de mettre l'adresse dans l'URL si le JS ne charge pas.
-->
<div class="newsletter-form">
  <form class="newsletter-form__pill" method="post" data-newsletter data-pending={ui.newsletterPending} aria-describedby={statusId}>
    <label class="visually-hidden" for={inputId}>{ui.newsletterEmailLabel}</label>
    <input
      class="newsletter-form__input"
      id={inputId}
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      placeholder={ui.newsletterPlaceholder}
    />
    <button class="newsletter-form__btn" type="submit">
      {ui.newsletterSubmit}
      <Send size={18} />
    </button>
  </form>
  <p class="newsletter-form__status" id={statusId} role="status" aria-live="polite"></p>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.parentElement?.querySelector<HTMLElement>('[role="status"]');
      if (status && form.dataset.pending) {
        status.textContent = form.dataset.pending;
      }
    });
  });
</script>

<style>
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .newsletter-form__pill {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px;
    background: var(--blanc);
    border-radius: var(--radius-pill);
  }

  .newsletter-form__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 52px;
    padding: 0 0 0 20px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--noir-95);
    font-size: var(--fs-body);
  }

  .newsletter-form__input::placeholder {
    color: var(--ardoise);
    opacity: 1;
  }

  .newsletter-form__input:focus {
    outline: none;
  }

  /* Le champ n'a pas de bordure : le focus se voit sur la pilule. */
  .newsletter-form__pill:has(.newsletter-form__input:focus-visible) {
    outline: 2px solid var(--blanc);
    outline-offset: 2px;
  }

  .newsletter-form__btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 26px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--sauge);
    color: var(--noir-95);
    font-size: var(--fs-button);
    font-weight: 600;
    cursor: pointer;
  }

  .newsletter-form__btn:hover {
    background: color-mix(in srgb, var(--sauge) 88%, var(--noir-95));
  }

  .newsletter-form__btn:focus-visible {
    outline-color: var(--blanc);
  }

  .newsletter-form__status:empty {
    display: none;
  }

  .newsletter-form__status {
    font-size: var(--fs-body-sm);
  }

  @media (max-width: 600px) {
    .newsletter-form__pill {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      padding: 0;
      background: transparent;
    }

    .newsletter-form__input {
      padding: 0 20px;
      background: var(--blanc);
    }

    .newsletter-form__input:focus-visible {
      outline: 2px solid var(--blanc);
      outline-offset: 2px;
    }

    .newsletter-form__pill:has(.newsletter-form__input:focus-visible) {
      outline: none;
    }

    .newsletter-form__btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
