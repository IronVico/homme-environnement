---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Heart from '@lucide/astro/icons/heart';
import Mail from '@lucide/astro/icons/mail';

interface Props {
  href: string;
  /**
   * don : pêche, réservé à « Faire un don ». primary : fond basalte, action principale d'une page.
   * secondary : contour basalte. on-dark : contour blanc sur photo.
   * on-dark-primary : fond blanc sur photo, action principale d'une carte sur photo.
   */
  variant?: 'don' | 'primary' | 'secondary' | 'on-dark' | 'on-dark-primary';
  /** md : hero. sm : header et footer. */
  size?: 'md' | 'sm';
  /** Flèche des variantes secondaires : vers le bas pour une ancre dans la page. */
  arrow?: 'right' | 'down';
  /** mail : enveloppe avant le libellé, à la place de la flèche (lien mailto). */
  icon?: 'mail';
  /** Lien vers la page affichée (aria-current="page"). */
  current?: boolean;
  class?: string;
}

const { href, variant = 'secondary', size = 'md', arrow = 'right', icon, current, class: className } = Astro.props;
---

<a href={href} aria-current={current ? 'page' : undefined} class:list={['btn', 'btn-motion', `btn--${variant}`, `btn--${size}`, className]}>
  {variant === 'don' && <Heart size={18} />}
  {icon === 'mail' && <Mail size={20} />}
  <slot />
  {variant !== 'don' && !icon && (arrow === 'down' ? <ArrowDown size={20} /> : <ArrowRight size={20} />)}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-button);
    line-height: 1;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn svg {
    flex-shrink: 0;
  }

  .btn--don {
    background: var(--peche);
    color: var(--noir-95);
  }

  .btn--don:hover {
    color: var(--noir-95);
    background: color-mix(in srgb, var(--peche) 88%, var(--noir-95));
  }

  .btn--primary {
    background: var(--basalte);
    color: var(--blanc);
  }

  .btn--primary:hover {
    background: var(--noir-95);
    color: var(--blanc);
  }

  .btn--on-dark-primary {
    background: var(--blanc);
    color: var(--noir-95);
  }

  .btn--on-dark-primary:hover {
    background: var(--vert-clair);
    color: var(--noir-95);
  }

  .btn--secondary,
  .btn--on-dark {
    border: 2px solid currentColor;
    font-weight: 500;
  }

  .btn--secondary {
    color: var(--basalte);
  }

  .btn--secondary:hover {
    color: var(--noir-95);
    background: var(--vert-clair);
  }

  .btn--on-dark,
  .btn--on-dark:hover {
    color: var(--blanc);
  }

  .btn--md {
    padding: 16px 28px;
  }

  .btn--md.btn--secondary,
  .btn--md.btn--on-dark {
    padding: 14px 26px;
  }

  .btn--sm {
    padding: 12px 22px;
    font-size: 16px;
  }
</style>
