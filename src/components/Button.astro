---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import BookOpen from '@lucide/astro/icons/book-open';
import Download from '@lucide/astro/icons/download';
import Heart from '@lucide/astro/icons/heart';
import Mail from '@lucide/astro/icons/mail';

import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'href' | 'type'> {
  /** Lien ; sans href, le bouton est un <button type="button"> (action dans la page). */
  href?: string;
  /**
   * don : pêche, réservé à « Faire un don ». primary : fond basalte, action principale d'une page.
   * secondary : contour basalte. on-dark : contour blanc sur photo.
   * on-dark-primary : fond blanc sur photo, action principale d'une carte sur photo.
   */
  variant?: 'don' | 'primary' | 'secondary' | 'on-dark' | 'on-dark-primary';
  /** md : hero. sm : header et footer. */
  size?: 'md' | 'sm';
  /** Flèche des variantes secondaires : vers le bas pour une ancre dans la page. */
  arrow?: 'right' | 'down';
  /**
   * Icône avant le libellé, à la place de la flèche : mail (lien mailto), book (lire en ligne),
   * download (télécharger un fichier).
   */
  icon?: 'mail' | 'book' | 'download';
  /** Lien vers la page affichée (aria-current="page"). */
  current?: boolean;
  class?: string;
}

const { href, variant = 'secondary', size = 'md', arrow = 'right', icon, current, class: className, ...rest } = Astro.props;
const Tag = href === undefined ? 'button' : 'a';
const type: 'button' | undefined = href === undefined ? 'button' : undefined;
---

<Tag
  href={href}
  type={type}
  aria-current={current ? 'page' : undefined}
  class:list={['btn', 'btn-motion', `btn--${variant}`, `btn--${size}`, className]}
  {...rest}
>
  {variant === 'don' && <Heart size={18} />}
  {icon === 'mail' && <Mail size={20} />}
  {icon === 'book' && <BookOpen size={20} />}
  {icon === 'download' && <Download size={20} />}
  <slot />
  {variant !== 'don' && !icon && (arrow === 'down' ? <ArrowDown size={20} /> : <ArrowRight size={20} />)}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-button);
    line-height: 1;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn svg {
    flex-shrink: 0;
  }

  button.btn {
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }

  button.btn[hidden] {
    display: none;
  }

  /* Écran très étroit (320px, zoom 400 %) : le libellé passe sur deux lignes plutôt que de déborder. */
  @media (max-width: 400px) {
    .btn {
      max-width: 100%;
      white-space: normal;
      line-height: 1.2;
    }
  }

  .btn--don {
    background: var(--don);
    color: var(--noir-95);
  }

  .btn--don:hover {
    color: var(--noir-95);
    background: color-mix(in srgb, var(--don) 88%, var(--noir-95));
  }

  .btn--primary {
    background: var(--bouton-plein);
    color: var(--texte-sur-bouton);
  }

  .btn--primary:hover {
    background: var(--texte-fort);
    color: var(--texte-sur-bouton);
  }

  /* Sur photo : inchangé dans les deux modes. */
  .btn--on-dark-primary {
    background: var(--blanc);
    color: var(--noir-95);
  }

  .btn--on-dark-primary:hover {
    background: var(--vert-clair);
    color: var(--noir-95);
  }

  .btn--secondary,
  .btn--on-dark {
    border: 2px solid currentColor;
    font-weight: 500;
  }

  .btn--secondary {
    color: var(--texte);
  }

  .btn--secondary:hover {
    color: var(--texte-fort);
    background: var(--section);
  }

  .btn--on-dark,
  .btn--on-dark:hover {
    color: var(--blanc);
  }

  .btn--md {
    padding: 16px 28px;
  }

  .btn--md.btn--secondary,
  .btn--md.btn--on-dark {
    padding: 14px 26px;
  }

  .btn--sm {
    padding: 12px 22px;
    font-size: 16px;
  }
</style>
