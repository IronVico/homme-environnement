---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Heart from '@lucide/astro/icons/heart';

interface Props {
  href: string;
  /** don : pêche, réservé à « Faire un don ». secondary : contour basalte. on-dark : contour blanc sur photo. */
  variant?: 'don' | 'secondary' | 'on-dark';
  /** md : hero. sm : header et footer. */
  size?: 'md' | 'sm';
  class?: string;
}

const { href, variant = 'secondary', size = 'md', class: className } = Astro.props;
---

<a href={href} class:list={['btn', 'btn-motion', `btn--${variant}`, `btn--${size}`, className]}>
  {variant === 'don' && <Heart size={18} />}
  <slot />
  {variant !== 'don' && <ArrowRight size={20} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-button);
    line-height: 1;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn svg {
    flex-shrink: 0;
  }

  .btn--don {
    background: var(--peche);
    color: var(--noir-95);
  }

  .btn--don:hover {
    color: var(--noir-95);
    background: color-mix(in srgb, var(--peche) 88%, var(--noir-95));
  }

  .btn--secondary,
  .btn--on-dark {
    border: 2px solid currentColor;
    font-weight: 500;
  }

  .btn--secondary {
    color: var(--basalte);
  }

  .btn--secondary:hover {
    color: var(--noir-95);
    background: var(--vert-clair);
  }

  .btn--on-dark,
  .btn--on-dark:hover {
    color: var(--blanc);
  }

  .btn--md {
    padding: 16px 28px;
  }

  .btn--md.btn--secondary,
  .btn--md.btn--on-dark {
    padding: 14px 26px;
  }

  .btn--sm {
    padding: 12px 22px;
    font-size: 16px;
  }
</style>
