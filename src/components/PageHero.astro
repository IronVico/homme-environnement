---
/**
 * Hero des pages internes (pays, sites) : titre en deux temps, phrase de contexte,
 * un bouton secondaire, photo verticale en arche à droite (même format sur toutes les pages).
 * Options des fiches site : pastille de lieu, bouton Don avant le bouton secondaire, légende.
 * Options des pages S'engager : étiquettes, second paragraphe, bouton principal (basalte).
 * Variante portrait (page Équipe) : portrait d'une personne, avatar aux initiales sans photo,
 * carte citation qui chevauche le bas de la photo ; reste vertical (4:5) une fois empilé.
 * Le motif « courbes de niveau » passe derrière la photo, ancré en haut à droite.
 */
import MapPin from '@lucide/astro/icons/map-pin';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import ContourPattern from './ContourPattern.astro';
import Portrait from './Portrait.astro';

interface Props {
  titleStrong: string;
  titleLight: string;
  lead: string;
  /** Photo du hero ; facultative en variante portrait (avatar aux initiales). */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Cadrage de la photo (object-position). */
  imagePosition?: string;
  /** Bouton secondaire, facultatif ; une ancre (« #sites ») affiche une flèche vers le bas. */
  cta?: { label: string; href: string };
  /** Bouton Don (pêche), placé avant le bouton secondaire. */
  donate?: { label: string; href: string };
  /** Bouton principal (basalte), placé avant le bouton secondaire ; flèche vers la droite par défaut. */
  primary?: { label: string; href: string; arrow?: 'right' | 'down' };
  /** Étiquettes au-dessus du titre : « Volontariat », « Stage »… */
  tags?: string[];
  /** Second paragraphe, sous le chapeau, en texte courant. */
  text?: string;
  /** Pastille de lieu au-dessus du titre : « Madagascar · Centre-Est ». */
  badge?: string;
  /** Légende sous la photo (crédit). */
  caption?: string;
  /**
   * Variante portrait : la photo (`image`, facultative) est le portrait de `name`.
   * Citation facultative, dans une carte qui chevauche le bas de la photo.
   */
  portrait?: { name: string; role: string; quote?: string };
}

const {
  titleStrong,
  titleLight,
  lead,
  image,
  imageAlt,
  imagePosition = '50% 50%',
  cta,
  donate,
  primary,
  tags,
  text,
  badge,
  caption,
  portrait,
} = Astro.props;

// La photo remplit un cadre de 460 × 575 px (4:5) : une photo plus large que haute y est
// affichée plus large que le cadre (puis rognée). On annonce cette largeur au navigateur,
// sinon il télécharge une version trop petite et la photo paraît floue sur écran Retina.
const coverWidth = image ? Math.round(Math.max(460, (575 * image.width) / image.height)) : 460;
const photoWidths = [460, 640, 900, 1260, 1800, 2400];
const photoSizes = `(max-width: 1100px) 100vw, ${coverWidth}px`;
---

<div class="page-hero-wrap">
  <section class:list={['page-hero', 'container', { 'page-hero--portrait': portrait }]}>
    <div class="page-hero__text">
      {
        badge && (
          <p class="page-hero__badge" data-reveal>
            <MapPin size={16} />
            {badge}
          </p>
        )
      }
      {
        tags && tags.length > 0 && (
          <ul class="page-hero__tags" data-reveal>
            {tags.map((tag) => (
              <li class="page-hero__tag">{tag}</li>
            ))}
          </ul>
        )
      }
      <h1 class="page-hero__title" data-reveal>
        <span class="page-hero__strong">{titleStrong}</span><br />
        <span class="page-hero__light">{titleLight}</span>
      </h1>
      <p class="page-hero__lead" data-reveal>{lead}</p>
      {text && <p class="page-hero__text-more" data-reveal>{text}</p>}
      {
        (donate || primary || cta) && (
          <div class="page-hero__ctas" data-reveal>
            {donate && <Button href={donate.href} variant="don">{donate.label}</Button>}
            {primary && <Button href={primary.href} variant="primary" arrow={primary.arrow}>{primary.label}</Button>}
            {cta && (
              <Button href={cta.href} variant="secondary" arrow={cta.href.length > 1 && cta.href.startsWith('#') ? 'down' : 'right'}>
                {cta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>

    <!-- Pas de data-reveal sur la figure : son animation (transform) déplacerait le repère du motif. -->
    <figure class="page-hero__figure">
      <ContourPattern variant="hero" class="page-hero__contours" />
      {
        portrait ? (
          <div class="page-hero__portrait" data-reveal>
            <Portrait
              class="page-hero__photo"
              name={portrait.name}
              photo={image}
              position={imagePosition}
              widths={photoWidths}
              sizes={photoSizes}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        ) : (
          image && (
            <Picture
              data-reveal
              class="page-hero__photo"
              src={image}
              alt={imageAlt ?? ''}
              style={`object-position: ${imagePosition}`}
              formats={['avif', 'webp']}
              widths={photoWidths}
              sizes={photoSizes}
              loading="eager"
              fetchpriority="high"
            />
          )
        )
      }
      {
        portrait?.quote && (
          <figcaption class="page-hero__quote" data-reveal>
            <blockquote class="page-hero__quote-text">« {portrait.quote} »</blockquote>
            <span class="page-hero__quote-author">
              <strong>{portrait.name}</strong> · {portrait.role}
            </span>
          </figcaption>
        )
      }
      {caption && <figcaption class="page-hero__caption" data-reveal>{caption}</figcaption>}
    </figure>
  </section>
</div>

<style>
  /* Repère du motif. Il est coupé au bord du hero : à droite (pas de scroll horizontal) et
     en bas, sinon il passerait par-dessus la section suivante quand elle n'est pas
     positionnée (Nos projets). En haut, rien de visible n'est perdu : le masque rend les
     70 premiers px du motif transparents.
     isolation : le motif (z-index -1) passe sous tout le contenu du hero. */
  .page-hero-wrap {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  /* Motif en haut à droite, derrière la photo. Ancré sur le centre de la page (et non sur
     le bord droit) pour rester à droite de la colonne de texte à toutes les largeurs :
     il ne passe jamais derrière le texte. À 1440px, même place que la maquette (±35px). */
  .page-hero :global(.page-hero__contours) {
    z-index: -1;
    left: calc(50% + 60px);
    right: auto;
  }

  /*
   * Comme l'accueil, le hero occupe tout le premier écran sous le header (88px, 84px en
   * mobile) et le fil d'Ariane (une ligne, 26px) : la bande suivante commence sous la
   * ligne de flottaison au lieu d'apparaître en liseré vide en bas de l'écran.
   */
  .page-hero {
    --header-h: 88px;
    --crumb-h: 26px;
    --hero-pt: clamp(24px, 4vw, 48px);
    --hero-pb: clamp(48px, 6vw, 72px);
    /* .container est en content-box : on retire aussi les paddings verticaux. */
    min-height: calc(100svh - var(--header-h) - var(--crumb-h) - var(--hero-pt) - var(--hero-pb));
    display: flex;
    align-items: center;
    gap: 40px 64px;
    padding-top: var(--hero-pt);
    padding-bottom: var(--hero-pb);
  }

  @media (max-width: 900px) {
    .page-hero {
      --header-h: 84px;
    }
  }

  .page-hero__text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .page-hero__strong {
    font-weight: 800;
  }

  .page-hero__light {
    font-weight: 300;
  }

  .page-hero__badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--vert-clair);
    font-size: 14px;
    font-weight: 600;
  }

  .page-hero__tags {
    align-self: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-hero__tag {
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--vert-clair);
    font-size: 14px;
    font-weight: 600;
  }

  .page-hero__lead {
    max-width: 640px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }

  .page-hero__text-more {
    max-width: 640px;
    font-size: 16px;
    line-height: var(--lh-body);
  }

  .page-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .page-hero__figure {
    flex: 0 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  /* Photo verticale en arche : 160px en haut, 20px en bas. */
  .page-hero :global(.page-hero__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 160px 160px 20px 20px;
  }

  .page-hero__caption {
    font-size: var(--fs-caption);
    color: var(--ardoise);
  }

  /* Empilé : la photo passe sous le texte et prend toute la largeur. */
  @media (max-width: 1080px) {
    .page-hero {
      flex-direction: column;
      align-items: stretch;
    }

    .page-hero__text {
      flex: none;
    }

    .page-hero__figure {
      flex: none;
      position: relative;
    }

    /* Empilé : le motif passe derrière la photo, sous le texte et les boutons. */
    .page-hero :global(.page-hero__contours) {
      top: -60px;
      left: auto;
      right: -220px;
    }
  }

  /* Empilé (tablette et mobile) : photo pleine largeur en paysage, pour ne pas occuper tout l'écran. */
  @media (max-width: 1080px) {
    .page-hero :global(.page-hero__photo) {
      aspect-ratio: 16 / 9;
    }
  }

  /* Mobile : arche réduite, à l'échelle de la photo paysage. */
  @media (max-width: 700px) {
    .page-hero :global(.page-hero__photo) {
      border-radius: 40px 40px 16px 16px;
    }
  }

  /*
   * Variante portrait : la carte citation chevauche le bas de la photo et déborde à
   * gauche ; la marge basse de la figure lui laisse la place. Photo et citation sont
   * superposées dans la même cellule de grille : la figure n'est pas positionnée, le
   * motif reste donc ancré comme sur les autres pages (derrière la photo).
   */
  .page-hero--portrait .page-hero__figure {
    display: grid;
    margin-bottom: 32px;
  }

  .page-hero__portrait,
  .page-hero__quote {
    grid-area: 1 / 1;
  }

  .page-hero__quote {
    z-index: 1;
    align-self: end;
    margin: 0 48px -32px -16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px;
    border: 1px solid var(--bordure-douce);
    border-radius: var(--radius-card);
    background: var(--blanc);
    box-shadow: var(--shadow-card);
  }

  .page-hero__quote-text {
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 300;
    line-height: 1.4;
  }

  .page-hero__quote-author {
    font-size: 14px;
  }

  .page-hero__quote-author strong {
    font-weight: 700;
  }

  /* Empilé : le portrait reste vertical (4:5), sans dépasser la largeur du desktop. */
  @media (max-width: 1080px) {
    .page-hero--portrait .page-hero__figure {
      width: 100%;
      max-width: 460px;
    }

    .page-hero--portrait :global(.page-hero__photo) {
      aspect-ratio: 4 / 5;
    }
  }

  /* Mobile : portrait pleine largeur, arche 120px, citation passée sous la photo. */
  @media (max-width: 700px) {
    .page-hero--portrait .page-hero__figure {
      max-width: none;
      margin-bottom: 0;
    }

    .page-hero--portrait :global(.page-hero__photo) {
      border-radius: var(--radius-arch) var(--radius-arch) 16px 16px;
    }

    .page-hero__quote {
      grid-area: 2 / 1;
      /* Chevauche la photo de 40px (en comptant l'écart de 10px de la figure). */
      margin: -50px 12px 0;
    }
  }
</style>
