---
/**
 * Hero des pages internes (pays, sites) : titre en deux temps, phrase de contexte,
 * un bouton secondaire, photo en arche à droite. Plus compact que le hero de l'accueil.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from './Button.astro';

interface Props {
  titleStrong: string;
  titleLight: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Cadrage de la photo (object-position). */
  imagePosition?: string;
  /** Bouton secondaire ; une ancre (« #sites ») affiche une flèche vers le bas. */
  cta: { label: string; href: string };
}

const { titleStrong, titleLight, lead, image, imageAlt, imagePosition = '50% 50%', cta } = Astro.props;
---

<section class="page-hero container">
  <div class="page-hero__text">
    <h1 class="page-hero__title">
      <span class="page-hero__strong">{titleStrong}</span><br />
      <span class="page-hero__light">{titleLight}</span>
    </h1>
    <p class="page-hero__lead">{lead}</p>
    <div class="page-hero__ctas">
      <Button href={cta.href} variant="secondary" arrow={cta.href.startsWith('#') ? 'down' : 'right'}>{cta.label}</Button>
    </div>
  </div>

  <Picture
    class="page-hero__photo"
    src={image}
    alt={imageAlt}
    style={`object-position: ${imagePosition}`}
    formats={['avif', 'webp']}
    widths={[420, 640, 900, 1260]}
    sizes="(max-width: 1100px) 100vw, 420px"
    loading="eager"
    fetchpriority="high"
  />
</section>

<style>
  .page-hero {
    display: flex;
    align-items: center;
    gap: 40px 64px;
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .page-hero__text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .page-hero__strong {
    font-weight: 800;
  }

  .page-hero__light {
    font-weight: 300;
  }

  .page-hero__lead {
    max-width: 640px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }

  .page-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Photo en arche : 120px en haut, 20px en bas. */
  .page-hero :global(.page-hero__photo) {
    flex: 0 1 420px;
    min-width: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-arch) var(--radius-arch) 20px 20px;
  }

  /* Empilé : la photo passe sous le texte et prend toute la largeur. */
  @media (max-width: 1080px) {
    .page-hero {
      flex-direction: column;
      align-items: stretch;
    }

    .page-hero__text {
      flex: none;
    }

    .page-hero :global(.page-hero__photo) {
      flex: none;
    }
  }

  /* Tablette : photo pleine largeur moins haute, pour ne pas occuper tout l'écran. */
  @media (min-width: 600px) and (max-width: 1080px) {
    .page-hero :global(.page-hero__photo) {
      aspect-ratio: 16 / 9;
    }
  }
</style>
