---
/**
 * Hero des pages internes (pays, sites) : titre en deux temps, phrase de contexte,
 * un bouton secondaire, photo en arche à droite. Plus compact que le hero de l'accueil.
 * Fiche site (`portrait`) : pastille de lieu, bouton Don avant le bouton secondaire,
 * photo verticale plus large avec sa légende.
 * Le motif « courbes de niveau » passe derrière la photo, ancré en haut à droite.
 */
import MapPin from '@lucide/astro/icons/map-pin';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import ContourPattern from './ContourPattern.astro';

interface Props {
  titleStrong: string;
  titleLight: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Cadrage de la photo (object-position). */
  imagePosition?: string;
  /** Bouton secondaire, facultatif ; une ancre (« #sites ») affiche une flèche vers le bas. */
  cta?: { label: string; href: string };
  /** Bouton Don (pêche), placé avant le bouton secondaire. */
  donate?: { label: string; href: string };
  /** Pastille de lieu au-dessus du titre : « Madagascar · Centre-Est ». */
  badge?: string;
  /** Légende sous la photo (crédit). */
  caption?: string;
  /** Photo verticale (4:5), pour les fiches site. */
  portrait?: boolean;
}

const {
  titleStrong,
  titleLight,
  lead,
  image,
  imageAlt,
  imagePosition = '50% 50%',
  cta,
  donate,
  badge,
  caption,
  portrait = false,
} = Astro.props;
---

<div class="page-hero-wrap">
  <section class:list={['page-hero container', { 'page-hero--portrait': portrait }]}>
    <div class="page-hero__text">
      {
        badge && (
          <p class="page-hero__badge" data-reveal>
            <MapPin size={16} />
            {badge}
          </p>
        )
      }
      <h1 class="page-hero__title" data-reveal>
        <span class="page-hero__strong">{titleStrong}</span><br />
        <span class="page-hero__light">{titleLight}</span>
      </h1>
      <p class="page-hero__lead" data-reveal>{lead}</p>
      {
        (donate || cta) && (
          <div class="page-hero__ctas" data-reveal>
            {donate && <Button href={donate.href} variant="don">{donate.label}</Button>}
            {cta && (
              <Button href={cta.href} variant="secondary" arrow={cta.href.length > 1 && cta.href.startsWith('#') ? 'down' : 'right'}>
                {cta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>

    <!-- Pas de data-reveal sur la figure : son animation (transform) déplacerait le repère du motif. -->
    <figure class="page-hero__figure">
      <ContourPattern variant="hero" class="page-hero__contours" />
      <Picture
        data-reveal
        class="page-hero__photo"
        src={image}
        alt={imageAlt}
        style={`object-position: ${imagePosition}`}
        formats={['avif', 'webp']}
        widths={[420, 640, 900, 1260]}
        sizes={portrait ? '(max-width: 1100px) 100vw, 460px' : '(max-width: 1100px) 100vw, 420px'}
        loading="eager"
        fetchpriority="high"
      />
      {caption && <figcaption class="page-hero__caption" data-reveal>{caption}</figcaption>}
    </figure>
  </section>
</div>

<style>
  /* Repère du motif. Il est coupé au bord du hero : à droite (pas de scroll horizontal) et
     en bas, sinon il passerait par-dessus la section suivante quand elle n'est pas
     positionnée (Nos projets). En haut, rien de visible n'est perdu : le masque rend les
     70 premiers px du motif transparents.
     isolation : le motif (z-index -1) passe sous tout le contenu du hero. */
  .page-hero-wrap {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  /* Motif en haut à droite, derrière la photo. Ancré sur le centre de la page (et non sur
     le bord droit) pour rester à droite de la colonne de texte à toutes les largeurs :
     il ne passe jamais derrière le texte. À 1440px, même place que la maquette (±35px). */
  .page-hero :global(.page-hero__contours) {
    z-index: -1;
    left: calc(50% + 60px);
    right: auto;
  }

  .page-hero {
    display: flex;
    align-items: center;
    gap: 40px 64px;
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .page-hero__text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .page-hero__strong {
    font-weight: 800;
  }

  .page-hero__light {
    font-weight: 300;
  }

  .page-hero__badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--vert-clair);
    font-size: 14px;
    font-weight: 600;
  }

  .page-hero__lead {
    max-width: 640px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }

  .page-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .page-hero__figure {
    flex: 0 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  /* Photo en arche : 120px en haut, 20px en bas. */
  .page-hero :global(.page-hero__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-arch) var(--radius-arch) 20px 20px;
  }

  /* Fiche site : photo verticale, arche plus marquée (160px). */
  .page-hero--portrait .page-hero__figure {
    flex-basis: 460px;
  }

  .page-hero--portrait :global(.page-hero__photo) {
    aspect-ratio: 4 / 5;
    border-radius: 160px 160px 20px 20px;
  }

  .page-hero__caption {
    font-size: var(--fs-caption);
    color: var(--ardoise);
  }

  /* Empilé : la photo passe sous le texte et prend toute la largeur. */
  @media (max-width: 1080px) {
    .page-hero {
      flex-direction: column;
      align-items: stretch;
    }

    .page-hero__text {
      flex: none;
    }

    .page-hero__figure {
      flex: none;
      position: relative;
    }

    /* Empilé : le motif passe derrière la photo, sous le texte et les boutons. */
    .page-hero :global(.page-hero__contours) {
      top: -60px;
      left: auto;
      right: -220px;
    }
  }

  /* Tablette : photo pleine largeur moins haute, pour ne pas occuper tout l'écran. */
  @media (min-width: 600px) and (max-width: 1080px) {
    .page-hero :global(.page-hero__photo),
    .page-hero--portrait :global(.page-hero__photo) {
      aspect-ratio: 16 / 9;
    }
  }
</style>
