---
/**
 * Carte du pays avec un repère numéroté par site, et la liste des sites à côté.
 * Madagascar : carte verticale collée pendant qu'on parcourt la liste.
 * Burkina Faso (un site) : carte large, nom du site sous le repère, note de position.
 * Repère et carte de site sont liés : survoler ou parcourir au clavier un repère
 * ou une carte de site met ce site en avant des deux côtés. Repère et carte
 * mènent tous deux à la fiche du site.
 * Sans JS : le premier site est mis en avant, la liste reste complète.
 */
import Info from '@lucide/astro/icons/info';
import type { ComponentProps } from 'astro/types';
import BurkinaMap from './BurkinaMap.astro';
import MadagascarMap from './MadagascarMap.astro';
import SiteCard from './SiteCard.astro';

type Site = Omit<ComponentProps<typeof SiteCard>, 'selected'> & {
  /** Région, lue avec le numéro sur le repère (« 1. Vohimana, Centre-Est »). */
  region: string;
  /** Position du repère, en % de la carte. */
  mapPosition: { x: number; y: number };
};

interface Props {
  sites: Site[];
  /** Libellés de la carte : mers pour Madagascar, pays voisins et note de position pour le Burkina Faso. */
  map: {
    label: string;
    capital: string;
    north: string;
    channel?: string;
    ocean?: string;
    neighbours?: string[];
    note?: string;
  };
  country?: 'madagascar' | 'burkina-faso';
}

const { sites, map, country = 'madagascar' } = Astro.props;
const selectedId = sites[0]?.id;
const wide = country === 'burkina-faso';
const CountryMap = wide ? BurkinaMap : MadagascarMap;
---

<div class:list={['sites-explorer', { 'sites-explorer--wide': wide }]} data-sites-explorer>
  <div class="sites-explorer__map">
    <div class="sites-explorer__panel" role="group" aria-label={map.label}>
      <CountryMap labels={{ ...map, neighbours: map.neighbours ?? [] }}>
        {
          sites.map((site) => (
            <a
              class="sites-explorer__pin"
              href={site.href}
              style={`left: ${site.mapPosition.x}%; top: ${site.mapPosition.y}%`}
              aria-label={`${site.num}. ${site.name}, ${site.region} : ${site.linkLabel.toLowerCase()}`}
              data-pin={site.id}
              data-selected={site.id === selectedId ? '' : undefined}
            >
              <span class="sites-explorer__drop">
                <span class="sites-explorer__num">{site.num}</span>
              </span>
            </a>
          ))
        }
        {
          wide &&
            sites.map((site) => (
              <span
                class="sites-explorer__name"
                style={`left: ${site.mapPosition.x}%; top: ${site.mapPosition.y}%`}
                aria-hidden="true"
              >
                {site.name}
              </span>
            ))
        }
      </CountryMap>
    </div>
    {
      map.note && (
        <p class="sites-explorer__note">
          <Info size={16} />
          {map.note}
        </p>
      )
    }
  </div>

  <ol class="sites-explorer__list">
    {sites.map(({ mapPosition: _, region: __, ...site }) => <SiteCard {...site} selected={site.id === selectedId} />)}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sites-explorer]').forEach((root) => {
    const pins = [...root.querySelectorAll<HTMLElement>('[data-pin]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-site]')];

    const select = (id: string) => {
      pins.forEach((pin) => pin.toggleAttribute('data-selected', pin.dataset.pin === id));
      cards.forEach((card) => card.toggleAttribute('data-selected', card.dataset.site === id));
    };

    pins.forEach((pin) => {
      const pick = () => pin.dataset.pin && select(pin.dataset.pin);
      pin.addEventListener('mouseenter', pick);
      pin.addEventListener('focus', pick);
    });

    cards.forEach((card) => {
      const pick = () => card.dataset.site && select(card.dataset.site);
      card.addEventListener('mouseenter', pick);
      card.addEventListener('focusin', pick);
    });
  });
</script>

<style>
  /*
   * Desktop : colonne de la carte à la largeur de la carte, la liste prend le reste.
   * --map-top : distance sous le header fixé ; --panel-pad : marge intérieure du fond vert.
   */
  .sites-explorer {
    --map-top: 96px;
    --panel-pad: clamp(20px, 2.5vw, 32px);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-8);
  }

  /* La carte reste visible pendant qu'on parcourt la liste (sous le header fixé). */
  .sites-explorer__map {
    position: sticky;
    top: var(--map-top);
  }

  .sites-explorer__panel {
    display: flex;
    justify-content: center;
    padding: var(--panel-pad);
    overflow: hidden;
    border-radius: var(--radius-block);
    background: var(--section);
  }

  /*
   * La carte tient toujours en entier à l'écran : sa largeur découle de la hauteur
   * disponible (écran - header - marges), dans le rapport 399 / 772 de l'île.
   */
  .sites-explorer__panel :global(.mg-map) {
    width: clamp(
      260px,
      calc((100svh - var(--map-top) - 24px - 2 * var(--panel-pad)) * 399 / 772),
      440px
    );
  }

  .sites-explorer__note {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 13px;
  }

  .sites-explorer__note :global(svg) {
    flex-shrink: 0;
  }

  .sites-explorer__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Repère en goutte : pointe sur le site, numéro dedans. */
  .sites-explorer__pin {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    box-sizing: border-box;
    width: 44px;
    height: 48px;
    margin: -46px 0 0 -22px;
    padding: 0 0 6px;
    border: 0;
    background: transparent;
    /* Repère = lien : pas de soulignement sous le numéro. */
    text-decoration: none;
    cursor: pointer;
    filter: drop-shadow(0 3px 4px rgba(35, 31, 32, 0.25));
  }

  .sites-explorer__pin[data-selected] {
    z-index: 3;
  }

  .sites-explorer__drop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 28px;
    height: 28px;
    border: 2px solid var(--texte);
    border-radius: 50% 50% 50% 0;
    background: var(--surface);
    transform: rotate(-45deg);
    transition:
      width var(--transition-ui),
      height var(--transition-ui),
      background-color var(--transition-ui);
  }

  .sites-explorer__num {
    transform: rotate(45deg);
    font-size: 12px;
    font-weight: 700;
    color: var(--texte);
  }

  .sites-explorer__pin:hover .sites-explorer__drop {
    background: var(--section);
  }

  .sites-explorer__pin[data-selected] .sites-explorer__drop {
    width: 36px;
    height: 36px;
    border: 3px solid var(--fond);
    background: var(--bouton-plein);
  }

  .sites-explorer__pin[data-selected] .sites-explorer__num {
    font-size: 14px;
    color: var(--texte-sur-bouton);
  }

  .sites-explorer__pin:focus-visible {
    outline: none;
  }

  /* Nom du site sous son repère (carte du Burkina Faso). */
  .sites-explorer__name {
    position: absolute;
    z-index: 2;
    margin-top: 8px;
    padding: 6px 12px;
    transform: translateX(-50%);
    border: 1px solid var(--bordure-carte);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  /* Burkina Faso : carte large à gauche, carte du site à droite (380px). */
  .sites-explorer--wide {
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
  }

  .sites-explorer--wide .sites-explorer__map {
    position: static;
  }

  .sites-explorer--wide .sites-explorer__list {
    grid-template-columns: minmax(0, 1fr);
  }

  .sites-explorer__pin:focus-visible .sites-explorer__drop {
    outline: 2px solid var(--texte);
    outline-offset: 3px;
  }

  /*
   * Empilé (tablette, mobile) : la carte passe au-dessus de la liste, sur toute la
   * largeur, et ne reste pas collée (elle masquerait la liste).
   */
  @media (max-width: 900px) {
    .sites-explorer {
      grid-template-columns: minmax(0, 1fr);
    }

    .sites-explorer__map {
      position: static;
    }

    .sites-explorer__panel :global(.mg-map) {
      width: min(100%, 400px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sites-explorer__drop {
      transition: none;
    }
  }
</style>
