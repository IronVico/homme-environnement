---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { donatePath } from '../data/navigation';
import { getLang, t } from '../i18n';
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  /** H1 en deux temps : partie forte (display) puis partie douce (display-light). */
  titleStrong: string;
  titleLight: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  secondaryCta: { label: string; href: string };
}

const { eyebrow, titleStrong, titleLight, lead, image, imageAlt, secondaryCta } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { ui } = t(lang);
---

<section class="hero container">
  <div class="hero__text">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 class="hero__title" data-reveal>
      <span class="hero__title-strong">{titleStrong}</span><br />
      <span class="hero__title-light">{titleLight}</span>
    </h1>
    <p class="hero__lead" data-reveal>{lead}</p>
    <div class="hero__ctas" data-reveal>
      <Button href={donatePath(lang)} variant="don">{ui.donate}</Button>
      <Button href={secondaryCta.href} variant="secondary">{secondaryCta.label}</Button>
    </div>
  </div>

  <div class="hero__media" data-reveal>
    <svg class="hero__isotype" viewBox="34 20 98 126" aria-hidden="true">
      <path
        fill="currentColor"
        d="M75.76,80.91c2.78,4.16-3.13,7.34-8.87,12.96-14.37,14.08-26.6,36.68-14.11,42.15,10.73,4.7,16.83-4.62,20.66-11.41,6.38-11.3,8.03-28.93,12.58-29.07,4.55-.14,4.61,14.81,10.29,26.42,4.63,9.46,12.05,16.15,19.14,10.71,7.09-5.45,5.89-13.11,2.22-20.09-6.15-11.68-23.04-20.87-22.78-30.37.27-9.5,18.17-12.88,24.05-18.05,5.88-5.17,5.99-9.53,4.39-12.88s-5.39-6.84-14.54-.78c-4.18,2.77-14,14.67-18.41,12.44-4.41-2.24.86-10.68-.21-18.22-1.07-7.54-6.69-9.5-10.83-8.52-4.15.98-10.03,5.31-7.62,12.15s8.43,13.63,5.22,16.62c-4.85,4.53-10.15-5.73-24.23-6.24-10.04-.36-14.61,14.58,3.24,18.68,13.59,3.12,17.31-.26,19.83,3.52Z"
      ></path>
    </svg>
    <Picture
      class="hero__photo"
      src={image}
      alt={imageAlt}
      formats={['avif', 'webp']}
      widths={[420, 600, 900, 1200]}
      sizes="(max-width: 1100px) min(600px, 100vw), 600px"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- Indication de défilement : visible quand le hero occupe tout l'écran (desktop). -->
  <a class="hero__scroll" href="#chiffres-cles">
    <span>{ui.scrollHint}</span>
    <ArrowDown class="hero__scroll-icon" size={18} />
  </a>
</section>

<style>
  /*
   * Le hero occupe tout le premier écran sous le header (88px, 84px en mobile) :
   * la bande sauge des chiffres clés commence sous la ligne de flottaison
   * au lieu d'apparaître en liseré en bas de l'écran.
   */
  .hero {
    position: relative;
    --header-h: 88px;
    --hero-pt: clamp(24px, 6vw, 72px);
    --hero-pb: clamp(64px, 8vw, 104px);
    /* Hauteur disponible sous le header. .container est en content-box : on retire aussi
       les paddings verticaux. */
    --hero-avail: calc(100svh - var(--header-h) - var(--hero-pt) - var(--hero-pb));
    /* La photo (ratio 5:5,4) tient dans cette hauteur, pour que le hero ne dépasse pas
       l'écran et que « Faire défiler » reste visible ; 360px minimum, 600px maximum. */
    --hero-photo-max: clamp(360px, calc(var(--hero-avail) / 1.08), 600px);
    min-height: var(--hero-avail);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    gap: 56px;
    padding-top: var(--hero-pt);
    padding-bottom: var(--hero-pb);
  }

  .hero__text {
    flex: 1 1 620px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--texte);
  }

  .hero__title-strong {
    font-weight: 800;
    white-space: nowrap;
  }

  .hero__title-light {
    font-weight: 300;
  }

  .hero__lead {
    max-width: 520px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__media {
    flex: 1 1 420px;
    min-width: 0;
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Desktop (photo à côté du texte) : la photo et l'isotype suivent la hauteur d'écran. */
  @media (min-width: 1200px) {
    .hero__media {
      max-width: var(--hero-photo-max);
    }
  }

  .hero__isotype {
    position: absolute;
    width: 78%;
    right: -14%;
    top: -18%;
    transform: rotate(14deg);
    color: var(--accent);
  }

  /*
   * Forme vivante : le contour de la photo ondule et l'isotype flotte, lentement
   * et sur des durées différentes pour que le mouvement ne se répète pas à l'identique.
   */
  @keyframes hero-blob {
    0%,
    100% {
      border-radius: 46% 54% 42% 58% / 52% 40% 60% 48%;
    }
    33% {
      border-radius: 54% 46% 50% 50% / 44% 50% 50% 56%;
    }
    66% {
      border-radius: 42% 58% 56% 44% / 56% 46% 54% 44%;
    }
  }

  @keyframes hero-isotype-float {
    0%,
    100% {
      transform: rotate(14deg) translate(0, 0);
    }
    50% {
      transform: rotate(19deg) translate(-6px, 8px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(.hero__photo) {
      animation: hero-blob 14s ease-in-out infinite;
    }

    .hero__isotype {
      animation: hero-isotype-float 11s ease-in-out infinite;
    }
  }

  /* Forme organique : rayons asymétriques. */
  .hero__media :global(.hero__photo) {
    position: relative;
    width: 100%;
    max-width: 600px;
    height: auto;
    aspect-ratio: 5 / 5.4;
    object-fit: cover;
    object-position: 62% 40%;
    border-radius: 46% 54% 42% 58% / 52% 40% 60% 48%;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--texte-doux);
    text-decoration: none;
  }

  .hero__scroll:hover {
    color: var(--texte);
  }

  /* La flèche monte et descend doucement, en boucle (désactivé avec mouvement réduit). */
  @keyframes hero-scroll-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll :global(.hero__scroll-icon) {
      animation: hero-scroll-bob 1.8s ease-in-out infinite;
    }
  }

  /*
   * Sous 1200px, la photo passe sous le texte et le hero dépasse l'écran :
   * l'indication tomberait sous la ligne de flottaison. Idem sur un écran très bas.
   */
  @media (max-width: 1199px), (max-height: 640px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      --header-h: 84px;
    }

    .hero__title-strong {
      white-space: normal;
    }
  }

  /*
   * Mobile : texte et boutons remplissent à eux seuls le premier écran, la photo
   * n'apparaissait qu'au défilement. Elle passe au-dessus du texte, en format paysage
   * bas, pour être vue dès l'arrivée. Ordre visuel seulement : dans le HTML, le h1 reste
   * en premier pour les lecteurs d'écran (la photo n'est pas focalisable).
   */
  @media (max-width: 700px) {
    .hero {
      gap: var(--space-6);
      padding-top: var(--space-3);
    }

    .hero__media {
      order: -1;
      flex-basis: 100%;
    }

    /* En paysage, les rayons en % du desktop donneraient un ovale : rayons fixes, forme
       organique sans ondulation (l'animation repasserait en %). */
    .hero__media :global(.hero__photo) {
      aspect-ratio: 16 / 10;
      max-height: 28svh;
      object-position: 62% 45%;
      border-radius: 96px 140px 84px 124px / 72px 64px 88px 76px;
      animation: none;
    }

    .hero__isotype {
      width: 34%;
      right: -4%;
      top: -10%;
    }

    .hero__text {
      gap: var(--space-5);
    }
  }
</style>
