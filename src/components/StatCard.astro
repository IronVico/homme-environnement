---
import { getLang } from '../i18n';

interface Props {
  /**
   * Valeur finale du compteur (affichée telle quelle sans JS).
   * Texte (« [X] ») : chiffre pas encore connu, affiché sans compteur.
   */
  value: number | string;
  /** Signe placé devant le chiffre : « ≈ ». */
  prefix?: string;
  /** Unité accolée au chiffre : « ans », « ha »… */
  unit?: string;
  /** Signe accolé après le chiffre, sans espace : « + » pour un minimum (« 70+ »). */
  suffix?: string;
  text: string;
  /**
   * Variante icône (fiches site) : sans illustration, l'icône passée dans le slot
   * « icon » (Lucide, 28px) s'affiche dans un disque menthe de 64px.
   *
   * ring : 30 traits (années). bars : barres croissantes. dots : pastilles (1 = 1 000 ha).
   * sites : 5 pastilles en cercle (un par site). share : anneau rempli à value %. families : deux silhouettes.
   * water : goutte au-dessus de vagues (accès à l'eau).
   * ticks, grid, segments : un élément par unité (`count`), en traits autour d'un point,
   * en grille de pastilles ou en anneau de segments.
   */
  illustration?: 'ring' | 'bars' | 'dots' | 'sites' | 'share' | 'families' | 'water' | 'ticks' | 'grid' | 'segments';
  /** Nom de l'illustration pour les lecteurs d'écran (l'icône de la variante est décorative). */
  illustrationLabel?: string;
  /** share : part de l'anneau remplie, entre 0 et 1 (par défaut value / 100). */
  ratio?: number;
  /** ticks, grid, segments : nombre d'éléments dessinés. */
  count?: number;
}

const { value, prefix, unit, suffix, text, illustration, illustrationLabel, ratio, count = 0 } = Astro.props;

const NBSP = '\u00a0';
const numberLocale = getLang(Astro.currentLocale) === 'en' ? 'en-GB' : 'fr-FR';
const number = typeof value === 'number' ? value.toLocaleString(numberLocale).replace(/\s/g, NBSP) : value;
const formatted = (prefix ? prefix + NBSP : '') + number + (suffix ?? '') + (unit ? NBSP + unit : '');

// Anneau : 30 traits, un par année depuis 1993, dans le sens horaire depuis midi.
const ringTicks = Array.from({ length: 30 }, (_, i) => {
  const angle = (i * 12 * Math.PI) / 180;
  const sin = Math.sin(angle);
  const cos = Math.cos(angle);
  return {
    x1: (50 + 34 * sin).toFixed(1),
    y1: (50 - 34 * cos).toFixed(1),
    x2: (50 + 44 * sin).toFixed(1),
    y2: (50 - 44 * cos).toFixed(1),
    last: i === 29,
  };
});

const bars = [
  { x: 10, y: 70, h: 22, fill: 'var(--accent)' },
  { x: 27, y: 58, h: 34, fill: 'var(--accent)' },
  { x: 44, y: 44, h: 48, fill: 'var(--texte)' },
  { x: 61, y: 28, h: 64, fill: 'var(--texte)' },
  { x: 78, y: 8, h: 84, fill: 'var(--don)' },
];

// Anneau de part : circonférence du cercle r=38, arc proportionnel à la valeur.
const SHARE_CIRC = 2 * Math.PI * 38;
const shareRatio = illustration !== 'share' ? 0 : (ratio ?? (typeof value === 'number' ? value / 100 : 0));

// 5 pastilles réparties en cercle, dans le sens horaire depuis midi ; la dernière en pêche.
const sitePoints = [
  { cx: 50, cy: 22, fill: 'var(--accent)' },
  { cx: 78, cy: 42, fill: 'var(--accent)' },
  { cx: 67, cy: 76, fill: 'var(--texte)' },
  { cx: 33, cy: 76, fill: 'var(--texte)' },
  { cx: 22, cy: 42, fill: 'var(--don)' },
];

// Point à un rayon et un angle (en tours, sens horaire depuis midi) du centre de l'illustration.
const polar = (r: number, turn: number) => ({
  x: (50 + r * Math.sin(turn * 2 * Math.PI)).toFixed(1),
  y: (50 - r * Math.cos(turn * 2 * Math.PI)).toFixed(1),
});

const ticks = Array.from({ length: count }, (_, i) => {
  const [from, to] = [polar(34, i / count), polar(44, i / count)];
  return { x1: from.x, y1: from.y, x2: to.x, y2: to.y };
});

// Grille de 7 colonnes, centrée en hauteur ; la première pastille en pêche, une sur trois en basalte.
const GRID_COLUMNS = 7;
const gridRows = Math.ceil(count / GRID_COLUMNS);
const gridDots = Array.from({ length: count }, (_, i) => ({
  cx: 14 + (i % GRID_COLUMNS) * 12,
  cy: 50 + (Math.floor(i / GRID_COLUMNS) - (gridRows - 1) / 2) * 18,
  fill: i === 0 ? 'var(--don)' : i % 3 === 0 ? 'var(--texte)' : 'var(--accent)',
}));

// Anneau de segments : chaque segment occupe 72 % de sa part, le reste est l'espace entre deux.
const segments = Array.from({ length: count }, (_, i) => {
  const [from, to] = [polar(38, i / count), polar(38, (i + 0.72) / count)];
  return `M${from.x} ${from.y}A38 38 0 0 1 ${to.x} ${to.y}`;
});

const dots = [
  { cx: 24, cy: 36 },
  { cx: 50, cy: 36 },
  { cx: 76, cy: 36 },
  { cx: 37, cy: 64 },
  { cx: 63, cy: 64 },
];
---

<div class="stat-card" data-stat data-reveal>
  {
    !illustration && (
      <span class="stat-card__icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }
  {illustration && <svg class="stat-card__illu" viewBox="0 0 100 100" role="img" aria-label={illustrationLabel}>
    {
      illustration === 'ring' && (
        <>
          <circle cx="50" cy="50" r="26" style="fill: var(--accent)" fill-opacity="0.3" />
          {ringTicks.map((t, i) => (
            <line
              class="stat-card__step"
              style={`--i: ${i}; stroke: ${t.last ? 'var(--don)' : 'var(--texte)'}`}
              x1={t.x1}
              y1={t.y1}
              x2={t.x2}
              y2={t.y2}
              stroke-width="3.5"
              stroke-linecap="round"
            />
          ))}
        </>
      )
    }
    {
      illustration === 'bars' && (
        <>
          <line x1="6" y1="94" x2="94" y2="94" style="stroke: var(--ligne-grille)" stroke-width="2" stroke-linecap="round" />
          {bars.map((b, i) => (
            <rect class="stat-card__step stat-card__bar" style={`--i: ${i}; fill: ${b.fill}`} x={b.x} y={b.y} width="12" height={b.h} rx="6" />
          ))}
        </>
      )
    }
    {
      illustration === 'dots' &&
        dots.map((d, i) => (
          <circle class="stat-card__step stat-card__dot" style={`--i: ${i}; fill: var(--accent)`} cx={d.cx} cy={d.cy} r="11" />
        ))
    }
    {
      illustration === 'sites' &&
        sitePoints.map((d, i) => (
          <circle class="stat-card__step stat-card__dot" style={`--i: ${i}; fill: ${d.fill}`} cx={d.cx} cy={d.cy} r="11" />
        ))
    }
    {
      illustration === 'share' && (
        <>
          <circle cx="50" cy="50" r="38" fill="none" style="stroke: var(--ligne-grille)" stroke-width="12" />
          <circle
            class="stat-card__arc"
            style={`--circ: ${SHARE_CIRC.toFixed(1)}; --offset: ${(SHARE_CIRC * (1 - shareRatio)).toFixed(1)}; stroke: var(--texte)`}
            cx="50"
            cy="50"
            r="38"
            fill="none"
            stroke-width="12"
            stroke-linecap="round"
            transform="rotate(-90 50 50)"
          />
          {/* Point d'arrivée au bout de l'arc ; la rotation est sur le groupe pour ne pas gêner l'animation. */}
          <g transform={`rotate(${(shareRatio * 360).toFixed(0)} 50 50)`}>
            <circle class="stat-card__step stat-card__dot" style="--i: 16; fill: var(--don)" cx="50" cy="12" r="6" />
          </g>
        </>
      )
    }
    {
      illustration === 'families' && (
        <>
          <circle class="stat-card__step stat-card__dot" style="--i: 0; fill: var(--accent)" cx="30" cy="34" r="12" />
          <circle class="stat-card__step stat-card__dot" style="--i: 1; fill: var(--accent)" cx="70" cy="34" r="12" />
          <path class="stat-card__step stat-card__dot" style="--i: 2; fill: var(--texte)" d="M10 82c2-14 10-22 20-22s18 8 20 22Z" />
          <path class="stat-card__step stat-card__dot" style="--i: 3; fill: var(--texte)" d="M50 82c2-14 10-22 20-22s18 8 20 22Z" />
          <circle class="stat-card__step stat-card__dot" style="--i: 4; fill: var(--don)" cx="50" cy="54" r="7" />
        </>
      )
    }
    {
      illustration === 'ticks' && (
        <>
          <circle cx="50" cy="50" r="26" style="fill: var(--accent)" fill-opacity="0.3" />
          {ticks.map((t, i) => (
            <line
              class="stat-card__step"
              style={`--i: ${i}; stroke: var(--texte)`}
              x1={t.x1}
              y1={t.y1}
              x2={t.x2}
              y2={t.y2}
              stroke-width="5"
              stroke-linecap="round"
            />
          ))}
          <circle cx="50" cy="50" r="7" style="fill: var(--don)" />
        </>
      )
    }
    {
      illustration === 'grid' &&
        gridDots.map((d, i) => (
          <circle class="stat-card__step stat-card__dot" style={`--i: ${i}; fill: ${d.fill}`} cx={d.cx} cy={d.cy} r="5" />
        ))
    }
    {
      illustration === 'segments' && (
        <>
          {segments.map((d, i) => (
            <path class="stat-card__step stat-card__dot" style={`--i: ${i}; stroke: var(--texte)`} d={d} fill="none" stroke-width="12" />
          ))}
          <circle cx="50" cy="50" r="7" style="fill: var(--don)" />
        </>
      )
    }
    {
      illustration === 'water' && (
        <>
          <path class="stat-card__step stat-card__dot" style="--i: 0; fill: var(--accent)" d="M50 10C42 26 26 42 26 60a24 24 0 0 0 48 0C74 42 58 26 50 10Z" />
          <path
            class="stat-card__step stat-card__dot"
            style="--i: 1; stroke: var(--texte)"
            d="M14 86c8-6 16-6 24 0s16 6 24 0 16-6 24 0"
            fill="none"
            stroke-width="7"
            stroke-linecap="round"
          />
          <circle class="stat-card__step stat-card__dot" style="--i: 2; fill: var(--don)" cx="42" cy="58" r="7" />
        </>
      )
    }
  </svg>}
  <div class="stat-card__body">
    <span
      class="stat-card__value"
      data-count-to={typeof value === 'number' ? value : undefined}
      data-prefix={prefix}
      data-unit={unit}
      data-suffix={suffix}
      data-locale={numberLocale}>{formatted}</span
    >
    <p class="stat-card__text">{text}</p>
  </div>
</div>

<style>
  .stat-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--bordure-carte);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .stat-card__illu {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
  }

  /* Variante icône : disque menthe de 64px, icône basalte de 28px. */
  .stat-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-pill);
    background: var(--disque);
    color: var(--texte);
  }

  .stat-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .stat-card__value {
    font-size: var(--fs-stat);
    font-weight: 800;
    line-height: 1;
    letter-spacing: var(--ls-stat);
    font-variant-numeric: tabular-nums;
  }

  .stat-card__text {
    font-size: 14px;
    line-height: 1.5;
  }

  /* Anneau de part : arc proportionnel à la valeur, tracé depuis midi. */
  .stat-card__arc {
    stroke-dasharray: var(--circ);
    stroke-dashoffset: var(--offset);
  }

  /*
   * Animation au scroll (une fois) : uniquement avec JS et sans préférence
   * de mouvement réduit. Sans JS, l'illustration est affichée complète.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stat-card__step {
      transition:
        opacity 240ms ease-out,
        transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i) * 60ms);
    }

    :global(.js) .stat-card__bar {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      transition-delay: calc(var(--i) * 120ms);
    }

    :global(.js) .stat-card__dot {
      transform-box: fill-box;
      transform-origin: 50% 50%;
    }

    :global(.js) .stat-card__arc {
      transition: stroke-dashoffset 1200ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(.js) [data-stat]:not(.is-visible) .stat-card__arc {
      stroke-dashoffset: var(--circ);
    }

    :global(.js) [data-stat]:not(.is-visible) line.stat-card__step {
      opacity: 0.15;
    }

    :global(.js) [data-stat]:not(.is-visible) .stat-card__bar {
      transform: scaleY(0);
    }

    :global(.js) [data-stat]:not(.is-visible) .stat-card__dot {
      opacity: 0;
      transform: scale(0.4);
    }
  }
</style>
