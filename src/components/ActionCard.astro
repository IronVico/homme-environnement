---
/** Carte d'une action menée sur un site : icône, titre, texte, lien vers le projet. */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import FlaskConical from '@lucide/astro/icons/flask-conical';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Shield from '@lucide/astro/icons/shield';
import Sprout from '@lucide/astro/icons/sprout';
import Tent from '@lucide/astro/icons/tent';
import Trees from '@lucide/astro/icons/trees';

const ICONS = {
  surveillance: Shield,
  laboratoire: FlaskConical,
  tourisme: Tent,
  agriculture: Sprout,
  reboisement: Trees,
  education: GraduationCap,
};

interface Props {
  icon: keyof typeof ICONS;
  title: string;
  text: string;
  href: string;
  linkLabel: string;
}

const { icon, title, text, href, linkLabel } = Astro.props;
const Icon = ICONS[icon];
---

<li class="action-card-item" data-reveal>
  <a class="action-card card-lift" href={href}>
    <span class="action-card__icon"><Icon size={22} /></span>
    <h3 class="action-card__title">{title}</h3>
    <p class="action-card__text">{text}</p>
    <span class="action-card__more">
      {linkLabel}
      <ArrowRight class="action-card__arrow" size={18} />
    </span>
  </a>
</li>

<style>
  .action-card-item {
    display: flex;
  }

  .action-card {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--blanc);
    color: var(--basalte);
    border: 1px solid var(--bordure-douce);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .action-card:hover {
    color: var(--basalte);
  }

  .action-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--menthe);
  }

  .action-card__title {
    font-size: 19px;
    font-weight: 700;
  }

  .action-card__text {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }

  .action-card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: 4px;
    font-size: var(--fs-body-sm);
    font-weight: 600;
  }

  .action-card :global(.action-card__arrow) {
    flex-shrink: 0;
    transition: transform var(--transition-ui);
  }

  .action-card:hover :global(.action-card__arrow),
  .action-card:focus-visible :global(.action-card__arrow) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .action-card:hover :global(.action-card__arrow),
    .action-card:focus-visible :global(.action-card__arrow) {
      transform: none;
    }
  }
</style>
