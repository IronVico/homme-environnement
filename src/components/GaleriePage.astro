---
/**
 * Page « Galerie photos » (maquettes Galerie / GalerieMobile), commune aux deux langues
 * (/ressources/galerie et /en/ressources/galerie). Textes dans src/i18n (clé `galerie`),
 * photos dans src/data/galerie.ts.
 * Un petit script filtre les photos par lieu et ouvre la visionneuse. Sans JS, les pastilles
 * restent masquées, toutes les photos s'affichent et chaque vignette ouvre la photo en grand.
 */
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import X from '@lucide/astro/icons/x';
import { getImage, Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { GALLERY_PHOTOS, GALLERY_PLACES, type GalleryCredit, type GalleryPlace } from '../data/galerie';
import { CONTACT_EMAIL } from '../data/navigation';
import { getLang, localeUrl, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fill } from '../lib/don';
import Breadcrumb from './Breadcrumb.astro';
import Button from './Button.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PhotoBanner from './PhotoBanner.astro';
import SectionHeading from './SectionHeading.astro';

import ctaPhoto from '../assets/photos/pilier-economie-fete-ambohidravy.jpg';
import ogPhoto from '../assets/photos/ong/cascade-vohimana.jpg';

const lang = getLang(Astro.currentLocale);
const dict = t(lang);
const page = dict.galerie;

const siteNames = new Map((await getCollection('sites')).map((site) => [site.id, site.data.name]));
const placeNames = page.places as Partial<Record<GalleryPlace, string>>;

function placeName(place: GalleryPlace): string {
  const name = siteNames.get(place) ?? placeNames[place];
  if (!name) throw new Error(`Lieu « ${place} » absent de src/content/sites et de galerie.places (src/i18n).`);
  return name;
}

function creditText(credit: GalleryCredit | undefined): string {
  if (!credit) return page.list.creditMissing;
  return 'license' in credit ? `${credit.author}, ${credit.license}` : `© ${credit.author}`;
}

// Version agrandie (visionneuse) : 2000px de large au plus, jamais plus que l'original.
const photos = await Promise.all(
  GALLERY_PHOTOS.map(async (photo) => {
    const full = await getImage({ src: photo.image, width: Math.min(2000, photo.image.width), format: 'webp' });
    return {
      ...photo,
      placeName: placeName(photo.place),
      creditLabel: creditText(photo.credit),
      license: photo.credit && 'license' in photo.credit ? photo.credit : undefined,
      full: full.src,
    };
  }),
);

// Pastilles de filtre : « Tous », puis chaque lieu qui a au moins une photo, avec son nombre.
const filters = [
  { value: 'all', label: page.list.all, count: photos.length },
  ...GALLERY_PLACES.map((place) => ({
    value: place,
    label: placeName(place),
    count: photos.filter((photo) => photo.place === place).length,
  })).filter((filter) => filter.count > 0),
];

const countLabel = (count: number) => (count > 1 ? page.list.countMany : page.list.countOne).replace('{count}', String(count));

const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(page.cta.mailSubject)}`;

// « Ressources » n'a pas encore de page : affichée sans lien dans le fil d'Ariane.
const breadcrumb = [
  { label: dict.ui.breadcrumbHome, href: localeUrl(lang) },
  { label: dict.nav.main[4]!, href: '#' },
];
---

<BaseLayout title={page.title} description={page.description} ogImage={ogPhoto} ogImageAlt={GALLERY_PHOTOS[0]?.alt}>
  <Header current="ressources" />
  <Breadcrumb items={breadcrumb} current={page.title} />

  <main id="contenu">
    <section class="gallery-hero container" aria-labelledby="galerie-h1">
      <div class="gallery-hero__text">
        <h1 id="galerie-h1" class="gallery-hero__title" data-reveal>
          <span class="gallery-hero__strong">{page.hero.titleStrong}</span><br />
          <span class="gallery-hero__light">{page.hero.titleLight}</span>
        </h1>
        <p class="gallery-hero__lead" data-reveal>{page.hero.lead}</p>
      </div>
    </section>

    <section id="photos" class="gallery-section" aria-labelledby="galerie-titre">
      <div
        class="container stack"
        data-gallery
        data-count-one={page.list.countOne}
        data-count-many={page.list.countMany}
        data-position={page.viewer.position}
        data-source={page.list.source}
        data-new-tab={page.list.newTab}
      >
        <div class="gallery-head">
          <SectionHeading id="galerie-titre" strong={page.list.titleStrong} light={page.list.titleLight} />
          <p class="gallery-count" aria-live="polite" data-count>{countLabel(photos.length)}</p>
        </div>

        <div class="filters" role="group" aria-label={page.list.filtersLabel} data-filters hidden>
          {
            filters.map((filter) => (
              <button
                class="filters__pill"
                type="button"
                aria-pressed={filter.value === 'all' ? 'true' : 'false'}
                data-value={filter.value}
              >
                {filter.label} ({filter.count})
              </button>
            ))
          }
        </div>

        <ul class="gallery" role="list">
          {
            photos.map((photo) => (
              <li
                class="photo"
                data-place={photo.place}
                data-title={photo.title}
                data-alt={photo.alt}
                data-credit={photo.creditLabel}
                data-author={photo.license?.author}
                data-license={photo.license?.license}
                data-license-url={photo.license?.licenseUrl}
                data-source-url={photo.license?.source}
              >
                <figure class="photo__figure">
                  <a class="photo__link" href={photo.full} aria-label={fill(page.list.open, { title: photo.title })} data-open>
                    <Picture
                      class="photo__img"
                      src={photo.image}
                      alt={photo.alt}
                      style={`aspect-ratio: ${photo.ratio ?? `${photo.image.width} / ${photo.image.height}`}; object-position: ${photo.position ?? '50% 50%'}`}
                      formats={['avif', 'webp']}
                      widths={[360, 560, 840, 1200]}
                      sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 424px"
                    />
                  </a>
                  <figcaption class="photo__caption">
                    <span class="photo__title">{photo.title}</span>
                    <span class="photo__credit">{photo.creditLabel}</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>

        <dialog class="viewer" aria-labelledby="viewer-title" aria-describedby="viewer-position" data-viewer>
          <div class="viewer__inner">
            <p class="viewer__position" id="viewer-position" data-viewer-position></p>
            <button
              class="viewer__btn viewer__close"
              type="button"
              aria-label={page.viewer.close}
              data-tooltip={page.viewer.close}
              data-tooltip-align="end"
              data-tooltip-pos="below"
              data-viewer-close
            >
              <X size={24} />
            </button>
            <button
              class="viewer__btn viewer__prev"
              type="button"
              aria-label={page.viewer.previous}
              data-tooltip={page.viewer.previous}
              data-tooltip-align="start"
              data-viewer-prev
            >
              <ChevronLeft size={28} />
            </button>
            <div class="viewer__media">
              <img class="viewer__img" src="" alt="" data-viewer-img />
            </div>
            <button
              class="viewer__btn viewer__next"
              type="button"
              aria-label={page.viewer.next}
              data-tooltip={page.viewer.next}
              data-tooltip-align="end"
              data-viewer-next
            >
              <ChevronRight size={28} />
            </button>
            <div class="viewer__caption">
              <p class="viewer__title" id="viewer-title" data-viewer-title></p>
              <p class="viewer__credit" data-viewer-credit></p>
            </div>
          </div>
        </dialog>
      </div>
    </section>

    <PhotoBanner
      id="contribuer-titre"
      titleStrong={page.cta.titleStrong}
      titleLight={page.cta.titleLight}
      text={page.cta.text}
      image={ctaPhoto}
      imagePosition="50% 50%"
    >
      <!-- TODO page Contact : renvoyer vers elle au lieu du mailto. -->
      <Button href={mailto} variant="on-dark-primary" icon="mail">{page.cta.contact}</Button>
    </PhotoBanner>
  </main>

  <Footer />
</BaseLayout>

<script>
  /*
   * Filtre par lieu (« all » : tous) et visionneuse (<dialog> modal) : flèches gauche et
   * droite pour passer d'une photo à l'autre parmi celles affichées, Échap pour fermer.
   */
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-value]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-place]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const { countOne = '', countMany = '', position = '', source = '', newTab = '' } = root.dataset;

    const select = (value: string) => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.value === value)));
      let shown = 0;
      items.forEach((item) => {
        item.hidden = value !== 'all' && item.dataset.place !== value;
        if (!item.hidden) shown += 1;
      });
      if (count) count.textContent = (shown > 1 ? countMany : countOne).replace('{count}', String(shown));
    };

    buttons.forEach((button) => button.addEventListener('click', () => select(button.dataset.value!)));
    root.querySelector<HTMLElement>('[data-filters]')?.removeAttribute('hidden');

    const dialog = root.querySelector<HTMLDialogElement>('[data-viewer]');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const img = dialog.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const title = dialog.querySelector<HTMLElement>('[data-viewer-title]')!;
    const credit = dialog.querySelector<HTMLElement>('[data-viewer-credit]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-viewer-position]')!;

    let visible: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const link = (href: string, label: string) => {
      const a = document.createElement('a');
      a.href = href;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = label;
      const hint = document.createElement('span');
      hint.className = 'visually-hidden';
      hint.textContent = ` ${newTab}`;
      a.append(hint);
      return a;
    };

    const show = (i: number) => {
      index = (i + visible.length) % visible.length;
      const item = visible[index]!;
      const { title: text = '', alt = '', credit: creditLabel = '', author, license, licenseUrl, sourceUrl } = item.dataset;
      img.src = item.querySelector<HTMLAnchorElement>('[data-open]')!.href;
      img.alt = alt;
      title.textContent = text;
      // Licence libre : auteur, lien vers la licence et vers la photo d'origine (obligatoires).
      if (author && license && licenseUrl && sourceUrl) {
        credit.replaceChildren(`${author}, `, link(licenseUrl, license), ' · ', link(sourceUrl, source));
      } else {
        credit.textContent = creditLabel;
      }
      counter.textContent = position.replace('{index}', String(index + 1)).replace('{count}', String(visible.length));
      const single = visible.length < 2;
      dialog.querySelectorAll<HTMLButtonElement>('[data-viewer-prev], [data-viewer-next]').forEach((button) => {
        button.hidden = single;
      });
    };

    items.forEach((item) => {
      item.querySelector<HTMLAnchorElement>('[data-open]')?.addEventListener('click', (event) => {
        event.preventDefault();
        opener = event.currentTarget as HTMLElement;
        visible = items.filter((candidate) => !candidate.hidden);
        show(visible.indexOf(item));
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-viewer-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-viewer-next]')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-viewer-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      else if (event.key === 'ArrowRight') show(index + 1);
      else return;
      event.preventDefault();
    });

    // Clic hors de la photo et des commandes : ferme.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.classList.contains('viewer__inner') || target.classList.contains('viewer__media')) dialog.close();
    });

    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
    });
  });
</script>

<style>
  .gallery-hero {
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .gallery-hero__text {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .gallery-hero__title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    overflow-wrap: break-word;
  }

  .gallery-hero__strong {
    font-weight: 800;
  }

  .gallery-hero__light {
    font-weight: 300;
  }

  .gallery-hero__lead {
    max-width: 640px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }

  .gallery-section {
    padding-bottom: var(--space-section);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Titre à gauche, compteur aligné sur le titre à droite. */
  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .gallery-count {
    padding-top: clamp(8px, 1.2vw, 16px);
    font-size: 16px;
    font-weight: 600;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filters[hidden] {
    display: none;
  }

  /* Pastille active : basalte plein, comme la rubrique courante du menu. */
  .filters__pill {
    min-height: 44px;
    padding: 0 18px;
    border: 2px solid var(--section);
    border-radius: var(--radius-pill);
    background: var(--fond);
    color: var(--texte);
    font-size: var(--fs-body-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--transition-ui),
      border-color var(--transition-ui),
      color var(--transition-ui);
  }

  .filters__pill:hover {
    border-color: var(--texte);
  }

  .filters__pill[aria-pressed='true'] {
    background: var(--bouton-plein);
    border-color: var(--bouton-plein);
    color: var(--texte-sur-bouton);
  }

  /* Mosaïque : 3 colonnes, 2 en tablette, 1 en mobile ; chaque photo garde son format. */
  .gallery {
    columns: 3;
    column-gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1000px) {
    .gallery {
      columns: 2;
    }
  }

  @media (max-width: 600px) {
    .gallery {
      columns: 1;
    }
  }

  .photo {
    margin: 0 0 20px;
    break-inside: avoid;
  }

  .photo[hidden] {
    display: none;
  }

  .photo__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card-sm);
    background: var(--section);
  }

  .photo__link {
    display: block;
    cursor: zoom-in;
  }

  .photo__link :global(.photo__img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  /* Contour blanc à l'intérieur de la photo : le contour basalte ne se verrait pas sur une photo sombre. */
  .photo__link:focus-visible {
    outline: 3px solid var(--blanc);
    outline-offset: -6px;
  }

  /*
   * Légende sur la photo, sous un voile (62 % sous tout le texte, puis fondu vers le haut) :
   * le texte blanc reste lisible sur les zones claires. Fond fixe : couleurs en dur.
   */
  .photo__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 40px 18px 16px;
    background: linear-gradient(to top, var(--voile) calc(100% - 32px), rgb(35 31 32 / 0));
    color: var(--blanc);
    pointer-events: none;
    transition:
      opacity var(--transition-ui),
      transform var(--transition-ui);
  }

  .photo__title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  .photo__credit {
    font-size: 13px;
  }

  /* Écran à pointeur : légende au survol et au focus de la photo, masquée par Échap (WCAG 1.4.13). */
  @media (hover: hover) and (min-width: 601px) {
    .photo__caption {
      opacity: 0;
      transform: translateY(8px);
    }

    .photo:hover .photo__caption,
    .photo:focus-within .photo__caption {
      opacity: 1;
      transform: none;
    }

    :global([data-tooltips-off]) .photo .photo__caption {
      opacity: 0;
    }

    .photo__link:hover :global(.photo__img) {
      transform: scale(1.03);
    }
  }

  /*
   * Visionneuse : plein écran sur fond sombre fixe (noir-95), quel que soit le thème.
   * Couleurs en dur : le fond ne change pas avec le thème.
   */
  .viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--noir-95);
    color: var(--blanc);
  }

  .viewer::backdrop {
    background: rgb(35 31 32 / 0.6);
  }

  .viewer :global(:focus-visible) {
    outline-color: var(--blanc);
  }

  .viewer__inner {
    display: grid;
    grid-template:
      'position close' auto
      'media media' minmax(0, 1fr)
      'caption caption' auto
      / 1fr auto;
    gap: var(--space-3) var(--space-5);
    height: 100%;
    padding: var(--space-3) var(--gutter) var(--space-5);
  }

  @media (min-width: 701px) {
    .viewer__inner {
      grid-template:
        'position position close' auto
        'prev media next' minmax(0, 1fr)
        'caption caption caption' auto
        / 56px minmax(0, 1fr) 56px;
    }
  }

  .viewer__position {
    grid-area: position;
    align-self: center;
    font-size: var(--fs-body-sm);
    font-weight: 600;
  }

  .viewer__media {
    grid-area: media;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }

  .viewer__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-card-sm);
  }

  .viewer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 2px solid rgb(255 255 255 / 0.6);
    border-radius: var(--radius-pill);
    background: rgb(35 31 32 / 0.6);
    color: var(--blanc);
    cursor: pointer;
    transition: background-color var(--transition-ui);
  }

  .viewer__btn:hover {
    background: rgb(255 255 255 / 0.16);
  }

  .viewer__btn[hidden] {
    display: none;
  }

  .viewer__close {
    grid-area: close;
  }

  .viewer__prev,
  .viewer__next {
    align-self: center;
  }

  @media (min-width: 701px) {
    .viewer__prev {
      grid-area: prev;
    }

    .viewer__next {
      grid-area: next;
    }
  }

  /* Mobile : précédente et suivante posées sur les bords de la photo. */
  @media (max-width: 700px) {
    .viewer__prev,
    .viewer__next {
      grid-area: media;
      z-index: 1;
    }

    .viewer__prev {
      justify-self: start;
    }

    .viewer__next {
      justify-self: end;
    }
  }

  .viewer__caption {
    grid-area: caption;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  .viewer__title {
    font-size: var(--fs-body);
    font-weight: 600;
  }

  .viewer__credit {
    font-size: 14px;
  }

  .viewer__credit :global(a) {
    color: var(--blanc);
  }

  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .filters__pill,
    .photo__caption,
    .photo__link :global(.photo__img),
    .viewer__btn {
      transition: none;
    }

    .photo__caption {
      transform: none !important;
    }

    .photo__link:hover :global(.photo__img) {
      transform: none;
    }
  }
</style>
