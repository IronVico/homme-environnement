---
/** Lab, page Espacements : --space-*, gouttière et largeur de contenu, valeur des clamp() calculée. */
import { byPrefix } from '../../lib/lab-tokens';
import LabExample from './LabExample.astro';

const scale = byPrefix('--space-').filter((token) => token.name !== '--space-section');
const layout = byPrefix('--space-section', '--gutter', '--content-max');
const sets = [
  { id: 'lab-echelle-espaces', title: 'Échelle', text: 'Écarts entre éléments et marges intérieures.', tokens: scale },
  { id: 'lab-mise-en-page', title: 'Mise en page', text: 'Espacement vertical des sections, gouttière latérale, largeur maximale du contenu.', tokens: layout },
];
---

{
  sets.map((set) => (
    <LabExample id={set.id} title={set.title} text={set.text}>
      <ul class="spaces" role="list">
        {set.tokens.map((token) => (
          <li class="spaces__row">
            <code class="spaces__name">{token.name}</code>
            <span class="spaces__bar" style={`width: var(${token.name})`} />
            <span class="spaces__value">
              {token.value}
              {!/^\d+px$/.test(token.value) && (
                <>
                  {' · calculé : '}
                  <span data-computed-width>—</span>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </LabExample>
  ))
}

<script>
  const update = () => {
    document.querySelectorAll<HTMLElement>('[data-computed-width]').forEach((el) => {
      const bar = el.closest('li')?.querySelector<HTMLElement>('.spaces__bar');
      if (bar) el.textContent = `${Math.round(parseFloat(getComputedStyle(bar).width))}px`;
    });
  };
  update();
  window.addEventListener('resize', update);
</script>

<style>
  .spaces {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spaces__row {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr) minmax(0, 14rem);
    gap: var(--space-2) var(--space-5);
    align-items: center;
  }

  .spaces__name {
    justify-self: start;
  }

  .spaces__bar {
    display: block;
    max-width: 100%;
    height: 16px;
    border-radius: 4px;
    background: var(--accent);
  }

  .spaces__value {
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .spaces__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
