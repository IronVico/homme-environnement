---
/**
 * Carte du monde de la page « Autres projets soutenus » : terres, pays des projets et
 * noms des pays. Couleurs en variables CSS (tokens de rôle) : la carte suit le mode
 * clair / sombre. Les terres sont en --trait : --section ne se détache pas de la carte en
 * sombre. Le parent pose les repères par-dessus (slot), en % de la carte.
 * Noms masqués sous 700px : illisibles à cette échelle, les pastilles de filtre les donnent.
 */
import { WORLD_COUNTRIES_PATH, WORLD_LAND_PATH, WORLD_VIEWBOX } from '../lib/world-map';

interface Props {
  label: string;
  labels: { x: number; y: number; anchor?: 'middle' | 'end'; text: string }[];
}

const { label, labels } = Astro.props;
---

<div class="world-map">
  <svg class="world-map__svg" viewBox={WORLD_VIEWBOX} role="img" aria-label={label}>
    <path style="fill: var(--trait)" d={WORLD_LAND_PATH}></path>
    <path style="fill: var(--accent)" d={WORLD_COUNTRIES_PATH}></path>
    {
      labels.map(({ x, y, anchor, text }) => (
        <text class="world-map__label" x={x} y={y} text-anchor={anchor}>
          {text}
        </text>
      ))
    }
  </svg>
  <slot />
</div>

<style>
  .world-map {
    position: relative;
  }

  .world-map__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .world-map__label {
    font-size: 15px;
    font-weight: 600;
    fill: var(--texte);
    stroke: var(--surface);
    stroke-width: 3px;
    paint-order: stroke;
  }

  @media (max-width: 700px) {
    .world-map__label {
      display: none;
    }
  }
</style>
