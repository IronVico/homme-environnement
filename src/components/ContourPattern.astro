---

<svg class:list={['contours', `contours--${variant}`, className]} viewBox={pattern.viewBox} aria-hidden="true" focusable="false">
  {
    pattern.paths.map(({ d, opacity }, index) => (
      <path d={d} stroke-opacity={opacity} style={`--i: ${index}`} />
    ))
  }
</svg>

<style>
  .contours {
    position: absolute;
    z-index: 0;
    max-width: none;
    pointer-events: none;
    fill: none;
    stroke: var(--sauge);
    stroke-width: 1.3;
  }

  /* Respiration : chaque courbe grossit d'environ 1,5 % puis revient, en décalé
     de l'extérieur vers le centre, comme une onde lente. */
  .contours path {
    transform-box: view-box;
    transform-origin: 470px 330px; /* centre des courbes du hero (viewBox) */
    animation: contours-breathe 18s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.6s);
  }

  .contours--footer path {
    transform-origin: 380px 200px;
  }

  @keyframes contours-breathe {
    from {
      transform: scale(0.985);
    }
    to {
      transform: scale(1.015);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contours path {
      animation: none;
    }
  }

  /* Haut de page : ancré en haut à droite, passe derrière la photo du hero.
     Transparent sur les 70 premiers px, plein à 200px : rien sous le menu. */
  .contours--hero {
    top: -60px;
    right: -220px;
    width: 900px;
    height: 640px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, transparent 70px, #000 200px);
    mask-image: linear-gradient(to bottom, transparent 0, transparent 70px, #000 200px);
  }

  /* Footer : à droite, même fondu vers le haut (valeurs de la maquette). */
  .contours--footer {
    top: -120px;
    right: -160px;
    width: 700px;
    height: 420px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, transparent 110px, #000 230px);
    mask-image: linear-gradient(to bottom, transparent 0, transparent 110px, #000 230px);
  }
</style>
