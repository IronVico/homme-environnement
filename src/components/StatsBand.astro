---
import type LucideIcon from '@lucide/astro/icons/map-pin';
import { getLang, t } from '../i18n';
import StatCard from './StatCard.astro';

/**
 * Icon : variante icône de StatCard (composant Lucide, affiché à 28px dans le disque menthe),
 * à la place d'une illustration.
 */
type Stat = Parameters<typeof StatCard>[0] & { Icon?: typeof LucideIcon };

interface Props {
  stats: Stat[];
  /** Nom de la région pour les lecteurs d'écran (par défaut « Chiffres clés »). */
  label?: string;
}

const { ui } = t(getLang(Astro.currentLocale));
const { stats, label = ui.statsLabel } = Astro.props;
---

<section id="chiffres-cles" class="stats" aria-label={label}>
  <div class="stats__grid container">
    {
      stats.map(({ Icon, ...stat }) => (
        <StatCard {...stat}>{Icon && <Icon slot="icon" size={28} />}</StatCard>
      ))
    }
  </div>
</section>

<script>
  import { initStats } from '../scripts/stats';
  initStats();
</script>

<style>
  .stats {
    background: var(--accent);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-5);
    padding-block: clamp(40px, 5vw, 56px);
  }
</style>
