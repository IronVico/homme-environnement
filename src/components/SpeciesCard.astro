---
/**
 * Carte d'une espèce sur la fiche site, au gabarit des cartes de site : photo en
 * haut, nom scientifique, statut UICN, texte.
 * Pas de crédit sur la photo : les photos sous licence libre (Wikimedia Commons) sont
 * créditées (auteur, licence, source) dans les Mentions légales, section Crédits photos.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  name: string;
  /** Statut déjà formulé (« En danger critique · UICN CR ») ; `threatened` : pastille basalte. */
  status?: { label: string; threatened: boolean };
  text: string;
  photo?: ImageMetadata;
  photoAlt?: string;
  photoPosition?: string;
  /** Texte à la place de la photo quand elle manque. */
  photoMissing: string;
}

const { name, status, text, photo, photoAlt = '', photoPosition = '50% 50%', photoMissing } = Astro.props;
---

<li class="species-card" data-reveal>
  <div class="species-card__media">
    {
      photo ? (
        <Picture
          class="species-card__photo"
          src={photo}
          alt={photoAlt}
          style={`object-position: ${photoPosition}`}
          formats={['avif', 'webp']}
          widths={[320, 520, 760, 900]}
          sizes="(max-width: 700px) 100vw, 440px"
        />
      ) : (
        <span class="species-card__photo species-card__photo--missing">{photoMissing}</span>
      )
    }
  </div>
  <div class="species-card__body">
    <h3 class="species-card__name" lang="la">{name}</h3>
    {
      status && (
        <span class:list={['species-card__status', { 'species-card__status--threatened': status.threatened }]}>
          {status.label}
        </span>
      )
    }
    <p class="species-card__text">{text}</p>
  </div>
</li>

<style>
  .species-card {
    overflow: hidden;
    border: 1px solid var(--bordure-carte);
    border-radius: var(--radius-card-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  /* Cadre de la photo : coupe la photo agrandie au survol. */
  .species-card__media {
    overflow: hidden;
  }

  .species-card :global(.species-card__photo) {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .species-card__photo--missing {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--section);
    font-size: 14px;
    font-weight: 600;
  }

  .species-card__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 24px 24px;
  }

  .species-card__name {
    font-size: 20px;
    font-weight: 700;
    font-style: italic;
  }

  .species-card__status {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--section);
    font-size: 12px;
    font-weight: 600;
  }

  .species-card__status--threatened {
    background: var(--bouton-plein);
    color: var(--texte-sur-bouton);
  }

  .species-card__text {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }
</style>
