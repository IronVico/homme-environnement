---
/**
 * Bande des partenaires et bailleurs : une sélection des logos fournis par l'ONG.
 * Mode clair : logos en couleur. Mode sombre : version monochrome (src/assets/logos/partenaires-mono)
 * utilisée comme masque, à la couleur du texte doux.
 * En mobile (≤ 900px), la liste défile en boucle, avec un bouton Pause ; avec
 * prefers-reduced-motion, elle reste en grille.
 */
import { Image } from 'astro:assets';
import PauseButton from './PauseButton.astro';
import { getPartner } from '../data/partenaires';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Sélection affichée sur l'accueil (identifiants de src/data/partenaires.ts, partenaires avec logo).
const FEATURED = [
  'rainforest-trust',
  'sos-lemurs',
  'franklinia',
  'oif',
  'catholic-relief-services',
  'mnhn',
  'ministere-environnement',
  'pure-trade',
];

const partners = FEATURED.map(getPartner).flatMap((partner) =>
  partner.logo && partner.logoMono ? [{ name: partner.name, logo: partner.logo, mono: partner.logoMono }] : [],
);

// La seconde série sert uniquement à boucler le défilement : masquée aux lecteurs d'écran.
const track = [...partners.map((p) => ({ ...p, dup: false })), ...partners.map((p) => ({ ...p, dup: true }))];
---

<section class="partners" aria-labelledby="partenaires-titre" data-motion>
  <div class="partners__inner container">
    <h2 id="partenaires-titre" class="partners__title eyebrow" data-reveal>{title}</h2>
    <div class="partners__marquee" data-reveal>
      <ul class="partners__track">
        {
          track.map((p) => (
            <li class:list={['partners__logo', { 'partners__logo--dup': p.dup }]} aria-hidden={p.dup ? 'true' : undefined}>
              {!p.dup && <span class="visually-hidden">{p.name}</span>}
              <Image class="partners__img" src={p.logo} alt="" height={56} densities={[1, 2]} />
              <span
                class="partners__mark"
                aria-hidden="true"
                style={`--logo: url(${p.mono.src}); aspect-ratio: ${p.mono.width} / ${p.mono.height}`}
              ></span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="partners__controls">
      <PauseButton />
    </div>
  </div>
</section>

<style>
  .partners__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-12);
    padding-bottom: 64px;
  }

  .partners__title {
    text-align: center;
  }

  .partners__marquee {
    overflow: hidden;
  }

  .partners__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners__logo {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .partners__logo :global(.partners__img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 52px;
    object-fit: contain;
  }

  /* Mode sombre : logo monochrome, le PNG sert de masque, la couleur vient du thème. */
  .partners__mark {
    display: none;
    height: 52px;
    max-width: 100%;
    background-color: var(--texte-doux);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .partners__logo :global(.partners__img) {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .partners__mark {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .partners__logo :global(.partners__img) {
    display: none;
  }

  :global(:root[data-theme='dark']) .partners__mark {
    display: block;
  }

  .partners__logo--dup {
    display: none;
  }

  @keyframes partners-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .partners__controls {
    display: none;
  }

  /* Mobile : défilement en boucle, avec un bouton Pause (WCAG 2.2.2). Avec mouvement
     réduit, la grille reste en place : tous les logos visibles, sans défilement. */
  @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
    .partners__track {
      display: flex;
      width: max-content;
      gap: 0;
      animation: partners-scroll 20s linear infinite;
    }

    .partners[data-paused] .partners__track {
      animation-play-state: paused;
    }

    .partners__logo {
      flex: 0 0 auto;
      width: 180px;
    }

    .partners__logo--dup {
      display: flex;
    }

    .partners__controls {
      display: flex;
      justify-content: center;
    }
  }
</style>
