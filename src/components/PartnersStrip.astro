---
/**
 * Bande des partenaires et bailleurs : une sélection des logos fournis par l'ONG, en version
 * monochrome (src/assets/logos/partenaires-mono, générés depuis src/assets/logos/partenaires).
 * Chaque logo sert de masque et prend la couleur du texte doux du thème (clair ou sombre).
 * En mobile (≤ 900px), la liste défile en boucle, avec un bouton Pause ; avec
 * prefers-reduced-motion, elle reste en grille.
 */
import type { ImageMetadata } from 'astro';
import PauseButton from './PauseButton.astro';
import { getPartner } from '../data/partenaires';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Sélection affichée sur l'accueil (identifiants de src/data/partenaires.ts, partenaires avec logo).
const FEATURED = [
  'rainforest-trust',
  'sos-lemurs',
  'franklinia',
  'oif',
  'catholic-relief-services',
  'mnhn',
  'ministere-environnement',
  'pure-trade',
];

const monoLogos = import.meta.glob<ImageMetadata>('../assets/logos/partenaires-mono/*.png', {
  import: 'default',
  eager: true,
});

const partners = FEATURED.map(getPartner).flatMap((partner) => {
  const mono = monoLogos[`../assets/logos/partenaires-mono/${partner.id}.png`];
  return mono ? [{ name: partner.name, mono }] : [];
});

// La seconde série sert uniquement à boucler le défilement : masquée aux lecteurs d'écran.
const track = [...partners.map((p) => ({ ...p, dup: false })), ...partners.map((p) => ({ ...p, dup: true }))];
---

<section class="partners" aria-labelledby="partenaires-titre" data-motion>
  <div class="partners__inner container">
    <h2 id="partenaires-titre" class="partners__title eyebrow" data-reveal>{title}</h2>
    <div class="partners__marquee" data-reveal>
      <ul class="partners__track">
        {
          track.map((p) => (
            <li class:list={['partners__logo', { 'partners__logo--dup': p.dup }]} aria-hidden={p.dup ? 'true' : undefined}>
              <span
                class="partners__mark"
                role={p.dup ? undefined : 'img'}
                aria-label={p.dup ? undefined : p.name}
                style={`--logo: url(${p.mono.src}); aspect-ratio: ${p.mono.width} / ${p.mono.height}`}
              ></span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="partners__controls">
      <PauseButton />
    </div>
  </div>
</section>

<style>
  .partners__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-12);
    padding-bottom: 64px;
  }

  .partners__title {
    text-align: center;
  }

  .partners__marquee {
    overflow: hidden;
  }

  .partners__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners__logo {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  /* Logo monochrome : le PNG sert de masque, la couleur vient du thème. */
  .partners__mark {
    display: block;
    height: 52px;
    max-width: 100%;
    background-color: var(--texte-doux);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  .partners__logo--dup {
    display: none;
  }

  @keyframes partners-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .partners__controls {
    display: none;
  }

  /* Mobile : défilement en boucle, avec un bouton Pause (WCAG 2.2.2). Avec mouvement
     réduit, la grille reste en place : tous les logos visibles, sans défilement. */
  @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
    .partners__track {
      display: flex;
      width: max-content;
      gap: 0;
      animation: partners-scroll 20s linear infinite;
    }

    .partners[data-paused] .partners__track {
      animation-play-state: paused;
    }

    .partners__logo {
      flex: 0 0 auto;
      width: 180px;
    }

    .partners__logo--dup {
      display: flex;
    }

    .partners__controls {
      display: flex;
      justify-content: center;
    }
  }
</style>
