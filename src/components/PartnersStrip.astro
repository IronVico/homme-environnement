---
/**
 * Bande des partenaires et bailleurs : une sélection des logos fournis par l'ONG.
 * Mode clair : logos en couleur. Mode sombre : version monochrome (src/assets/logos/partenaires-mono)
 * utilisée comme masque, à la couleur du texte doux.
 * En mobile (≤ 900px), la liste défile en boucle ; avec prefers-reduced-motion, elle reste en grille.
 * Pas de bouton Pause : choix de Victor à la recette V1, écart assumé à WCAG 2.2.2 (voir la PR).
 * Chaque logo ouvre le site du partenaire dans un nouvel onglet (choix de Victor) ; sans site
 * connu, il mène à sa fiche sur notre page Partenaires (ancre = identifiant).
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { Image } from 'astro:assets';
import { pagePath } from '../data/navigation';
import { getPartner } from '../data/partenaires';
import { getLang, t } from '../i18n';

interface Props {
  title: string;
  /** Libellé du lien vers la page Partenaires, sous la grille. */
  link: string;
}

const { title, link } = Astro.props;
const lang = getLang(Astro.currentLocale);
const partnersPage = pagePath(lang, 'partenaires');
const newTab = t(lang).partenaires.list.newTab;

// Sélection affichée sur l'accueil (identifiants de src/data/partenaires.ts, partenaires avec logo).
const FEATURED = [
  'rainforest-trust',
  'sos-lemurs',
  'franklinia',
  'oif',
  'catholic-relief-services',
  'mnhn',
  'ministere-environnement',
  'pure-trade',
];

const partners = FEATURED.map(getPartner).flatMap((partner) =>
  partner.logo && partner.logoMono
    ? [{ id: partner.id, name: partner.name, url: partner.url, logo: partner.logo, mono: partner.logoMono }]
    : [],
);

// La seconde série sert uniquement à boucler le défilement : masquée aux lecteurs d'écran et
// hors de l'ordre de tabulation (ses liens restent cliquables à la souris et au doigt).
const track = [...partners.map((p) => ({ ...p, dup: false })), ...partners.map((p) => ({ ...p, dup: true }))];

// Grille de 4 colonnes : l'infobulle des colonnes de bord s'aligne sur le bord du logo pour ne pas sortir de l'écran.
const COLUMNS = 4;
const tooltipAlign = (i: number) => (i % COLUMNS === 0 ? 'start' : i % COLUMNS === COLUMNS - 1 ? 'end' : undefined);
---

<section class="partners" aria-labelledby="partenaires-titre">
  <div class="partners__inner container">
    <h2 id="partenaires-titre" class="partners__title eyebrow" data-reveal>{title}</h2>
    <div class="partners__marquee" data-reveal>
      <ul class="partners__track">
        {
          track.map((p, i) => (
            <li class:list={['partners__logo', { 'partners__logo--dup': p.dup }]} aria-hidden={p.dup ? 'true' : undefined}>
              <a
                class="partners__link"
                href={p.url ?? `${partnersPage}#${p.id}`}
                target={p.url ? '_blank' : undefined}
                rel={p.url ? 'noopener' : undefined}
                data-tooltip={p.name}
                data-tooltip-align={tooltipAlign(i)}
                tabindex={p.dup ? -1 : undefined}
              >
                {!p.dup && <span class="visually-hidden">{p.url ? `${p.name} ${newTab}` : p.name}</span>}
                <Image class="partners__img" src={p.logo} alt="" height={56} densities={[1, 2]} />
                <span
                  class="partners__mark"
                  aria-hidden="true"
                  style={`--logo: url(${p.mono.src}); aspect-ratio: ${p.mono.width} / ${p.mono.height}`}
                ></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <a class="partners__all" href={partnersPage}>
      <span class="partners__all-label">{link}</span>
      <ArrowRight class="partners__all-arrow" size={18} />
    </a>
  </div>
</section>

<style>
  .partners__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-12);
    padding-bottom: 64px;
  }

  .partners__title {
    text-align: center;
  }

  /* Pas d'overflow: hidden ici : il couperait les infobulles des logos (voir le défilement mobile). */

  .partners__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners__logo {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /*
   * Logo cliquable : toute la case est la zone de clic. Au repos, logo un peu atténué
   * (couleurs adoucies en clair, masque texte doux en sombre) ; au survol et au focus,
   * pleine intensité et léger soulèvement, comme les cartes cliquables.
   */
  .partners__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0 12px;
    border-radius: var(--radius-card-sm);
    transition: transform var(--transition-ui);
  }

  .partners__link:hover,
  .partners__link:focus-visible {
    transform: translateY(var(--lift-button-hover));
  }

  /* Infobulle : les noms longs (ministère, Muséum) passent sur deux lignes plutôt que de déborder. */
  .partners__link[data-tooltip]::after {
    width: max-content;
    max-width: min(240px, 80vw);
    white-space: normal;
    text-align: center;
  }

  .partners__link :global(.partners__img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 52px;
    object-fit: contain;
    filter: saturate(0.55);
    opacity: 0.85;
    transition:
      filter var(--transition-ui),
      opacity var(--transition-ui);
  }

  .partners__link:hover :global(.partners__img),
  .partners__link:focus-visible :global(.partners__img) {
    filter: none;
    opacity: 1;
  }

  /* Mode sombre : logo monochrome, le PNG sert de masque, la couleur vient du thème. */
  .partners__mark {
    display: none;
    height: 52px;
    max-width: 100%;
    background-color: var(--texte-doux);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transition: background-color var(--transition-ui);
  }

  .partners__link:hover .partners__mark,
  .partners__link:focus-visible .partners__mark {
    background-color: var(--texte);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .partners__link :global(.partners__img) {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .partners__mark {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .partners__link :global(.partners__img) {
    display: none;
  }

  :global(:root[data-theme='dark']) .partners__mark {
    display: block;
  }

  .partners__logo--dup {
    display: none;
  }

  @keyframes partners-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Mobile : défilement en boucle, sans bouton Pause (choix de recette). Avec mouvement
     réduit, la grille reste en place : tous les logos visibles, sans défilement. */
  @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
    /* clip (et non hidden) : coupe la bande à l'horizontale, laisse passer l'infobulle au-dessus. */
    .partners__marquee {
      overflow-x: clip;
    }

    .partners__track {
      display: flex;
      width: max-content;
      gap: 0;
      animation: partners-scroll 20s linear infinite;
    }

    .partners__logo {
      flex: 0 0 auto;
      width: 180px;
    }

    .partners__logo--dup {
      display: flex;
    }

    /* Un logo survolé ne s'échappe pas sous la souris. */
    .partners__track:has(.partners__link:hover) {
      animation-play-state: paused;
    }

    /* Au clavier, la bande se fige en grille (comme avec mouvement réduit) : le logo qui a le
       focus est toujours à l'écran, pas dans la partie coupée de la bande. */
    .partners__marquee:has(.partners__link:focus-visible) {
      overflow-x: visible;
    }

    .partners__track:has(.partners__link:focus-visible) {
      display: grid;
      width: auto;
      gap: 16px;
      animation: none;
    }

    .partners__track:has(.partners__link:focus-visible) .partners__logo {
      width: auto;
    }

    .partners__track:has(.partners__link:focus-visible) .partners__logo--dup {
      display: none;
    }
  }

  /* Lien texte : filet sauge au repos, trait tracé au survol, flèche qui glisse (comme la page Partenaires). */
  .partners__all {
    --trait: var(--texte);
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 600;
    color: var(--texte);
    text-align: center;
    text-decoration: none;
  }

  .partners__all:hover {
    color: var(--texte);
  }

  .partners__all-label {
    padding-bottom: 3px;
    background:
      linear-gradient(var(--trait), var(--trait)) 0 100% / 0% 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) 0 100% / 100% 2px no-repeat;
    transition: background-size 300ms ease-out;
  }

  .partners__all:hover .partners__all-label,
  .partners__all:focus-visible .partners__all-label {
    background-size:
      100% 2px,
      100% 2px;
  }

  .partners__all :global(.partners__all-arrow) {
    flex-shrink: 0;
    transition: transform var(--transition-ui);
  }

  .partners__all:hover :global(.partners__all-arrow),
  .partners__all:focus-visible :global(.partners__all-arrow) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .partners__link,
    .partners__all-label,
    .partners__all :global(.partners__all-arrow) {
      transition: none;
    }

    .partners__link:hover,
    .partners__link:focus-visible,
    .partners__all:hover :global(.partners__all-arrow),
    .partners__all:focus-visible :global(.partners__all-arrow) {
      transform: none;
    }
  }
</style>
