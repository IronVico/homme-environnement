---
/**
 * Page pays Madagascar, commune aux deux langues (/sites/madagascar et
 * /en/sites/madagascar). Textes dans src/i18n, sites et projets dans les
 * collections (src/content), chiffres dans src/data/chiffres.ts.
 */
import { getCollection } from 'astro:content';
import { MADAGASCAR, SITE_FIGURES } from '../data/chiffres';
import { DON_URL } from '../data/navigation';
import { getLang, localeUrl, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import Button from './Button.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PageHero from './PageHero.astro';
import PhotoBanner from './PhotoBanner.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import SitesExplorer from './SitesExplorer.astro';
import StatsBand from './StatsBand.astro';

import heroMadagascar from '../assets/photos/pays-madagascar.jpg';
import ctaSouimanga from '../assets/photos/pilier-biodiversite-souimanga.jpg';

const lang = getLang(Astro.currentLocale);
const dict = t(lang);
const page = dict.madagascar;

const NBSP = '\u00a0';
const numberLocale = lang === 'en' ? 'en-GB' : 'fr-FR';
const formatNumber = (value: number) => value.toLocaleString(numberLocale).replace(/\s/g, NBSP);
const withCount = (text: string, count: number) => text.replace('{count}', String(count));

const sites = (await getCollection('sites', ({ data }) => data.country === 'madagascar')).sort(
  (a, b) => a.data.order - b.data.order,
);
const siteNames = new Map(sites.map((site) => [site.id, site.data.name]));

const projects = (await getCollection('projets', ({ data }) => data.country === 'madagascar')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Chiffres de la bande sauge (src/data/chiffres.ts).
const statValues = [
  { value: MADAGASCAR.hectares, prefix: '≈', illustration: 'sites' },
  {
    value: MADAGASCAR.beneficiaries,
    prefix: '≈',
    illustration: 'share',
    ratio: MADAGASCAR.beneficiaries / MADAGASCAR.inhabitants,
  },
  { value: MADAGASCAR.threatenedSpecies, illustration: 'families' },
] as const;

const stats = statValues.map((stat, i) => {
  const text = page.stats[i]!;
  return { ...stat, unit: text.unit, text: text.text, illustrationLabel: text.illustrationLabel };
});

// Chiffres de chaque site, formatés dans la langue de la page.
const siteFigures = (id: string) => {
  const figures = SITE_FIGURES[id];
  if (!figures) return [];
  const list: { kind: 'hectares' | 'years' | 'beneficiaries'; label: string }[] = [];
  if (figures.hectares !== undefined)
    list.push({ kind: 'hectares', label: `${formatNumber(figures.hectares)}${NBSP}${page.sites.hectares}` });
  if (figures.years !== undefined) list.push({ kind: 'years', label: `${formatNumber(figures.years)}${NBSP}${page.sites.years}` });
  if (figures.beneficiaries !== undefined)
    list.push({ kind: 'beneficiaries', label: `${formatNumber(figures.beneficiaries)} ${page.sites.beneficiaries}` });
  return list;
};

const breadcrumb = [
  { label: dict.ui.breadcrumbHome, href: localeUrl(lang) },
  { label: dict.nav.main[1]!, href: '#' }, // TODO page « Nos sites »
];
---

<BaseLayout title={page.title} description={page.description} ogImage={heroMadagascar} ogImageAlt={page.hero.imageAlt}>
  <Header current="sites" />
  <Breadcrumb items={breadcrumb} current={page.title} />

  <main id="contenu">
    <PageHero
      titleStrong={page.hero.titleStrong}
      titleLight={page.hero.titleLight}
      lead={page.hero.lead}
      image={heroMadagascar}
      imageAlt={page.hero.imageAlt}
      imagePosition="50% 55%"
      cta={{ label: withCount(page.hero.cta, sites.length), href: '#sites' }}
    />

    <StatsBand stats={stats} label={page.statsLabel} />

    <section id="sites" class="section" aria-labelledby="sites-titre">
      <div class="container stack">
        <SectionHeading
          id="sites-titre"
          strong={withCount(page.sites.titleStrong, sites.length)}
          light={page.sites.titleLight}
          lead={page.sites.lead}
        />
        <SitesExplorer
          map={page.sites.map}
          sites={sites.map((site) => ({
            id: site.id,
            num: site.data.order,
            name: site.data.name,
            region: site.data.region,
            summary: site.data.summary,
            image: site.data.photo,
            imagePosition: site.data.photoPosition,
            mapPosition: site.data.mapPosition,
            figures: siteFigures(site.id),
            figuresMissing: page.sites.figuresMissing,
            href: '#', // TODO fiches site
            linkLabel: page.sites.link,
          }))}
        />
      </div>
    </section>

    <section class="section section--tinted" aria-labelledby="projets-titre">
      <div class="container stack stack--40">
        <SectionHeading
          id="projets-titre"
          strong={page.projects.titleStrong}
          light={page.projects.titleLight}
          lead={page.projects.lead}
        />
        <div class="projects-grid">
          {
            projects.map((project) => (
              <ProjectCard
                title={project.data.title}
                sites={project.data.sites.map((ref) => siteNames.get(ref.id) ?? ref.id)}
                sitesLabel={page.projects.sitesLabel}
                href="#"
              />
            ))
          }
        </div>
      </div>
    </section>

    <PhotoBanner
      id="soutenir-titre"
      titleStrong={page.cta.titleStrong}
      titleLight={page.cta.titleLight}
      text={page.cta.text}
      image={ctaSouimanga}
      imagePosition="50% 45%"
      spaced
    >
      <div class="cta__buttons">
        <Button href={DON_URL} variant="don">{dict.ui.donate}</Button>
        <Button href="#" variant="on-dark">{page.cta.field}</Button>
      </div>
    </PhotoBanner>
  </main>

  <Footer />
</BaseLayout>

<style>
  .section--tinted {
    background: var(--vert-clair);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .stack--40 {
    gap: 40px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }

  .cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
