---
/**
 * Page pays Madagascar, commune aux deux langues (/actions/madagascar et
 * /en/actions/madagascar). Textes dans src/i18n, sites dans la collection
 * « sites » (src/content/sites).
 */
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { DON_URL } from '../data/navigation';
import { getLang, localeUrl, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import Button from './Button.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PageHero from './PageHero.astro';
import PhotoBanner from './PhotoBanner.astro';
import SectionHeading from './SectionHeading.astro';
import SiteCard from './SiteCard.astro';
import StatsBand from './StatsBand.astro';

import heroMadagascar from '../assets/photos/pays-madagascar.jpg';
import methodClasse from '../assets/photos/pilier-responsabilisation-classe.jpg';
import ctaSouimanga from '../assets/photos/pilier-biodiversite-souimanga.jpg';

const lang = getLang(Astro.currentLocale);
const dict = t(lang);
const page = dict.madagascar;

const sites = (await getCollection('sites', ({ data }) => data.country === 'madagascar')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Chiffres (identiques dans toutes les langues). « [X] » : nombre de familles À FOURNIR par l'ONG.
const statValues = [
  { value: sites.length, illustration: 'sites' },
  { value: 90, prefix: '≈', illustration: 'share' },
  { value: '[X]', illustration: 'families' },
] as const;

const stats = statValues.map((stat, i) => {
  const text = page.stats[i]!;
  return { ...stat, unit: text.unit, text: text.text, illustrationLabel: text.illustrationLabel };
});

const breadcrumb = [
  { label: dict.ui.breadcrumbHome, href: localeUrl(lang) },
  { label: dict.nav.main[1]!, href: '#' }, // TODO page « Nos actions »
];
---

<BaseLayout title={page.title} description={page.description} ogImage={heroMadagascar} ogImageAlt={page.hero.imageAlt}>
  <Header current="actions" />
  <Breadcrumb items={breadcrumb} current={page.title} />

  <main id="contenu">
    <PageHero
      titleStrong={page.hero.titleStrong}
      titleLight={page.hero.titleLight}
      lead={page.hero.lead}
      image={heroMadagascar}
      imageAlt={page.hero.imageAlt}
      imagePosition="50% 55%"
      cta={{ label: page.hero.cta, href: '#sites' }}
    />

    <StatsBand stats={stats} label={page.statsLabel} />

    <section id="sites" class="section" aria-labelledby="sites-titre">
      <div class="container stack">
        <SectionHeading id="sites-titre" strong={page.sites.titleStrong} light={page.sites.titleLight} lead={page.sites.lead} />
        <div class="sites-grid">
          {
            sites.map((site) => (
              <SiteCard
                class={site.data.featured ? 'sites-grid__featured' : undefined}
                name={site.data.name}
                status={page.sites.status[site.data.status]}
                summary={site.data.summary}
                image={site.data.photo}
                imagePosition={site.data.photoPosition}
                href="#"
                linkLabel={page.sites.link}
                featured={site.data.featured}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--tinted" aria-labelledby="methode-titre">
      <div class="container method">
        <Picture
          class="method__photo"
          src={methodClasse}
          alt={page.method.imageAlt}
          formats={['avif', 'webp']}
          widths={[400, 640, 1040]}
          sizes="(max-width: 960px) 100vw, 520px"
        />
        <div class="method__text">
          <SectionHeading id="methode-titre" strong={page.method.titleStrong} light={page.method.titleLight} />
          <ol class="method__steps">
            {
              page.method.steps.map((step, i) => (
                <li class="method__step">
                  <span class="method__number" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span class="method__step-body">
                    <span class="method__step-title">{step.title}</span>
                    <span class="method__step-text">{step.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <PhotoBanner
      id="soutenir-titre"
      titleStrong={page.cta.titleStrong}
      titleLight={page.cta.titleLight}
      text={page.cta.text}
      image={ctaSouimanga}
      imagePosition="50% 45%"
      spaced
    >
      <div class="cta__buttons">
        <Button href={DON_URL} variant="don">{dict.ui.donate}</Button>
        <Button href="#" variant="on-dark">{page.cta.field}</Button>
      </div>
    </PhotoBanner>
  </main>

  <Footer />
</BaseLayout>

<style>
  .section--tinted {
    background: var(--vert-clair);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* 3 colonnes, Vohimana en grande carte sur 2 ; 2 colonnes en tablette, 1 en mobile. */
  .sites-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .sites-grid :global(.sites-grid__featured) {
    grid-column: span 2;
  }

  @media (max-width: 1000px) {
    .sites-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .sites-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .sites-grid :global(.sites-grid__featured) {
      grid-column: auto;
    }
  }

  .method {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }

  /* Photo en arche : 120px en haut, 20px en bas. */
  .method :global(.method__photo) {
    flex: 1 1 380px;
    min-width: 0;
    max-width: 520px;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-arch) var(--radius-arch) 20px 20px;
  }

  .method__text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .method__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .method__step {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .method__number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background: var(--blanc);
    font-size: var(--fs-body);
    font-weight: 800;
  }

  .method__step-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .method__step-title {
    font-size: 20px;
    font-weight: 700;
  }

  .method__step-text {
    font-size: 16px;
    line-height: var(--lh-body);
  }

  .cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
