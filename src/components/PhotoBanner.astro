---
/**
 * Grande carte sur photo assombrie (voile noir-95 à 62 %) : titre en deux temps
 * et phrase à gauche, contenu libre à droite (formulaire newsletter, boutons).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  id: string;
  titleStrong: string;
  titleLight: string;
  text: string;
  image: ImageMetadata;
  /** Cadrage de la photo (object-position). */
  imagePosition?: string;
  /** Ajoute l'espacement de section au-dessus (quand la section précédente est teintée). */
  spaced?: boolean;
}

const { id, titleStrong, titleLight, text, image, imagePosition = '50% 40%', spaced = false } = Astro.props;
---

<section class:list={['photo-banner', { 'photo-banner--spaced': spaced }]} aria-labelledby={id}>
  <div class="photo-banner__card" data-reveal>
    <Picture
      class="photo-banner__photo"
      src={image}
      alt=""
      style={`object-position: ${imagePosition}`}
      formats={['avif', 'webp']}
      widths={[480, 800, 1300, 1800, 2600]}
      sizes="(max-width: 1440px) 100vw, 1312px"
    />
    <div class="photo-banner__voile" aria-hidden="true"></div>
    <div class="photo-banner__content">
      <div class="photo-banner__text">
        <h2 id={id} class="photo-banner__title">
          <span class="photo-banner__strong">{titleStrong}</span>{' '}
          <span class="photo-banner__light">{titleLight}</span>
        </h2>
        <p>{text}</p>
      </div>
      <slot />
    </div>
  </div>
</section>

<style>
  .photo-banner {
    padding: 0 var(--gutter) var(--space-section);
  }

  .photo-banner--spaced {
    padding-top: var(--space-section);
  }

  .photo-banner__card {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-block);
    color: var(--blanc);
  }

  .photo-banner__card :global(.photo-banner__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-banner__voile {
    position: absolute;
    inset: 0;
    background: var(--voile);
  }

  .photo-banner__content {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: clamp(28px, 6vw, 72px);
  }

  /* Sur la photo assombrie, le contour de focus basalte ne se verrait pas : blanc. */
  .photo-banner__content :global(:focus-visible) {
    outline-color: var(--blanc);
  }

  .photo-banner__text {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--fs-body);
  }

  .photo-banner__title {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .photo-banner__strong {
    font-weight: 800;
  }

  .photo-banner__light {
    font-weight: 300;
  }
</style>
