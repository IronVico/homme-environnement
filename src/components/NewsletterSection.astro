---
import type { ImageMetadata } from 'astro';
import NewsletterForm from './NewsletterForm.astro';
import PhotoBanner from './PhotoBanner.astro';

interface Props {
  titleStrong: string;
  titleLight: string;
  text: string;
  image: ImageMetadata;
}

const { titleStrong, titleLight, text, image } = Astro.props;
---

<PhotoBanner id="newsletter-titre" titleStrong={titleStrong} titleLight={titleLight} text={text} image={image}>
  <div class="newsletter__form">
    <NewsletterForm />
  </div>
</PhotoBanner>

<style>
  .newsletter__form {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 560px;
  }
</style>
