---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  titleStrong: string;
  titleLight: string;
  text: string;
  image: ImageMetadata;
}

const { titleStrong, titleLight, text, image } = Astro.props;
---

<section class="newsletter" aria-labelledby="newsletter-titre">
  <div class="newsletter__card" data-reveal>
    <Picture
      class="newsletter__photo"
      src={image}
      alt=""
      formats={['avif', 'webp']}
      widths={[480, 800, 1300, 1800]}
      sizes="(max-width: 1440px) 100vw, 1312px"
    />
    <div class="newsletter__voile" aria-hidden="true"></div>
    <div class="newsletter__content">
      <div class="newsletter__text">
        <h2 id="newsletter-titre" class="newsletter__title">
          <span class="newsletter__strong">{titleStrong}</span>{' '}
          <span class="newsletter__light">{titleLight}</span>
        </h2>
        <p>{text}</p>
      </div>
      <div class="newsletter__form">
        <NewsletterForm />
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter {
    padding: 0 var(--gutter) var(--space-section);
  }

  .newsletter__card {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-block);
    color: var(--blanc);
  }

  .newsletter__card :global(.newsletter__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .newsletter__voile {
    position: absolute;
    inset: 0;
    background: var(--voile);
  }

  .newsletter__content {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: clamp(28px, 6vw, 72px);
  }

  .newsletter__text {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: var(--fs-body);
  }

  .newsletter__title {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .newsletter__strong {
    font-weight: 800;
  }

  .newsletter__light {
    font-weight: 300;
  }

  .newsletter__form {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 560px;
  }
</style>
