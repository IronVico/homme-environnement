---
/**
 * Questions fréquentes : une carte blanche dépliable par question (<details>, sans JS).
 * Une réponse est une suite de morceaux de texte et de liens (adresse email, page…).
 */
import Plus from '@lucide/astro/icons/plus';

export type FaqAnswer = (string | { label: string; href: string })[];

interface Props {
  items: { question: string; answer: FaqAnswer }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary class="faq__question">
          {item.question}
          <Plus class="faq__icon" size={20} />
        </summary>
        <p class="faq__answer">
          {item.answer.map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.label}</a>))}
        </p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    /* Permet d'animer la hauteur jusqu'à « auto » (navigateurs récents ; ailleurs, ouverture sans animation). */
    interpolate-size: allow-keywords;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq__item {
    padding: 0 22px;
    border: 1px solid var(--bordure-carte);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--transition-ui),
      border-color var(--transition-ui);
  }

  /* Survol : la carte se détache un peu plus, comme les cartes cliquables. */
  .faq__item:hover {
    border-color: var(--trait);
    box-shadow: var(--shadow-card-hover);
  }

  /* Ouverture et fermeture : la réponse se déplie en hauteur et apparaît en fondu. */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 280ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 200ms ease-out,
      content-visibility 280ms allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  .faq__question:hover {
    color: var(--texte-fort);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding-block: 12px;
    list-style: none;
    cursor: pointer;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  /* Focus dessiné sur toute la carte, pas seulement sur la ligne de la question. */
  .faq__question:focus-visible {
    outline: none;
  }

  .faq__item:has(.faq__question:focus-visible) {
    outline: 2px solid var(--texte);
    outline-offset: 2px;
  }

  /* Le + devient × à l'ouverture. */
  .faq :global(.faq__icon) {
    flex-shrink: 0;
    transition: transform var(--transition-ui);
  }

  .faq__item[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }

  /* Espace du bas en padding, pas en marge : une marge sortirait de la zone animée
     et s'ajouterait d'un coup à la fin de l'ouverture. */
  .faq__answer {
    max-width: 820px;
    padding-bottom: 20px;
    font-size: 16px;
    line-height: 1.6;
  }

  .faq__answer a {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item,
    .faq__item::details-content,
    .faq :global(.faq__icon) {
      transition: none;
    }
  }
</style>
