---
/**
 * Galerie de photos qui défile seule, en boucle continue, sur toute la largeur.
 * La piste contient deux fois la série : elle glisse de la largeur d'une série
 * (moitié de la piste, plus la moitié d'un écart) puis repart sans à-coup.
 * Les doublons sont masqués aux lecteurs d'écran (aria-hidden, alt vide).
 * Pas de pause au survol, mais un bouton Pause sous la galerie (WCAG 2.2.2).
 * prefers-reduced-motion : pas d'animation, une seule série, défilement manuel
 * (clavier compris : la zone peut recevoir le focus), pas de bouton Pause.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import PauseButton from './PauseButton.astro';

interface Props {
  label: string;
  photos: { image: ImageMetadata; alt: string; position?: string }[];
  /** Durée d'un tour complet, en secondes. */
  duration?: number;
}

const { label, photos, duration = 45 } = Astro.props;
const loop = [...photos.map((p) => ({ ...p, copy: false })), ...photos.map((p) => ({ ...p, copy: true }))];
---

<div class="marquee" data-motion>
  <div class="marquee__viewport" tabindex="0" role="region" aria-label={label}>
    <ul class="marquee__track" style={`--marquee-duration: ${duration}s`}>
      {
        loop.map((photo) => (
          <li class:list={['marquee__item', { 'marquee__item--copy': photo.copy }]} aria-hidden={photo.copy ? 'true' : undefined}>
            <Picture
              class="marquee__photo"
              src={photo.image}
              alt={photo.copy ? '' : photo.alt}
              style={photo.position ? `object-position: ${photo.position}` : undefined}
              formats={['avif', 'webp']}
              widths={[320, 480, 640]}
              sizes="(max-width: 1000px) 220px, 320px"
              loading="eager"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="marquee__controls container">
    <PauseButton tooltipAlign="end" />
  </div>
</div>

<style>
  .marquee {
    --marquee-gap: 16px;
    padding-bottom: var(--space-section);
  }

  .marquee__viewport {
    overflow: hidden;
  }

  .marquee__viewport:focus-visible {
    outline-offset: -3px;
  }

  .marquee__track {
    display: flex;
    gap: var(--marquee-gap);
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee var(--marquee-duration, 45s) linear infinite;
  }

  .marquee[data-paused] .marquee__track {
    animation-play-state: paused;
  }

  .marquee__controls {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-3);
  }

  .marquee__item {
    flex: 0 0 auto;
    width: clamp(220px, 22vw, 320px);
  }

  .marquee :global(.marquee__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
    background: var(--section);
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-50% - var(--marquee-gap) / 2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport {
      overflow-x: auto;
    }

    .marquee__track {
      animation: none;
      padding-inline: var(--gutter);
    }

    .marquee__item--copy {
      display: none;
    }

    .marquee__controls {
      display: none;
    }
  }
</style>
