---
import ArrowRight from '@lucide/astro/icons/arrow-right';

interface Props {
  /** Titre en deux temps : partie forte (h2, ExtraBold)… */
  strong: string;
  /** …puis partie douce (h2-light, Light), facultative. */
  light?: string;
  eyebrow?: string;
  /** Chapeau, toujours sous le titre (jamais à côté). */
  lead?: string;
  /** Lien d'action aligné à droite du titre (« Toutes nos actions → »). */
  link?: { label: string; href: string };
  id?: string;
}

const { strong, light, eyebrow, lead, link, id } = Astro.props;
---

<div class:list={['section-heading', { 'section-heading--with-link': link }]} data-reveal>
  <div class="section-heading__titles">
    {eyebrow && <p class="section-heading__eyebrow eyebrow">{eyebrow}</p>}
    <h2 class="section-heading__title" id={id}>
      <span class="section-heading__strong">{strong}</span>
      {light && ' '}
      {light && <span class="section-heading__light">{light}</span>}
    </h2>
    {lead && <p class="section-heading__lead">{lead}</p>}
  </div>
  {
    link && (
      <a class="section-heading__link" href={link.href}>
        <span class="section-heading__link-label">{link.label}</span>
        <ArrowRight class="section-heading__link-icon" size={18} />
      </a>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .section-heading__titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-heading__titles:has(.section-heading__lead) {
    max-width: 760px;
  }

  .section-heading__lead {
    max-width: 620px;
    margin-top: 4px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }

  .section-heading--with-link .section-heading__titles {
    max-width: 720px;
  }

  /* Sur-titre basalte : posé aussi bien sur blanc que sur vert-clair. */
  .section-heading__eyebrow {
    color: var(--texte);
  }

  .section-heading__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    letter-spacing: var(--ls-h2);
  }

  .section-heading__strong {
    font-weight: 800;
  }

  .section-heading__light {
    font-weight: 300;
  }

  /*
   * Lien d'action : trait fin sauge au repos sous le libellé ; au survol,
   * un trait basalte se trace de gauche à droite et la flèche glisse.
   */
  .section-heading__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: 4px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--texte);
    text-decoration: none;
  }

  .section-heading__link:hover {
    color: var(--texte);
  }

  .section-heading__link-label {
    padding-bottom: 4px;
    background:
      linear-gradient(var(--texte), var(--texte)) 0 100% / 0% 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) 0 100% / 100% 2px no-repeat;
    transition: background-size 300ms ease-out;
  }

  .section-heading__link:hover .section-heading__link-label,
  .section-heading__link:focus-visible .section-heading__link-label {
    background-size:
      100% 2px,
      100% 2px;
  }

  .section-heading__link :global(.section-heading__link-icon) {
    flex-shrink: 0;
    transition: transform var(--transition-ui);
  }

  .section-heading__link:hover :global(.section-heading__link-icon),
  .section-heading__link:focus-visible :global(.section-heading__link-icon) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .section-heading__link-label {
      transition: none;
    }

    .section-heading__link:hover :global(.section-heading__link-icon),
    .section-heading__link:focus-visible :global(.section-heading__link-icon) {
      transform: none;
    }
  }
</style>
