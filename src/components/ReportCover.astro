---
/**
 * Couverture d'un rapport, au format paysage 7:5 (carte « À la une » de la page Rapports).
 * Avec `image` : la vraie couverture fournie par l'ONG. Sans : couverture provisoire dessinée
 * comme la maquette (photo à gauche, logo, titre, régions, pastille « [couverture à fournir] »).
 * Les tailles suivent la largeur de la couverture (unités cqw) : elle garde ses proportions à
 * toutes les tailles. Couleurs en dur : une couverture imprimée ne change pas avec le thème.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getLang, t } from '../i18n';
import { fill } from '../lib/don';
import Logo from './Logo.astro';

import placeholderPhoto from '../assets/photos/hero-artisane-vohimana.jpg';

interface Props {
  /** Titre du document : « Rapport annuel 2025 ». */
  title: string;
  /** Première ligne (grasse) et seconde ligne (légère) de la couverture provisoire. */
  titleStrong: string;
  titleLight: string;
  image?: ImageMetadata;
  class?: string;
}

const { title, titleStrong, titleLight, image, class: className } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { featured } = t(lang).rapports;
---

{
  image ? (
    <Picture
      class:list={['cover', className]}
      src={image}
      alt={fill(featured.coverAlt, { title })}
      formats={['avif', 'webp']}
      widths={[440, 880]}
      sizes="(max-width: 600px) 90vw, 440px"
    />
  ) : (
    <div class:list={['cover', 'cover--placeholder', className]} role="img" aria-label={fill(featured.coverLabel, { title })}>
      <Picture
        class="cover__photo"
        src={placeholderPhoto}
        alt=""
        formats={['avif', 'webp']}
        widths={[240, 480]}
        sizes="200px"
      />
      <div class="cover__body">
        <Logo class="cover__logo" lang={lang} alt="" />
        <div class="cover__titles">
          <span class="cover__strong">
            <span class="cover__mark" aria-hidden="true" />
            <span class="cover__strong-text">{titleStrong}</span>
          </span>
          <span class="cover__light">{titleLight}</span>
          <span class="cover__regions">{featured.coverRegions}</span>
        </div>
        <span class="cover__todo">{featured.coverTodo}</span>
      </div>
    </div>
  )
}

<style>
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 7 / 5;
    border-radius: 6px;
    background: var(--blanc);
    object-fit: cover;
  }

  .cover--placeholder {
    container-type: inline-size;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    overflow: hidden;
    color: var(--basalte);
  }

  .cover--placeholder :global(.cover__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .cover__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5cqw;
  }

  .cover__body :global(.cover__logo) {
    width: auto;
    height: 8.18cqw;
    margin-left: -1.82cqw;
  }

  /* Nom du logo : basalte du fichier, même en mode sombre (papier blanc). */
  .cover__body :global(.logo__nom) {
    fill: #444941;
  }

  .cover__titles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.82cqw;
  }

  .cover__strong {
    position: relative;
    white-space: nowrap;
    font-size: 5.23cqw;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* Surlignage pêche de la maquette de couverture (élément imprimé, pas un bouton). */
  .cover__mark {
    position: absolute;
    left: -1.14cqw;
    right: -1.14cqw;
    top: 52%;
    height: 38%;
    background: var(--peche);
  }

  .cover__strong-text {
    position: relative;
  }

  .cover__light {
    font-size: 5.91cqw;
    line-height: 1;
    font-weight: 300;
  }

  .cover__regions {
    font-size: 1.7cqw;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .cover__todo {
    align-self: flex-start;
    padding: 0.68cqw 1.82cqw;
    border-radius: var(--radius-pill);
    background: var(--vert-clair);
    font-size: 1.93cqw;
    font-weight: 600;
  }
</style>
