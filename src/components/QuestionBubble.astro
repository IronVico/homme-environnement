---
/**
 * Bulle « Une question ? » en bas à droite de toutes les pages (BaseLayout) : un petit échange
 * façon messagerie pour envoyer une question ; l'ONG répond plus tard, par e-mail.
 * - Sans JS : la bulle est un simple lien vers le formulaire de la page Contact.
 * - Avec JS : le lien devient un bouton qui ouvre un <dialog> modal (focus piégé par le navigateur,
 *   Échap ferme, focus rendu à la bulle). Le panneau est cloné depuis un <template> à la première
 *   ouverture. Panneau ancré au-dessus de la bulle sur ordinateur, plein écran sous 700px.
 * Envoi : le même que la page Contact (CONTACT_ENDPOINT, règles de src/lib/contact.ts, champ piège),
 * sujet QUESTION_SUBJECT, sans nom. Membre de l'équipe qui signe : src/data/question.ts.
 */
import MessageCircle from '@lucide/astro/icons/message-circle';
import Send from '@lucide/astro/icons/send';
import X from '@lucide/astro/icons/x';
import { CONTACT_EMAIL, pagePath } from '../data/navigation';
import { QUESTION_HOST } from '../data/question';
import { getLang, t } from '../i18n';
import { fill } from '../lib/don';
import { CONTACT_ENDPOINT, CONTACT_FORM_ANCHOR, CONTACT_MAX, CONTACT_TRAP, QUESTION_SUBJECT } from '../lib/contact';
import Portrait from './Portrait.astro';

const lang = getLang(Astro.currentLocale);
const q = t(lang).question;
const host = QUESTION_HOST;
const tooLong = (max: number) => fill(q.errors.tooLong, { max: String(max) });
---

<div class="question" data-question>
  <a
    class="question__bubble btn-motion"
    href={`${pagePath(lang, 'contact')}#${CONTACT_FORM_ANCHOR}`}
    aria-label={q.open}
    data-tooltip={q.open}
    data-tooltip-align="end"
    data-question-toggle
  >
    <MessageCircle size={26} aria-hidden="true" />
  </a>

  <template data-question-template>
    <dialog class="question__panel" id="question-panneau" aria-labelledby="question-titre" aria-modal="true">
      <div class="question__head">
        <Portrait
          name={host.name}
          photo={host.photo}
          position={host.photoPosition}
          class="question__avatar"
          widths={[48, 96]}
          sizes="48px"
        />
        <div class="question__host">
          <h2 class="visually-hidden" id="question-titre">{q.title}</h2>
          <p class="question__name">{host.firstName}</p>
          <p class="question__role">{host.role[lang]}</p>
        </div>
        <button
          class="question__close"
          type="button"
          aria-label={q.close}
          data-tooltip={q.close}
          data-tooltip-align="end"
          data-tooltip-pos="below"
          data-question-close
        >
          <X size={24} aria-hidden="true" />
        </button>
      </div>

      <div class="question__body" data-question-body>
        <div class="question__thread">
          <p class="question__msg question__msg--host">
            <span class="visually-hidden">{host.firstName} {q.hostSays} </span>{q.greeting}
          </p>
          <div class="question__status" role="status" data-question-status></div>
        </div>

        <form
          class="question__form"
          action={CONTACT_ENDPOINT}
          method="post"
          aria-labelledby="question-titre"
          data-question-form
          data-sending={q.sending}
          data-received={q.received}
          data-failed={q.failed}
          data-failed-link={q.failedLink}
          data-mail-subject={q.mailSubject}
          data-you-say={q.youSay}
          data-host-says={`${host.firstName} ${q.hostSays} `}
          data-email={CONTACT_EMAIL}
        >
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="sujet" value={QUESTION_SUBJECT} />
          <p class="question__required">{q.required}</p>

          <div class="question__field">
            <label class="question__label" for="question-message">{q.message} <span aria-hidden="true">*</span></label>
            <textarea
              class="question__input question__textarea"
              id="question-message"
              name="message"
              rows="4"
              maxlength={CONTACT_MAX.message}
              required
              aria-describedby="question-message-erreur"
              data-field
              data-error-required={q.errors.message}
              data-error-too-long={tooLong(CONTACT_MAX.message)}></textarea>
            <p class="question__error" id="question-message-erreur" aria-live="polite"></p>
          </div>

          <div class="question__field">
            <label class="question__label" for="question-email">{q.email} <span aria-hidden="true">*</span></label>
            <input
              class="question__input"
              id="question-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength={CONTACT_MAX.email}
              placeholder={q.emailPlaceholder}
              required
              aria-describedby="question-email-aide question-email-erreur"
              data-field
              data-error-required={q.errors.email}
              data-error-email={q.errors.emailInvalid}
              data-error-too-long={tooLong(CONTACT_MAX.email)}
            />
            <p class="question__help" id="question-email-aide">{q.emailHelp}</p>
            <p class="question__error" id="question-email-erreur" aria-live="polite"></p>
          </div>

          <!-- Champ piège (comme la page Contact) : hors écran, sauté au clavier ; rempli, le message est ignoré. -->
          <div class="question__trap" aria-hidden="true">
            <label for="question-piege">{q.trap}</label>
            <input id="question-piege" name={CONTACT_TRAP} type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="question__field">
            <div class="question__consent">
              <input
                class="question__checkbox"
                id="question-consentement"
                name="consentement"
                type="checkbox"
                required
                aria-describedby="question-consentement-erreur"
                data-field
                data-error-required={q.errors.consentement}
              />
              <label for="question-consentement">{q.consent} <span aria-hidden="true">*</span></label>
            </div>
            <p class="question__privacy"><a href={pagePath(lang, 'confidentialite')}>{q.privacyLink}</a></p>
            <p class="question__error" id="question-consentement-erreur" aria-live="polite"></p>
          </div>

          <button class="question__submit btn-motion" type="submit">
            {q.submit}
            <Send size={20} aria-hidden="true" />
          </button>
        </form>
      </div>
    </dialog>
  </template>
</div>

<script>
  import { readContactValues, validateContactField, type ContactError, type ContactField } from '../lib/contact';

  type Control = HTMLInputElement | HTMLTextAreaElement;

  const ERROR_ATTRIBUTE: Record<ContactError, string> = {
    required: 'errorRequired',
    email: 'errorEmail',
    tooLong: 'errorTooLong',
  };

  const root = document.querySelector<HTMLElement>('[data-question]');
  const link = root?.querySelector<HTMLAnchorElement>('[data-question-toggle]');
  const template = root?.querySelector<HTMLTemplateElement>('[data-question-template]');

  if (root && link && template) {
    // Le lien vers la page Contact devient un bouton (mêmes classes, libellé et infobulle).
    const bubble = document.createElement('button');
    for (const { name, value } of link.attributes) if (name !== 'href') bubble.setAttribute(name, value);
    bubble.type = 'button';
    bubble.setAttribute('aria-haspopup', 'dialog');
    bubble.setAttribute('aria-expanded', 'false');
    bubble.setAttribute('aria-controls', 'question-panneau');
    bubble.append(...link.childNodes);
    link.replaceWith(bubble);

    let dialog: HTMLDialogElement | null = null;

    const message = (className: string, srLabel: string, text: string) => {
      const paragraph = document.createElement('p');
      paragraph.className = `question__msg ${className}`;
      const label = document.createElement('span');
      label.className = 'visually-hidden';
      label.textContent = srLabel;
      paragraph.append(label, text);
      // Classes scopées d'Astro : reprises du premier message.
      const scope = dialog?.querySelector('.question__msg')?.getAttributeNames().find((n) => n.startsWith('data-astro-cid'));
      if (scope) {
        paragraph.setAttribute(scope, '');
        label.setAttribute(scope, '');
      }
      return paragraph;
    };

    const setup = (panel: HTMLDialogElement) => {
      const form = panel.querySelector<HTMLFormElement>('[data-question-form]')!;
      const status = panel.querySelector<HTMLElement>('[data-question-status]')!;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const textarea = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!;
      const controls = [...form.querySelectorAll<Control>('[data-field]')];
      let sending = false;
      form.noValidate = true;

      panel.querySelector('[data-question-close]')!.addEventListener('click', () => panel.close());
      // Clic hors du panneau (sur le fond) : fermeture.
      panel.addEventListener('click', (event) => {
        if (event.target !== panel) return;
        const box = panel.getBoundingClientRect();
        const inside =
          event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom;
        if (!inside) panel.close();
      });
      panel.addEventListener('close', () => {
        document.documentElement.classList.remove('question-open');
        bubble.setAttribute('aria-expanded', 'false');
        bubble.focus();
      });

      const showError = (control: Control, error: ContactError | null) => {
        const text = error ? (control.dataset[ERROR_ATTRIBUTE[error]] ?? control.dataset.errorRequired ?? '') : '';
        const output = document.getElementById(`${control.id}-erreur`);
        if (output && output.textContent !== text) output.textContent = text;
        if (error) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      };

      const check = (control: Control) => {
        const error = validateContactField(control.name as ContactField, readContactValues(new FormData(form)));
        showError(control, error);
        return error;
      };

      controls.forEach((control) => {
        // Affiché en quittant le champ ; retiré dès que la saisie redevient valide.
        control.addEventListener('blur', () => {
          if (control.type === 'checkbox' && !control.hasAttribute('aria-invalid')) return;
          check(control);
        });
        const recheck = () => {
          if (control.hasAttribute('aria-invalid')) check(control);
        };
        control.addEventListener('input', recheck);
        control.addEventListener('change', recheck);
      });

      const scrollToStatus = () => status.scrollIntoView({ block: 'nearest' });

      // Échec d'envoi : lien mailto prérempli avec la question.
      const showFailure = () => {
        const mailto = document.createElement('a');
        mailto.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(form.dataset.mailSubject ?? '')}&body=${encodeURIComponent(textarea.value.trim())}`;
        mailto.textContent = form.dataset.failedLink ?? '';
        const notice = document.createElement('p');
        notice.append(form.dataset.failed ?? '', mailto, '.');
        status.replaceChildren(notice);
        scrollToStatus();
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (sending) return;

        const invalid = controls.filter((control) => check(control) !== null);
        if (invalid.length > 0) {
          invalid[0]!.focus();
          return;
        }

        // Réponse automatique précédente : reste dans le fil, au-dessus de la zone de statut.
        status.querySelectorAll('.question__msg').forEach((reply) => status.before(reply));
        const question = textarea.value.trim();
        sending = true;
        submit.setAttribute('aria-disabled', 'true');
        status.textContent = form.dataset.sending ?? '';
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const result = (await response.json().catch(() => ({}))) as {
            ok?: boolean;
            errors?: Partial<Record<ContactField, ContactError>>;
          };
          if (response.ok && result.ok) {
            status.before(message('question__msg--you', `${form.dataset.youSay ?? ''} `, question));
            status.replaceChildren(message('question__msg--host', form.dataset.hostSays ?? '', form.dataset.received ?? ''));
            textarea.value = '';
            scrollToStatus();
          } else if (result.errors && Object.keys(result.errors).length > 0) {
            // Refusé par l'envoi (rare : mêmes règles que le script).
            status.textContent = '';
            const refused = controls.filter((control) => result.errors?.[control.name as ContactField]);
            refused.forEach((control) => showError(control, result.errors![control.name as ContactField]!));
            if (refused.length > 0) refused[0]!.focus();
            else showFailure();
          } else {
            showFailure();
          }
        } catch {
          showFailure();
        } finally {
          sending = false;
          submit.removeAttribute('aria-disabled');
        }
      });
    };

    bubble.addEventListener('click', () => {
      if (!dialog) {
        root.append(template.content.cloneNode(true));
        dialog = root.querySelector<HTMLDialogElement>('dialog')!;
        setup(dialog);
      }
      if (dialog.open) return;
      dialog.showModal();
      document.documentElement.classList.add('question-open');
      bubble.setAttribute('aria-expanded', 'true');
      dialog.querySelector<HTMLTextAreaElement>('textarea')!.focus();
    });
  }
</script>

<style>
  /* Bulle : 56px, en bas à droite, sous le loader de la page (z-index 100) et au-dessus du header. */
  .question__bubble {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--bouton-plein);
    color: var(--texte-sur-bouton);
    box-shadow: var(--shadow-card);
    cursor: pointer;
  }

  .question__bubble:hover {
    background: var(--texte-fort);
    color: var(--texte-sur-bouton);
  }

  .question__bubble:focus-visible {
    outline-offset: 3px;
  }

  /* Panneau : ~380 × 560px, ancré au-dessus de la bulle (bulle 56px + 16px + écart 12px). */
  .question__panel {
    position: fixed;
    inset: auto max(16px, env(safe-area-inset-right)) calc(max(16px, env(safe-area-inset-bottom)) + 68px) auto;
    display: none;
    flex-direction: column;
    width: min(380px, calc(100vw - 32px));
    height: min(560px, calc(100dvh - 100px));
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--bordure-carte);
    border-radius: var(--radius-card-lg);
    background: var(--surface);
    color: var(--texte);
    box-shadow: var(--shadow-card-hover);
  }

  .question__panel[open] {
    display: flex;
  }

  .question__panel::backdrop {
    background: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .question__panel[open] {
      animation: question-in 200ms ease-out;
    }
  }

  @keyframes question-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  /* Mobile : modale plein écran, page figée derrière. */
  @media (max-width: 699px) {
    .question__panel {
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    :global(html.question-open) {
      overflow: hidden;
    }
  }

  .question__head {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
    padding-top: max(var(--space-3), env(safe-area-inset-top));
    border-bottom: 1px solid var(--trait);
  }

  .question__head :global(.question__avatar) {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
  }

  .question__host {
    flex: 1;
    min-width: 0;
  }

  .question__name {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.3;
  }

  .question__role {
    font-size: 14px;
    line-height: 1.4;
    color: var(--texte-doux);
  }

  .question__close {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--texte);
    cursor: pointer;
    transition: background-color var(--transition-ui);
  }

  .question__close:hover {
    background: var(--section);
  }

  .question__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-5);
    padding-bottom: max(var(--space-5), env(safe-area-inset-bottom));
  }

  .question__thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .question__msg {
    max-width: 85%;
    padding: var(--space-3) 16px;
    border-radius: 18px;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  .question__msg--host {
    align-self: flex-start;
    border-bottom-left-radius: 6px;
    background: var(--section);
    color: var(--texte);
  }

  .question__msg--you {
    align-self: flex-end;
    border-bottom-right-radius: 6px;
    background: var(--bouton-plein);
    color: var(--texte-sur-bouton);
  }

  .question__status {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }

  .question__status:empty {
    display: none;
  }

  .question__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .question__required,
  .question__help {
    font-size: 14px;
    line-height: 1.5;
    color: var(--texte-doux);
  }

  .question__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .question__label {
    font-size: var(--fs-body-sm);
    font-weight: 600;
  }

  /* Contour à 3:1 minimum (WCAG 1.4.11), comme les champs de la page Contact. */
  .question__input {
    display: block;
    width: 100%;
    box-sizing: border-box;
    min-height: 48px;
    margin: 0;
    padding: 12px 16px;
    border: 1.5px solid var(--texte-doux);
    border-radius: 14px;
    background: var(--surface);
    color: var(--texte);
    font: inherit;
    font-size: 16px;
    line-height: 1.4;
    transition: border-color var(--transition-ui);
  }

  .question__input::placeholder {
    color: var(--texte-doux);
    opacity: 1;
  }

  .question__input:hover,
  .question__input:focus,
  .question__input[aria-invalid='true'] {
    border-color: var(--texte);
  }

  .question__input[aria-invalid='true'] {
    border-width: 2px;
  }

  .question__textarea {
    min-height: 112px;
    line-height: 1.5;
    resize: vertical;
  }

  .question__error {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .question__error:empty {
    display: none;
  }

  .question__consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 14px;
    line-height: 1.5;
  }

  .question__checkbox {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin: 0;
    accent-color: var(--bouton-plein);
    cursor: pointer;
  }

  .question__consent label {
    cursor: pointer;
  }

  .question__privacy {
    padding-left: 36px;
    font-size: 14px;
    font-weight: 500;
  }

  .question__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .question__submit {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--bouton-plein);
    color: var(--texte-sur-bouton);
    font: inherit;
    font-size: var(--fs-button);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }

  .question__submit:hover {
    background: var(--texte-fort);
  }

  .question__submit[aria-disabled='true'] {
    cursor: progress;
  }

  @media (prefers-reduced-motion: reduce) {
    .question__input,
    .question__close {
      transition: none;
    }
  }
</style>
