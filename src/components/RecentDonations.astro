---
/**
 * Bandeau « derniers dons » au-dessus du formulaire de don : une carte à la fois,
 * qui tourne toutes les 4 s. N'affiche rien si la liste est vide.
 * Ne recevoir que de vrais dons (prénom et ville avec l'accord du donateur).
 * Avec prefers-reduced-motion : pas de rotation, seul le premier don s'affiche.
 */
import Heart from '@lucide/astro/icons/heart';
import type { RecentDonation } from '../data/don';
import { getLang, t } from '../i18n';

interface Props {
  donations: RecentDonation[];
}

const { donations } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { recent } = t(lang).don;
const euros = new Intl.NumberFormat(lang, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

// Le texte est découpé autour des valeurs, mises en gras.
const parts = (donation: RecentDonation) =>
  recent.text.split(/(\{amount\}|\{name\}|\{city\})/).map((part) => {
    if (part === '{amount}') return { strong: euros.format(donation.amount) };
    if (part === '{name}') return { strong: donation.firstName };
    if (part === '{city}') return { text: donation.city };
    return { text: part };
  });
---

{
  donations.length > 0 && (
    <section class:list={['recent', { 'recent--single': donations.length === 1 }]} aria-label={recent.label} data-recent>
      <span class="recent__stack" aria-hidden="true" />
      {donations.map((donation, i) => (
        <p class:list={['recent__item', { 'is-active': i === 0, 'is-next': i === 1 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <span class="recent__icon">
            <Heart size={22} />
          </span>
          <span class="recent__text">
            {parts(donation).map((part) => ('strong' in part ? <strong>{part.strong}</strong> : part.text))}
          </span>
        </p>
      ))}
    </section>
  )
}

<script>
  const ROTATE_MS = 4500;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Pile de cartes : la carte du dessus s'envole (is-leaving), celle de derrière
  // avance (is-active) et la suivante prend sa place au fond (is-next).
  document.querySelectorAll<HTMLElement>('[data-recent]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.recent__item'));
    if (items.length < 2) return;
    let current = 0;
    let paused = false;
    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = false));

    window.setInterval(() => {
      if (paused || reduceMotion.matches || document.hidden) return;
      const leaving = items[current]!;
      current = (current + 1) % items.length;
      const next = items[(current + 1) % items.length]!;

      // La carte partie au tour précédent revient au fond sans traverser la pile :
      // on la replace d'un coup (sans transition), puis elle avance depuis l'arrière.
      items.forEach((item) => {
        if (item === leaving || !item.classList.contains('is-leaving')) return;
        item.style.transition = 'none';
        item.classList.remove('is-leaving');
        void item.offsetWidth;
        item.style.transition = '';
      });

      items.forEach((item, i) => {
        item.classList.toggle('is-leaving', item === leaving);
        item.classList.toggle('is-active', i === current);
        item.classList.toggle('is-next', item === next && item !== leaving);
        if (i === current) item.removeAttribute('aria-hidden');
        else item.setAttribute('aria-hidden', 'true');
      });
    }, ROTATE_MS);
  });
</script>

<style>
  .recent {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    height: 92px;
  }

  /* Carte fantôme derrière la carte du dessus quand il n'y a qu'un don. */
  .recent__stack {
    position: absolute;
    inset: 18px 16px auto;
    height: 72px;
    border: 1px solid var(--bordure-carte);
    border-radius: 18px;
    background: var(--surface);
    opacity: 0.7;
  }

  .recent:not(.recent--single) .recent__stack {
    display: none;
  }

  .recent__item {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 74px;
    padding: 14px 18px;
    border: 1px solid var(--bordure-carte);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    font-size: var(--fs-body-sm);
    line-height: 1.4;
    transform-origin: 50% 100%;
    /* Par défaut : rangée au fond de la pile, invisible. */
    opacity: 0;
    transform: translateY(18px) scale(0.9);
    transition:
      transform 700ms var(--ease-out),
      opacity 500ms ease-out,
      box-shadow 700ms var(--ease-out);
  }

  /* Contenu des cartes de derrière masqué : seul le bord de la carte dépasse. */
  .recent__item > * {
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .recent__item.is-active {
    z-index: 2;
    opacity: 1;
    transform: none;
  }

  .recent__item.is-active > * {
    opacity: 1;
    transition-delay: 150ms;
  }

  /* Carte suivante : derrière, plus petite, comme la carte fantôme. */
  .recent__item.is-next {
    z-index: 1;
    opacity: 0.7;
    transform: translateY(18px) scale(0.92);
    box-shadow: none;
  }

  /* Carte qui part : elle monte et s'efface, au-dessus des autres. */
  .recent__item.is-leaving {
    z-index: 3;
    opacity: 0;
    transform: translateY(-22px) scale(1.02);
    transition:
      transform 600ms var(--ease-out),
      opacity 350ms ease-in;
  }

  .recent__item.is-leaving > * {
    opacity: 1;
  }

  .recent__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: var(--section);
    color: var(--don);
  }

  .recent__icon :global(svg) {
    fill: currentColor;
  }

  /* Le cœur bat une fois quand la carte arrive devant. */
  @keyframes recent-beat {
    0%,
    100% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.25);
    }
    55% {
      transform: scale(0.95);
    }
  }

  .recent__item.is-active .recent__icon :global(svg) {
    animation: recent-beat 700ms ease-out 350ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .recent__item,
    .recent__item > * {
      transition: none;
    }

    .recent__item.is-active .recent__icon :global(svg) {
      animation: none;
    }
  }
</style>
