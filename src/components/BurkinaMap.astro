---
/**
 * Carte du Burkina Faso (maquette PaysBurkina), sur le modèle de MadagascarMap :
 * pays en sauge avec courbes de niveau et lavis aquarelle, rose des vents, capitale
 * et pays voisins. Les repères des sites sont posés par-dessus par le composant
 * parent (slot), en % de la carte.
 * Le lavis est précalculé en masques (composant Aquarelle, src/lib/aquarelle.ts).
 * Couleurs en variables CSS (tokens de rôle) : la carte suit le mode clair / sombre.
 */
import { CAPITAL, COUNTRY_CENTER, COUNTRY_PATH, COUNTRY_VIEWBOX, NEIGHBOUR_POSITIONS } from '../lib/burkina';
import { uid } from '../lib/uid';
import Aquarelle from './Aquarelle.astro';

interface Props {
  labels: { capital: string; north: string; neighbours: string[] };
}

const { labels } = Astro.props;

const clipId = `${uid('bf')}-pays`;

const { x: cx, y: cy } = COUNTRY_CENTER;
/** Transformation centrée sur le pays : échelle (x, y) et rotation en degrés. */
const around = (sx: number, sy = sx, rotate = 0) =>
  `translate(${cx} ${cy}) rotate(${rotate}) scale(${sx} ${sy}) translate(${-cx} ${-cy})`;

const halos = [
  { scale: 1.035, width: 2, opacity: 0.9 },
  { scale: 1.075, width: 1.5, opacity: 0.6 },
  { scale: 1.12, width: 1, opacity: 0.35 },
];
const contours = [
  { scale: 0.82, opacity: 0.55, dash: 'none' },
  { scale: 0.62, opacity: 0.45, dash: 'none' },
  { scale: 0.42, opacity: 0.4, dash: '3 5' },
  { scale: 0.22, opacity: 0.35, dash: '3 5' },
];
---

<div class="bf-map">
  <Aquarelle map="burkina" />
  <svg class="bf-map__svg" viewBox={COUNTRY_VIEWBOX} aria-hidden="true" focusable="false">
    <defs>
      <clipPath id={clipId}><path d={COUNTRY_PATH}></path></clipPath>
    </defs>
    {
      halos.map((halo) => (
        <g transform={around(halo.scale)}>
          <path d={COUNTRY_PATH} fill="none" style="stroke: var(--fond)" stroke-width={halo.width} stroke-opacity={halo.opacity} />
        </g>
      ))
    }
    <g transform="translate(7 9)" style="fill: var(--texte)" fill-opacity="0.16"><path d={COUNTRY_PATH} /></g>
    <path d={COUNTRY_PATH} style="fill: var(--accent)" />
    <g clip-path={`url(#${clipId})`}>
      <g transform={around(0.5)}><path d={COUNTRY_PATH} style="fill: var(--section)" fill-opacity="0.22" /></g>
      {
        contours.map((contour) => (
          <g transform={around(contour.scale)}>
            <path
              d={COUNTRY_PATH}
              fill="none"
              style="stroke: var(--section)"
              stroke-width="1.4"
              stroke-opacity={contour.opacity}
              stroke-dasharray={contour.dash}
            />
          </g>
        ))
      }
    </g>
    <g transform="translate(600 56)">
      <circle r="22" style="fill: var(--surface)" fill-opacity="0.7"></circle>
      <path d="M0 -14 L7 8 L0 3 L-7 8 Z" style="fill: var(--texte)"></path>
      <text y="-28" text-anchor="middle" font-size="12" font-weight="700" style="fill: var(--texte)">{labels.north}</text>
    </g>
    <circle cx={CAPITAL.x} cy={CAPITAL.y} r="4" style="fill: var(--carte-capitale)"></circle>
    {/* Nom à gauche du point : le repère de Kollo et Guiaro est juste en dessous.
        noir-95 en dur : le nom est sur le pays en sauge (--accent), identique dans les deux modes. */}
    <text x={CAPITAL.x - 10} y={CAPITAL.y + 4.5} text-anchor="end" font-size="13" font-weight="500" style="fill: var(--noir-95)">
      {labels.capital}
    </text>
    {
      labels.neighbours.map((name, i) => {
        const position = NEIGHBOUR_POSITIONS[i];
        return (
          position && (
            <text x={position.x} y={position.y} text-anchor="middle" font-size="14" font-style="italic" style="fill: var(--texte)">
              {name}
            </text>
          )
        );
      })
    }
  </svg>
  <slot />
</div>

<style>
  .bf-map {
    position: relative;
    width: min(100%, 640px);
    aspect-ratio: 640 / 440;
  }

  .bf-map__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
    font-family: var(--font-sans);
  }
</style>
