---
/**
 * Page « L'ONG » (maquettes LONG / LONGMobile), commune aux deux langues (/ong et /en/ong).
 * Textes dans src/i18n (clé `ong`), chiffres et dates dans src/data/chiffres.ts (ONG),
 * partenaires de recherche et sites présentés dans src/data/ong.ts.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ExternalLink from '@lucide/astro/icons/external-link';
import FlaskConical from '@lucide/astro/icons/flask-conical';
import Globe from '@lucide/astro/icons/globe';
import Handshake from '@lucide/astro/icons/handshake';
import MapPin from '@lucide/astro/icons/map-pin';
import PawPrint from '@lucide/astro/icons/paw-print';
import Shield from '@lucide/astro/icons/shield';
import Trees from '@lucide/astro/icons/trees';
import Users from '@lucide/astro/icons/users';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ONG } from '../data/chiffres';
import { donatePath, fieldPath, ONG_ANCHORS, pagePath, sitePath } from '../data/navigation';
import { RESEARCH_PARTNERS, SECTOR_SITES } from '../data/ong';
import { getLang, localeUrl, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fill } from '../lib/don';
import { ISLAND_PATH, ISLAND_VIEWBOX, islandPoint } from '../lib/madagascar';
import Breadcrumb from './Breadcrumb.astro';
import Button from './Button.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PageHero from './PageHero.astro';
import PhotoBanner from './PhotoBanner.astro';
import SectionHeading from './SectionHeading.astro';
import StatsBand from './StatsBand.astro';

import heroPhoto from '../assets/photos/equipe-ylang-mont-passot.jpg';
import ylangPhoto from '../assets/photos/don/impact-ylang-ylang.jpg';
import ctaPhoto from '../assets/photos/ong/appel-paysage.jpg';
import cascadePhoto from '../assets/photos/ong/cascade-vohimana.jpg';
import saroPhoto from '../assets/photos/ong/saro-ambalakalanoro.jpg';

const lang = getLang(Astro.currentLocale);
const dict = t(lang);
const page = dict.ong;

// Nombres dans le texte : « 5 000 » (espace insécable) en français, « 5,000 » en anglais.
const numberLocale = lang === 'en' ? 'en-GB' : 'fr-FR';
const num = (value: number) => value.toLocaleString(numberLocale).replace(/\s/g, ' ');

// Sites de la section « Une filière par site », dans l'ordre de SECTOR_SITES.
const allSites = await getCollection('sites');
const sectorSites = SECTOR_SITES.map((id) => {
  const site = allSites.find((entry) => entry.id === id);
  if (!site) throw new Error(`Site « ${id} » absent de src/content/sites (SECTOR_SITES).`);
  return site;
});

// Photos des cartes quand elles diffèrent de la photo du site (maquette) ; la cascade
// de Vohimana, prévue aussi sur sa carte, n'apparaît qu'une fois, dans « Notre histoire ».
const cardPhotos: Record<string, { image: ImageMetadata; position?: string }> = {
  'mont-passot': { image: ylangPhoto, position: '50% 45%' },
  ambalakalanoro: { image: saroPhoto, position: '50% 30%' },
};

const sectorCards = sectorSites.map((site) => {
  const photo = cardPhotos[site.id] ?? { image: site.data.photo, position: site.data.photoPosition };
  return {
    id: site.id,
    name: page.sectors.names[site.id] ?? site.data.name,
    filiere: page.sectors.filieres[site.id] ?? '',
    href: sitePath(lang, site.id),
    ...photo,
  };
});

const mapDots = sectorSites.map((site) => islandPoint(site.data.mapPosition));

const stats = [
  { value: ONG.threatenedSpecies, suffix: '+', Icon: PawPrint, text: fill(page.stats[0]!, { critical: num(ONG.criticallyEndangered) }) },
  { value: ONG.farmers, Icon: Users, text: page.stats[1]! },
  { value: ONG.treesPlanted, Icon: Trees, text: page.stats[2]! },
  { value: sectorSites.length, Icon: MapPin, text: page.stats[3]! },
  { value: ONG.manNatureProjects, suffix: '+', Icon: Globe, text: fill(page.stats[4]!, { countries: num(ONG.manNatureCountries) }) },
  // Une année : affichée telle quelle, sans compteur ni séparateur de milliers.
  { value: String(ONG.dates.vohimanaProtected), Icon: Shield, text: page.stats[5]! },
];

const approachIcons = [Shield, Handshake, FlaskConical];
const approachCards = page.approach.cards.map((card, i) => ({
  ...card,
  text: fill(card.text, { species: num(ONG.threatenedSpecies) }),
  Icon: approachIcons[i]!,
}));

const { dates } = ONG;
const eventDates = [
  String(dates.firstFight),
  String(ONG.founded),
  `${dates.manNature.from} – ${dates.manNature.to}`,
  String(dates.aromaForest),
  String(dates.vohimanaProtected),
];
const events = page.history.events.map((event, i) => ({
  ...event,
  date: eventDates[i]!,
  text: fill(event.text, {
    projects: num(ONG.manNatureProjects),
    countries: num(ONG.manNatureCountries),
    farmers: num(ONG.aromaForestFarmers),
  }),
}));

const founded = String(ONG.founded);
const breadcrumb = [{ label: dict.ui.breadcrumbHome, href: localeUrl(lang) }];
---

<BaseLayout
  title={page.title}
  description={fill(page.description, { founded })}
  ogImage={heroPhoto}
  ogImageAlt={page.hero.imageAlt}
>
  <Header current="ong" />
  <Breadcrumb items={breadcrumb} current={page.title} />

  <main id="contenu">
    <PageHero
      titleStrong={page.hero.titleStrong}
      titleLight={page.hero.titleLight}
      lead={fill(page.hero.lead, { founded })}
      image={heroPhoto}
      imageAlt={page.hero.imageAlt}
      imagePosition="50% 35%"
      caption={page.hero.caption}
      primary={{ label: page.hero.history, href: `#${ONG_ANCHORS.history}`, arrow: 'down' }}
      cta={{ label: page.hero.team, href: pagePath(lang, 'equipe') }}
    />

    <StatsBand stats={stats} label={page.statsLabel} />

    <section id={ONG_ANCHORS.approach} class="section" aria-labelledby="approche-titre">
      <div class="container stack stack--40">
        <SectionHeading
          id="approche-titre"
          strong={page.approach.titleStrong}
          light={page.approach.titleLight}
          lead={page.approach.lead}
        />
        <div class="approach">
          {
            approachCards.map(({ Icon, title, text }) => (
              <div class="card approach-card" data-reveal>
                <span class="icon-disc">
                  <Icon size={22} />
                </span>
                <h3 class="approach-card__title">{title}</h3>
                <p class="approach-card__text">{text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--tinted" aria-labelledby="filieres-titre">
      <div class="container stack stack--40">
        <SectionHeading
          id="filieres-titre"
          strong={page.sectors.titleStrong}
          light={page.sectors.titleLight}
          lead={fill(page.sectors.lead, { count: num(sectorCards.length) })}
        />
        <ul class="sectors">
          {
            sectorCards.map((card) => (
              <li data-reveal>
                <a class="card card-lift sector-card" href={card.href}>
                  <Picture
                    class="sector-card__photo"
                    src={card.image}
                    alt=""
                    style={`object-position: ${card.position ?? '50% 50%'}`}
                    formats={['avif', 'webp']}
                    widths={[400, 640, 860]}
                    sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 420px"
                  />
                  <span class="sector-card__body">
                    <span class="sector-card__name">{card.name}</span>
                    <span class="sector-card__filiere">{card.filiere}</span>
                    <span class="sector-card__more">
                      {page.sectors.siteLink}
                      <ArrowRight class="sector-card__arrow" size={18} />
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
          <li data-reveal>
            <a class="card-lift map-card" href={pagePath(lang, 'madagascar')}>
              <svg class="map-card__map" viewBox={ISLAND_VIEWBOX} aria-hidden="true" focusable="false">
                <path class="map-card__island" d={ISLAND_PATH} />
                {mapDots.map((dot) => <circle class="map-card__dot" cx={dot.cx.toFixed(1)} cy={dot.cy.toFixed(1)} r="11" />)}
              </svg>
              <span class="map-card__text">
                <span class="map-card__title">{page.sectors.map.title}</span>
                <span class="map-card__lead">{page.sectors.map.text}</span>
              </span>
              <span class="map-card__more">
                {page.sectors.map.link}
                <ArrowRight class="sector-card__arrow" size={18} />
              </span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section id={ONG_ANCHORS.history} class="section" aria-labelledby="histoire-titre">
      <div class="container two-cols">
        <div class="stack stack--32">
          <SectionHeading id="histoire-titre" strong={page.history.titleStrong} light={page.history.titleLight} />
          <ol class="timeline">
            {
              events.map((event) => (
                <li class="timeline__item" data-reveal data-reveal-stagger="500">
                  <span class="timeline__dot" aria-hidden="true" />
                  <span class="timeline__date">{event.date}</span>
                  <h3 class="timeline__title">{event.title}</h3>
                  <p class="timeline__text">{event.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <figure class="history-figure" data-reveal>
          <Picture
            class="history-figure__photo"
            src={cascadePhoto}
            alt={page.history.imageAlt}
            formats={['avif', 'webp']}
            widths={[400, 680]}
            sizes="(max-width: 900px) 100vw, 624px"
          />
          <figcaption class="history-figure__caption">
            <blockquote class="history-figure__quote">« {page.history.quote} »</blockquote>
            <span class="history-figure__author">{page.history.quoteAuthor}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section section--tinted" aria-labelledby="modeles-titre">
      <div class="container two-cols">
        <div class="stack stack--20">
          <SectionHeading id="modeles-titre" strong={page.models.titleStrong} light={page.models.titleLight} />
          {page.models.paragraphs.map((paragraph) => <p class="models__text" data-reveal>{paragraph}</p>)}
        </div>
        <div class="stack stack--16" data-reveal>
          <h3 class="partners__title">{page.models.partners}</h3>
          <ul class="partners">
            {
              RESEARCH_PARTNERS.map((partner) => (
                <li>
                  {partner.url ? (
                    <a class="partner partner--link" href={partner.url} target="_blank" rel="noopener">
                      {partner.name}
                      <span class="visually-hidden"> {page.models.newTab}</span>
                      <ExternalLink class="partner__icon" size={14} />
                    </a>
                  ) : (
                    <span class="partner">{partner.name}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <PhotoBanner
      id="appel-titre"
      titleStrong={page.cta.titleStrong}
      titleLight={page.cta.titleLight}
      text={page.cta.text}
      image={ctaPhoto}
      imagePosition="50% 45%"
      spaced
    >
      <div class="cta__buttons">
        <Button href={donatePath(lang)} variant="don">{dict.ui.donate}</Button>
        <Button href={fieldPath(lang)} variant="on-dark">{page.cta.field}</Button>
      </div>
    </PhotoBanner>
  </main>

  <Footer />
</BaseLayout>

<style>
  .section--tinted {
    background: var(--vert-clair);
  }

  .stack {
    display: flex;
    flex-direction: column;
  }

  .stack--16 {
    gap: 16px;
  }

  .stack--20 {
    gap: var(--space-5);
  }

  .stack--32 {
    gap: var(--space-8);
  }

  .stack--40 {
    gap: 40px;
  }

  .two-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 40px 64px;
  }

  @media (max-width: 900px) {
    .two-cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card {
    border: 1px solid var(--bordure-douce);
    background: var(--blanc);
    box-shadow: var(--shadow-card);
  }

  /* Notre approche : cartes non cliquables, l'icône grossit au survol (comme StatCard). */
  .approach {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 1000px) {
    .approach {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .approach-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: var(--space-7);
    border-radius: var(--radius-card-lg);
  }

  .icon-disc {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--menthe);
    color: var(--basalte);
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .approach-card:hover .icon-disc {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .approach-card:hover .icon-disc {
      transform: none;
    }
  }

  .approach-card__title {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.2;
  }

  .approach-card__text {
    font-size: 16px;
    line-height: 1.6;
  }

  /* Une filière par site : 3 colonnes, 2 en tablette, 1 en mobile. */
  .sectors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1000px) {
    .sectors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .sectors {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .sectors > li {
    display: flex;
  }

  .sector-card,
  .map-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  .sector-card {
    color: var(--basalte);
  }

  .sector-card:hover {
    color: var(--basalte);
  }

  .sector-card :global(.sector-card__photo) {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .sector-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px 20px;
  }

  .sector-card__name {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
  }

  .sector-card__filiere {
    font-size: var(--fs-body-sm);
    line-height: 1.45;
  }

  /* Lien aligné en bas de la carte, quelle que soit la longueur du texte. */
  .sector-card__more,
  .map-card__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .sector-card__more {
    padding-top: 10px;
    font-size: var(--fs-body-sm);
  }

  .sectors :global(.sector-card__arrow) {
    flex-shrink: 0;
    transition: transform var(--transition-ui);
  }

  .sector-card:hover :global(.sector-card__arrow),
  .sector-card:focus-visible :global(.sector-card__arrow),
  .map-card:hover :global(.sector-card__arrow),
  .map-card:focus-visible :global(.sector-card__arrow) {
    transform: translateX(var(--nudge-arrow-hover));
  }

  @media (prefers-reduced-motion: reduce) {
    .sectors :global(.sector-card__arrow) {
      transition: none;
    }
  }

  /* Carte basalte : mini-silhouette de Madagascar, les sites en pastilles pêche. */
  .map-card {
    position: relative;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 260px;
    padding: var(--space-7);
    background: var(--basalte);
    color: var(--blanc);
  }

  .map-card:hover {
    color: var(--blanc);
  }

  .map-card__map {
    position: absolute;
    top: 20px;
    right: 24px;
    width: auto;
    height: calc(100% - 40px);
    pointer-events: none;
  }

  .map-card__island {
    fill: var(--sauge);
    fill-opacity: 0.35;
    stroke: var(--sauge);
    stroke-width: 3;
    stroke-opacity: 0.8;
  }

  .map-card__dot {
    fill: var(--peche);
    stroke: var(--basalte);
    stroke-width: 4;
  }

  .map-card__text,
  .map-card__more {
    position: relative;
  }

  .map-card__text {
    max-width: 62%;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .map-card__title {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.2;
  }

  .map-card__lead {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }

  .map-card__more {
    margin-top: 0;
    font-size: 16px;
  }

  /*
   * Frise : pastilles centrées sur le trait. Le trait relie chaque pastille à la
   * suivante (pseudo-élément de chaque étape sauf la dernière) : il s'arrête à la dernière date.
   */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    --dot: 16px;
    --dot-top: 3px;
    position: relative;
    padding: 0 0 28px 32px;
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 1px);
    top: calc(var(--dot-top) + var(--dot) / 2);
    bottom: calc(-1 * (var(--dot-top) + var(--dot) / 2));
    width: 2px;
    background: var(--vert-clair);
  }

  .timeline__dot {
    position: absolute;
    z-index: 1;
    left: 0;
    top: var(--dot-top);
    width: var(--dot);
    height: var(--dot);
    border-radius: var(--radius-pill);
    background: var(--sauge);
    box-shadow: 0 0 0 4px var(--vert-clair);
    /* « scale » et non « transform » : l'animation d'apparition garde la main sur transform. */
    transition: scale 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Survol d'une étape (non cliquable) : la pastille grossit, avec un petit rebond. */
  .timeline__item:hover .timeline__dot {
    scale: 1.25;
  }

  /* Dernière étape, point d'arrivée : pastille pêche qui pulse doucement. */
  .timeline__item:last-child .timeline__dot {
    background: var(--peche);
  }

  .timeline__item:last-child .timeline__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--peche);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .timeline__item:last-child .timeline__dot::after {
      animation: timeline-pulse 2.4s ease-out 1s infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__dot {
      transition: none;
    }

    .timeline__item:hover .timeline__dot {
      scale: none;
    }
  }

  @keyframes timeline-pulse {
    from {
      opacity: 0.6;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }

  /*
   * Apparition de la frise : chaque étape, quand elle entre dans l'écran, fait apparaître
   * sa pastille, puis son texte, puis dessine le trait jusqu'à la pastille suivante
   * (500 ms entre deux étapes qui entrent ensemble, voir data-reveal-stagger).
   * L'étape elle-même ne bouge pas, pour que le trait reste aligné.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js:not(.reveal-off)) .timeline__item.is-revealed {
      animation: none;
    }

    :global(.js:not(.reveal-off)) .timeline__item.is-revealed .timeline__dot {
      animation: timeline-dot 400ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--reveal-delay, 0ms) both;
    }

    :global(.js:not(.reveal-off)) .timeline__item.is-revealed > :not(.timeline__dot) {
      animation: reveal-up 600ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--reveal-delay, 0ms) + 120ms) both;
    }

    :global(.js:not(.reveal-off)) .timeline__item.is-revealed::before {
      transform-origin: top;
      animation: timeline-line 350ms ease-in-out calc(var(--reveal-delay, 0ms) + 150ms) both;
    }
  }

  @keyframes timeline-dot {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes timeline-line {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  .timeline__date {
    display: block;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .timeline__title {
    margin-top: 4px;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.25;
  }

  .timeline__text {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.6;
  }

  .history-figure {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  .history-figure :global(.history-figure__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 160px 160px var(--radius-card) var(--radius-card);
  }

  @media (max-width: 700px) {
    .history-figure :global(.history-figure__photo) {
      aspect-ratio: 4 / 3;
      border-radius: 40px 40px var(--radius-card-sm) var(--radius-card-sm);
    }
  }

  .history-figure__caption {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
  }

  .history-figure__quote {
    margin: 0;
    font-style: italic;
  }

  .history-figure__author {
    display: block;
    margin-top: 4px;
    font-size: var(--fs-caption);
    color: var(--ardoise);
  }

  /* Des modèles à reproduire */
  .models__text {
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .partners__title {
    font-size: 22px;
    font-weight: 800;
  }

  .partners {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
