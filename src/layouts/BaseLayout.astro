---
import { getLang, languages, localeUrl, pathWithoutLocale, t, type Lang } from '../i18n';
import { ogImageFor } from '../lib/og';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Page encore incomplète (contenu « [à fournir] ») : pas d'indexation par les moteurs. */
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const dict = t(lang);
const SITE_NAME = dict.meta.siteName;

const { title, description, noindex = false } = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Versions de la même page dans chaque langue (balises hreflang).
const path = pathWithoutLocale(Astro.url.pathname);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(localeUrl(code, path), Astro.site),
}));
// Image de partage générée au build pour chaque page (src/lib/og.ts), celle de l'accueil en repli.
// Fichiers de partage servis par le site réellement en ligne : sur Vercel, son domaine de production
// (le domaine final sert encore l'ancien site, ses URL y répondraient 404) ; ailleurs, dont le build
// de l'Action OVH, `site` (le domaine final, servi par OVH après la bascule).
const vercelHost = process.env.VERCEL_PROJECT_PRODUCTION_URL;
const mediaOrigin = vercelHost ? `https://${vercelHost}` : Astro.site;
const og = await ogImageFor(lang, Astro.url.pathname);
const ogUrl = new URL(og.src, mediaOrigin);
// Accueil : vidéo de partage (courbes de niveau animées, 8 s en boucle), lue par Discord, Telegram,
// parfois iMessage ; partout ailleurs, l'image fixe reste affichée.
// Test sur l'URL et non sur `path`, qui vaut aussi « » sur la 404.
const isHome = /^\/(en\/?)?$/.test(Astro.url.pathname);
const ogVideo = isHome ? new URL(`/video/partage-accueil-${lang}.mp4`, mediaOrigin) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Mode forcé par le visiteur (bascule du header, src/scripts/theme.ts) : posé avant le
      // premier rendu, sans flash. Sans choix enregistré, le CSS suit l'appareil.
      try {
        const theme = localStorage.getItem('lhe-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
      // Filet de sécurité : si le script d'apparition ne s'exécute pas, tout s'affiche.
      setTimeout(() => {
        if (!document.documentElement.dataset.revealReady) document.documentElement.classList.add('reveal-off');
      }, 3000);
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <meta name="theme-color" content="#434840" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/Rubik-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    {
      ogVideo && (
        <>
          <meta property="og:video" content={ogVideo} />
          <meta property="og:video:type" content="video/mp4" />
          <meta property="og:video:width" content="1200" />
          <meta property="og:video:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={og.alt} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{dict.meta.skipLink}</a>
    <div class="site">
      <slot />
    </div>
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initTooltips } from '../scripts/tooltip';
      initReveal();
      initTooltips();
    </script>
    {
      /*
        Mesure d'audience : emplacement réservé, aucun outil chargé pour l'instant (Vercel Web
        Analytics ne fonctionne que sur Vercel). Solution sans cookies à choisir avec Victor et l'ONG,
        par exemple Umami ou GoatCounter : ajouter ici leur balise <script> (attribut `defer`), puis
        renseigner ANALYTICS_TOOL dans src/data/confidentialite.ts (page Confidentialité). Voir README.
      */
    }
  </body>
</html>
