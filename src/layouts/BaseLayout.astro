---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Intro from '../components/Intro.astro';
import defaultOgImage from '../assets/photos/hero-artisane-vohimana.jpg';
import { getLang, languages, localeUrl, pathWithoutLocale, t, type Lang } from '../i18n';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Image de partage (Open Graph), recadrée en 1200×630. */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Page encore incomplète (contenu « [à fournir] ») : pas d'indexation par les moteurs. */
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const dict = t(lang);
const SITE_NAME = dict.meta.siteName;

const { title, description, ogImage = defaultOgImage, ogImageAlt = dict.home.hero.imageAlt, noindex = false } = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Versions de la même page dans chaque langue (balises hreflang).
const path = pathWithoutLocale(Astro.url.pathname);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(localeUrl(code, path), Astro.site),
}));
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Mode forcé par le visiteur (bascule du header, src/scripts/theme.ts) : posé avant le
      // premier rendu, sans flash. Sans choix enregistré, le CSS suit l'appareil.
      try {
        const theme = localStorage.getItem('lhe-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
      // Écran d'ouverture (Intro.astro) : une fois par session.
      try {
        if (sessionStorage.getItem('lhe-intro')) document.documentElement.classList.add('no-intro');
        else sessionStorage.setItem('lhe-intro', '1');
      } catch {
        document.documentElement.classList.add('no-intro');
      }
      // Filet de sécurité : si le script d'apparition ne s'exécute pas, tout s'affiche.
      setTimeout(() => {
        if (!document.documentElement.dataset.revealReady) document.documentElement.classList.add('reveal-off');
      }, 3000);
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <meta name="theme-color" content="#434840" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/Rubik-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <Intro />
    <a class="skip-link" href="#contenu">{dict.meta.skipLink}</a>
    <div class="site">
      <slot />
    </div>
    <script>
      import { initImages } from '../scripts/images';
      import { initReveal } from '../scripts/reveal';
      import { initTooltips } from '../scripts/tooltip';
      initImages();
      initReveal();
      initTooltips();
    </script>
    <Analytics />
  </body>
</html>
